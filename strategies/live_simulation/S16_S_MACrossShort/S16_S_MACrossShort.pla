    SX_MA_Holiday            : P0 holiday block
    SX_MA_Settlement         : P0 settlement flat
    SX_MA_TailFlat           : P0.5 tail force exit (v1.3 time guard)
    SE_MA_ReEntry            : Re-entry short (v1.6 washout recovery)

  CHART SETUP REQUIRED:
    Data1 = TXF1 5M
    IntrabarOrderGeneration = FALSE
    MaxBarsBack >= 200 (covers all indicator warm-up)
================================================================================ }

[IntrabarOrderGeneration = False]


{ ============================================================
  SECTION 1 - INPUTS
  ============================================================ }
inputs:
    { ===== Group A: Entry (ZLEMA) - v0.5-FINAL 2026-07-10 ===== }
    ZLEMA_Fast              ( 25    ),
    ZLEMA_Slow              ( 70    ),
    MinSlope                ( 28    ),

    { ===== Group B: M5 Quick Stop - v0.5 2026-07-09 ===== }
    QuickStop_On            ( True  ),
    QuickStop_MaxBars       ( 4     ),
    QuickStop_MaxLoss_Pts   ( 60    ),

    { ===== Group C: M6 Rule #17 Multi-Layer Monitor ===== }
    ML_On                   ( True  ),
    ML_ActivationPct        ( 20    ),
    ML_ScoreTrigger         ( 60    ),
    ML_MinCategories        ( 3     ),
    ML_VolAvgLen            ( 15    ),
    ML_VolSpikeMult         ( 2.0   ),
    ML_MA_ShortLen          ( 10    ),
    ML_ATR_ShortLen         ( 3     ),
    ML_ATR_LongLen          ( 90    ),
    ML_ATR_Ratio            ( 2.5   ),

    { ===== Group D: M7 Breakeven Trailing - v1.4 LATE activation ===== }
    { v1.4 (2026-07-18): tiers re-timed 1.0/1.5 -> 2.5/3.5 ATR.     }
    { Early BE strangled winners inside the 2hr momentum window.    }
    { Plateau verified: 2.0/2.5/3.0 flat within 0.6%. Do NOT lower  }
    { trigger below 2.0 (1.0 = -185K vs current).                   }
    BE_On                   ( True  ),
    BE_Trigger_ATR          ( 2.5   ),
    BE_Buffer_Pts           ( 15    ),
    BE_Tier2_ATR            ( 3.5   ),
    BE_Tier2_Buffer_Pts     ( 20    ),

    { ===== Group E: M8 Time Stop - v0.5 (KEY ALPHA DRIVER) ===== }
    { MaxHoldingBars=24 = 2hr, 31 trades exit here with 100% WR / avg +72K }
    M8_On                   ( True  ),
    MaxHoldingBars          ( 24    ),

    { ===== Group F: ATR SL (Frozen) - v0.5 + v1.5 SL_Pct ===== }
    ATR_Len                 ( 14    ),
    StopATRMult             ( 4.0   ),
    SL_Pct                  ( 1.00  ),     { Pct stop cap for SHORT. Ceiling = Entry + Entry*SL_Pct/100. Converge=1.00 (MC sweep 0-5.0). }

    { ===== Group H: Rule #11 Compliance ===== }
    { Registry_Valid_Until format: EL-standard YYYMMDD where YYY=Year-1900 }
    { 1270101 = 2027-01-01 (aligned with L1-L5 / S1 / S3_S registry expiry) }
    Holiday_Flat_Time       ( 415   ),
    Registry_Valid_Until    ( 1270101 ),
    Manual_Kill_Switch      ( False ),
    Settlement_Flat_Time    ( 1230  ),

    { ===== Group I: Tail Time Guard - v1.3 2026-07-18 ===== }
    { Never hold into ANY closure. LastEntry = last legal entry   }
    { SIGNAL bar stamp (fill = that bar close). ForceExit signal  }
    { bar stamp (fill = next bar open, ~04:40). Both tail-only:   }
    { conditions bounded by Time <= 500 (MC 24hr pitfall rule).   }
    Tail_LastEntry_Time     ( 430   ),
    Tail_ForceExit_Time     ( 440   );


