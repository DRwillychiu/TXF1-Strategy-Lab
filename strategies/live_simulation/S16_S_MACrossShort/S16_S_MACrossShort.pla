    v_ATR                   ( 0     ),
    v_StopDist              ( 0     ),

    { ===== Trade state ===== }
    v_EntryBar              ( 0     ),
    v_BarsSince             ( 0     ),
    v_Prev_MP               ( 0     ),
    v_Loss                  ( 0     ),
    v_Profit                ( 0     ),

    { ===== Frozen SL (Rule #12) ===== }
    v_SL_Locked             ( False ),
    v_Frozen_ATR            ( 0     ),
    v_Frozen_SL_Dist        ( 0     ),
    v_SL_Level              ( 0     ),

    { ===== v1.5 SetStopContract + SL_Pct ===== }
    v_Guard_Distance        ( 0     ),
    v_SL_Pct_Ceil           ( 0     ),

    { ===== M5 Quick Stop state ===== }
    v_QuickStop_Fired       ( False ),

    { ===== M6 Multi-Layer state ===== }
    v_ML_Loss               ( 0     ),
    v_ML_Activation_Level   ( 0     ),
    v_ML_Score              ( 0     ),
    v_ML_Score_Pct          ( 0     ),
    v_ML_CatCount           ( 0     ),
    v_ML_Trigger            ( False ),
