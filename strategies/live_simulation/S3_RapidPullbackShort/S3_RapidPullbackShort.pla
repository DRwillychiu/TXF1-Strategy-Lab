{ ============================================================
  SECTION 1B - HOLIDAY / REGISTRY / SETTLEMENT DETECTION
  Identical to v1.1.
  ============================================================ }

v_Holiday_Block = False;

if Time < 500 then begin
    for hidx = 1 to 80 begin
        if Date = Holiday_Tail[hidx] then
            v_Holiday_Block = True;
    end;
end;

v_Registry_Expired = False;

if Date > Registry_Valid_Until then begin
    v_Registry_Expired = True;
    v_Holiday_Block    = True;
end;

{ Monthly Settlement detection (3rd Wed of month) }
v_Settlement_Day = ( DayOfWeek( Date ) = 3 ) and
                   ( DayOfMonth( Date ) >= 15 ) and
                   ( DayOfMonth( Date ) <= 21 );

{ Registry-expiry red warning, 30 days out }
if LastBarOnChart and
   DateToJulian( Date ) >= DateToJulian( Registry_Valid_Until ) - 30 then begin
    if Registry_Warn_ID < 0 then begin
        Registry_Warn_ID = Text_New( Date, Time, High + 400,
            "HOLIDAY REGISTRY EXPIRES " +
            NumToStr( Registry_Valid_Until, 0 ) +
            " - REBUILD FROM TAIFEX CALENDAR" );
        Text_SetColor( Registry_Warn_ID, Red );
        Text_SetSize( Registry_Warn_ID, 14 );
        Text_SetAttribute( Registry_Warn_ID, 1, True );
    end;
end;


{ ============================================================
  SECTION 2 - 60M TIER 1 CALCULATIONS (Data2)

  v2.0: replaces v1.1's Daily Tier 1 (Data3).
  Same A AND (B OR C) structure; recalibrated to 60M scale.

  Per CLAUDE.md Rule #3: Data2 current bar may be partial -
  use [1] for already-closed 60M values. All Tier 1 inputs
  reference [1] of Data2 for stability.
  ============================================================ }

{ v2.0.1 MC12 PATCH: explicit parens force ( ... of Data2 ) binding
  before applying [1] history. Removes Data1/Data2 binding ambiguity
  across PowerLanguage parser versions. Same idiom as v1.1 BUG FIX #7
  for Close, now applied to Average. }
v_H60_FastMA = ( Average( Close, H60_FastMA_Len ) of Data2 )[1];
v_H60_SlowMA = ( Average( Close, H60_SlowMA_Len ) of Data2 )[1];

{ Current 60M RSI from snapshot (Section 4 maintains the snap shift
  at each hour-boundary in Data1 context). Snap0 = most recent
  closed 60M RSI value. }
v_H60_RSI    = v_H60_RSI_Snap0;

{ Distance from 60M MA20 as percentage. Positive when price above MA20.
  Note: ( Close of Data2 )[1] - explicit parens force parser to bind
  'of Data2' first, then apply [1] history to Data2-bound expression.
  Removes Data1/Data2 binding ambiguity. }
if v_H60_FastMA > 0 then
    v_H60_Dist_Pct = ( ( Close of Data2 )[1] - v_H60_FastMA ) /
                     v_H60_FastMA * 100
else
    v_H60_Dist_Pct = 0;

{ A: bullish 60M structure }
if v_H60_FastMA > v_H60_SlowMA then
    v_Trend_OK = True
else
    v_Trend_OK = False;

{ B: RSI > threshold sustained for N completed 60M bars (= N hours).
  Snapshot-based history maintained in Section 4 at hour-boundary.
  Each Snap is a genuine separate 60M bar's closed RSI.
  Supports H60_RSI_Sustained_Bars in [1..4]; >4 capped at 4. }
v_H60_RSI_Sustained = True;
if H60_RSI_Sustained_Bars >= 1 and
   v_H60_RSI_Snap0 <= H60_RSI_Threshold then
    v_H60_RSI_Sustained = False;
if H60_RSI_Sustained_Bars >= 2 and
   v_H60_RSI_Snap1 <= H60_RSI_Threshold then
    v_H60_RSI_Sustained = False;
if H60_RSI_Sustained_Bars >= 3 and
   v_H60_RSI_Snap2 <= H60_RSI_Threshold then
    v_H60_RSI_Sustained = False;
if H60_RSI_Sustained_Bars >= 4 and
   v_H60_RSI_Snap3 <= H60_RSI_Threshold then
    v_H60_RSI_Sustained = False;

if v_H60_RSI_Sustained then
    v_RSI_OK = True
else
    v_RSI_OK = False;

{ C: 60M distance from MA20 exceeds threshold (overextended) }
if v_H60_Dist_Pct > H60_Dist_MA20_Pct then
    v_Dist_OK = True
else
    v_Dist_OK = False;

{ Regime: A AND (B OR C) - identical structure to v1.1 }
if v_Trend_OK and ( v_RSI_OK or v_Dist_OK ) then
    v_Regime_Watch = True
else
    v_Regime_Watch = False;

{ HighConviction zone: 60M dist > +2.5% (v2.0 scale; was +5% Daily in v1.1).
  Logging-only diagnostic. }
if v_H60_Dist_Pct > HighConv_Threshold_Pct then
    v_HighConv_Active = True
else
    v_HighConv_Active = False;


{ ============================================================
  SECTION 2b - SECULAR BULL FILTER (v2.0.3 REVISED, Daily Data3)

  Mirror of L1 P6 Weekly trend filter, applied at Daily level.
  Per user 2026-06-20: S3 thesis is "counter-trend short during
  OVERHEATED BULL pullback" - so we MUST be in confirmed bull
  regime before any entry.

  3 CONDITIONS ALL AND (stricter than L1's OR because S3 is
  counter-trend; OR would let weak rallies pass and we'd be
  shorting fake bulls):
    1. Close (Daily, [1] closed bar) > SecularMA_Fast  (=60 day, )
    2. Close (Daily, [1] closed bar) > SecularMA_Slow  (=200 day, )
    3. SecularMA_Fast > SecularMA_Slow                 (MA structure bull)

  WHY DAILY (v2.0.3) vs 60M (v2.0.2 retired):
    - Daily MA60/MA200  (vs 60M MA1140/MA3800 )
    - Max Bars Strategy Reference  5000  300 (Daily MA200 + buffer)
    - Warmup ~200 trading day ( 60M MA3800 )
    - Chart  Data3 Daily  L1/v1.1 

  Historical backtest (15 trades) blocking effect:
    - 2022 bear regime trades #8/#9/#10 (-21.8k) -> all blocked [v]
      (Daily MA60  2022  < MA200, 3 fail)
    - 2025 H1 weak rally trade #12 (-10.8k) -> blocked by condition 3
      (Daily MA60 < MA200 at 2025-07-01, structure bear)
    - 2026 H1 trades #13/#14/#15 (+274k) -> all 3 conditions pass [v]
    - Other [OK] bull trades -> all pass (no false skip)

  Per CLAUDE.md Rule #3: ( ... of Data3 )[1] explicit parens for
  Data3-binding-before-history idiom (mirrors v1.1 BUG FIX #7).
  ============================================================ }

v_Daily_SecularMA_Fast = ( Average( Close, Daily_SecularMA_Fast ) of Data3 )[1];
v_Daily_SecularMA_Slow = ( Average( Close, Daily_SecularMA_Slow ) of Data3 )[1];

if Enable_Secular_Bull_Filter = False or (
   ( Close of Data3 )[1] > v_Daily_SecularMA_Fast and
   ( Close of Data3 )[1] > v_Daily_SecularMA_Slow and
   v_Daily_SecularMA_Fast    > v_Daily_SecularMA_Slow
) then
    v_Secular_Bull_OK = True
else
    v_Secular_Bull_OK = False;


{ ============================================================
  SECTION 3 - 5M TIER 2 CALCULATIONS (Data1)

  Preserved identically from v1.1 (momentum micro-structure is
  regime-independent). Only Pullback_Min_Pct default loosened.

  M1: Consec_Red_Bars consecutive red 5M candles.
  M2: Close < EMA(EMA_Fast_Len) AND EMA falling vs prior bar.
  M3: ATR(ATR_Short_Len) > ATR(ATR_Long_Len) * ATR_Spike_Mult.
  M4: (v_DaySess_High - Close) / v_DaySess_High * 100 in [Min, Max] %.
  ============================================================ }

{ M1 : consecutive red bars (small loop) }
v_Red_Loop_OK = True;
for v_red_idx = 0 to Consec_Red_Bars - 1 begin
    if Close[v_red_idx] >= Open[v_red_idx] then
        v_Red_Loop_OK = False;
end;
v_M1_Consec = v_Red_Loop_OK;

{ M2 : EMA fast break + slope down. One XAverage call + variable[1]
  lookback (v1.1 BUG FIX #9 preserved). }
v_5M_EMA      = XAverage( Close, EMA_Fast_Len );
v_5M_EMA_Prev = v_5M_EMA[1];

if ( Close < v_5M_EMA ) and ( v_5M_EMA < v_5M_EMA_Prev ) then
    v_M2_BelowEMA = True
else
    v_M2_BelowEMA = False;

{ M3 : short/long ATR spike }
v_5M_ATR_Short = AvgTrueRange( ATR_Short_Len );
v_5M_ATR_Long  = AvgTrueRange( ATR_Long_Len );

if ( v_5M_ATR_Long > 0 ) and
   ( v_5M_ATR_Short > v_5M_ATR_Long * ATR_Spike_Mult ) then
    v_M3_ATR_Spike = True
else
    v_M3_ATR_Spike = False;

{ M4 : intraday DAY-SESSION pullback geometry (v1.1 BUG FIX #4 preserved).
  Reset at first bar >= Entry_Open_Time on each new Date. }
if ( Date <> v_DaySess_HighDate ) and ( Time >= Entry_Open_Time ) then begin
    v_DaySess_High     = High;
    v_DaySess_HighDate = Date;
end
else if ( Date = v_DaySess_HighDate ) and
        ( Time >= Entry_Open_Time ) and ( Time <= 1345 ) then begin
    if High > v_DaySess_High then
        v_DaySess_High = High;
end;

if v_DaySess_High > 0 then
    v_Pullback_Pct = ( v_DaySess_High - Close ) / v_DaySess_High * 100
else
    v_Pullback_Pct = 0;

if ( v_Pullback_Pct >= Pullback_Min_Pct ) and
   ( v_Pullback_Pct <= Pullback_Max_Pct ) then
    v_M4_Pullback = True
else
    v_M4_Pullback = False;

{ All four AND-ed }
if v_M1_Consec and v_M2_BelowEMA and v_M3_ATR_Spike and v_M4_Pullback then
    v_Trigger_Fired = True
else
    v_Trigger_Fired = False;

{ Exit-side indicator: 5M EMA20 (for D4 structural TP backup) }
v_5M_EMA20 = XAverage( Close, TP_MA_Len );


{ ============================================================
  SECTION 4 - 60M RSI SNAPSHOT + DAILY COOLDOWN RESET

  v2.0.1: snapshot cadence detected via Data2 own (Date, Time) timestamp.

  WHY NOT Hour(Time):
    Original v2.0 used `Hour(Time) <> v_LastSeenHour`. That assumes
    60M bars align to clock hours (09:00, 10:00, ...). FALSE for TXF1:
    session-aligned 60M boundaries land at 09:45 / 10:45 / ... when
    day session starts 08:45 (the typical MC12 default for TXF1).
    Hour-based detection would snap at wrong moments and possibly
    capture partial-bar RSI values.

  CORRECT IDIOM:
    1. Detect Data2 advance via its OWN timestamp tuple
       ( Date of Data2, Time of Data2 ).
    2. When advanced, read ( RSI(...) of Data2 )[1] = the JUST-CLOSED
       60M bar (current Data2 is the new partial bar).
    3. Explicit parens force ( ... of Data2 ) binding before [1] history
       (mirrors v1.1 BUG FIX #7 idiom for Close).

  Cooldown reset (unchanged from v1.1) still on calendar-date boundary,
  gated by day-session open.
  ============================================================ }

{ 60M RSI snapshot (v2.0.1 MC12-safe) }
if ( Date of Data2 <> v_LastSeenData2Date ) or
   ( Time of Data2 <> v_LastSeenData2Time ) then begin
    if v_LastSeenData2Date >= 0 then begin
        { Normal shift: Data2 just advanced to a new 60M bar }
        v_H60_RSI_Snap3 = v_H60_RSI_Snap2;
        v_H60_RSI_Snap2 = v_H60_RSI_Snap1;
        v_H60_RSI_Snap1 = v_H60_RSI_Snap0;
        v_H60_RSI_Snap0 = ( RSI( Close, H60_RSI_Len ) of Data2 )[1];
    end
    else begin
        { First-bar init: bootstrap from historical Data2 }
        v_H60_RSI_Snap0 = ( RSI( Close, H60_RSI_Len ) of Data2 )[1];
        v_H60_RSI_Snap1 = ( RSI( Close, H60_RSI_Len ) of Data2 )[2];
        v_H60_RSI_Snap2 = ( RSI( Close, H60_RSI_Len ) of Data2 )[3];
        v_H60_RSI_Snap3 = ( RSI( Close, H60_RSI_Len ) of Data2 )[4];
    end;
    v_LastSeenData2Date = Date of Data2;
    v_LastSeenData2Time = Time of Data2;
end;

{ Daily cooldown reset (v1.1 BUG FIX #8 preserved) -
  gated by day-session open so a same-trading-day late-night re-entry
  attempt cannot bypass the gate. }
if Date <> v_LastSeenDate then begin
    if Time >= Entry_Open_Time then begin
        v_DailyCooldown_Active = False;
        v_LastSeenDate         = Date;
    end;
end;


{ ============================================================
  SECTION 5 - P3b IMMEDIATE STOP GUARD (SetStopLoss)  [Rule #12]

  Preserved identically from v1.1.
  MC engine-level stop, active on entry bar without IOG dependency.
  Closes the structural unprotected window between fill and the
  first custom stop evaluation.
  ============================================================ }

{ ---- 5a: Frozen SL setup (locks once per trade on entry bar) ---- }
if MarketPosition = -1 then begin
    if v_SL_Locked = False then begin
        v_Frozen_ATR_5M  = AvgTrueRange( SL_ATR_Len );
        v_Frozen_SL_Dist = v_Frozen_ATR_5M * SL_ATR_Mult;
        v_SL_Level       = EntryPrice + v_Frozen_SL_Dist;
        v_SL_Locked      = True;
    end;
end
else begin
    v_SL_Locked      = False;
    v_Frozen_ATR_5M  = 0;
    v_Frozen_SL_Dist = 0;
    v_SL_Level       = 0;
end;

{ ---- 5b: P3b SetStopLoss engine guard (shares frozen ATR once locked) ---- }
if v_SL_Locked = True then
    v_SL_ATR = v_Frozen_ATR_5M
else
    v_SL_ATR = AvgTrueRange( SL_ATR_Len );

if MarketPosition >= 0 then
    SetStopLoss( v_SL_ATR * SL_ATR_Mult * BigPointValue );


{ ============================================================
  SECTION 6 - ENTRY LOGIC

  Gates (all must be true):
    - Flat (MP = 0)
    - v_Regime_Watch           (Tier 1 60M regime)
    - v_Trigger_Fired          (Tier 2 4-AND 5M momentum)
    - Time in [Entry_Open_Time, Entry_Cutoff_Time]  (v2.0: widened to 1325)
    - Not on cooldown
    - Not on a holiday tail bar (v_Holiday_Block = false)
    - Not on a settlement day (v_Settlement_Day = false)
    - Holiday registry not expired

  Closed-interval safety: Time >= X AND Time <= Y (no half-open trap).
  ============================================================ }

if ( MarketPosition = 0 ) and
   ( v_Regime_Watch = True ) and
   ( v_Trigger_Fired = True ) and
   ( v_Secular_Bull_OK = True ) and        { v2.0.2 NEW Secular Bull Filter }
   ( Time >= Entry_Open_Time ) and
   ( Time <= Entry_Cutoff_Time ) and
   ( v_DailyCooldown_Active = False ) and
   ( v_Holiday_Block = False ) and
   ( v_Settlement_Day = False ) and
   ( v_Registry_Expired = False ) then begin
    SellShort( "SE_RPS_v2_Entry" ) next bar at Market;
end;


{ ============================================================
  SECTION 7 - EXIT CHAIN (Priority 0 first)

  PRIORITY ORDER (per CLAUDE.md Rule #11 Settlement_Flat):
    P0-1  SX_RPS_v2_Kill          (Manual_Kill_Switch)
    P0-2  SX_RPS_v2_RegistryEnd   (registry expired)
    P0-3  SX_RPS_v2_HolFlat       (holiday tail + Holiday_Flat_Time)
    P0-4  SX_RPS_v2_Settlement    (settlement day + Settlement_Flat_Time)
    P0a   SX_RPS_v2_DayClose      (daily force flat by 13:25)
    S-1   SX_RPS_v2_TP            (0.6% target OR EMA20 touch)
    S-2   SX_RPS_v2_TimeStop      (18 5M bars = 90 min)
    S-3   SX_RPS_v2_SL            (Frozen SL backup)
    (Engine SL handled by SetStopLoss in Section 5)

  Time-safety preserved from v1.1:
    Holiday_Flat_Time   : guarded by v_Holiday_Block + Time <= 455
    Settlement_Flat_Time: guarded by v_Settlement_Day (date-scoped)
    Daily_Flat_Time     : Time <= 1340 paired (avoids 15:00 cross-gap fill)
  ============================================================ }

ExitFired = 0;

if MarketPosition = -1 then begin

    { ---- P0-1 Manual kill switch ---- }
    if ( ExitFired = 0 ) and ( Manual_Kill_Switch = True ) then begin
        BuyToCover( "SX_RPS_v2_Kill" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- P0-2 Registry fail-safe ---- }
    if ( ExitFired = 0 ) and ( v_Registry_Expired = True ) then begin
        BuyToCover( "SX_RPS_v2_RegistryEnd" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- P0-3 Holiday iron rule (state-guarded Time>=X) ---- }
    if ( ExitFired = 0 ) and
       ( v_Holiday_Block = True ) and
       ( Time >= Holiday_Flat_Time ) and
       ( Time <= 455 ) then begin
        BuyToCover( "SX_RPS_v2_HolFlat" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- P0-4 Settlement flat (state-guarded Time>=X) ---- }
    if ( ExitFired = 0 ) and
       ( v_Settlement_Day = True ) and
       ( Time >= Settlement_Flat_Time ) then begin
        BuyToCover( "SX_RPS_v2_Settlement" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- P0a Daily force flat before 13:25 (Time<=1340 paired) ---- }
    if ( ExitFired = 0 ) and
       ( Time >= Daily_Flat_Time ) and
       ( Time <= 1340 ) then begin
        BuyToCover( "SX_RPS_v2_DayClose" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- Strategy exits (TP / time stop / frozen SL) ---- }
    if ExitFired = 0 then begin

        v_Bars_Held     = BarsSinceEntry;
        v_TP_Pct_Level  = EntryPrice * ( 1 - TP_Pct / 100 );
        v_TP_EMA20      = v_5M_EMA20;

        { TP: percentage target OR (optional) 5M EMA20 touch from above.
          v1.1 BUG FIX #1 preserved: three guards prevent fill-bar trap:
            1. v_Bars_Held >= TP_EMA20_MinBars
            2. v_5M_EMA20[1] < EntryPrice
            3. Close[1] > v_TP_EMA20[1] (genuine cross-from-above this bar) }
        if ( Close <= v_TP_Pct_Level ) or
           ( ( TP_Use_EMA20_Backup = True ) and
             ( v_Bars_Held >= TP_EMA20_MinBars ) and
             ( v_5M_EMA20[1] < EntryPrice ) and
             ( Close[1] > v_TP_EMA20[1] ) and
             ( Close <= v_TP_EMA20 ) ) then begin
            BuyToCover( "SX_RPS_v2_TP" ) next bar at Market;
            ExitFired = 1;
        end
        else if v_Bars_Held >= Max_Bars_TimeStop then begin
            BuyToCover( "SX_RPS_v2_TimeStop" ) next bar at Market;
            ExitFired = 1;
        end;

        { ---- S-3 Frozen SL backup (belt+suspenders with Section 5b) ---- }
        if ( ExitFired = 0 ) and ( v_SL_Locked = True ) then
            BuyToCover( "SX_RPS_v2_SL" ) next bar at v_SL_Level Stop;

    end;

end;


{ ============================================================
  SECTION 8 - COOLDOWN SET ON EXIT
  Any exit fired this bar -> cooldown active until tomorrow.
  Cleared in Section 4 when Date changes.
  ============================================================ }

if ExitFired > 0 then begin
    v_DailyCooldown_Active = True;
end;


{ ============================================================
  SECTION 9 - DIAGNOSTIC LOGGING (HighConviction zone)
  v2.0: HighConv threshold = 60M dist > +2.5% (was +5% on Daily in v1.1).
  Log once per new Date to avoid 240+ lines/day spam.
  ============================================================ }

if Log_HighConviction and v_HighConv_Active and ( Date <> Date[1] ) then
    Print( "S3v2 HighConv ", Date:8:0,
           " dist60m=", v_H60_Dist_Pct:0:2, "%",
           " regime=",  v_Regime_Watch,
           " trigger=", v_Trigger_Fired,
           " RSI60m0=", v_H60_RSI_Snap0:0:2,
           " RSI60m1=", v_H60_RSI_Snap1:0:2 );


{ ============================================================
  END OF FILE - S3_RapidPullbackShort_v2.pla  v2.0

  TIME-SAFETY VERIFICATION (closed-interval audit):
    Line in Section 1B  if Time < 500            OK upper-bounded
    Line in Section 6   Time >= Entry_Open_Time
                        AND Time <= Entry_Cutoff_Time
                                                  OK paired
    Line in Section 7   Time >= Holiday_Flat_Time guarded by
                        v_Holiday_Block AND Time <= 455
                                                  OK state-guarded + paired
    Line in Section 7   Time >= Settlement_Flat_Time guarded by
                        v_Settlement_Day (date-scoped)  OK
    Line in Section 7   Time >= Daily_Flat_Time
                        AND Time <= 1340          OK paired

  No bare Time>=X without a pair or a state-guard. Cross-day
  pitfall avoided.

  v2.0 DIFFS vs v1.1 (summary):
    REGIME GATE   : Daily Tier 1 (Data3) -> 60M Tier 1 (Data2)
    RSI SNAPSHOT  : Daily cadence -> Data2-bar-boundary cadence (Section 4)
    EXIT          : TP 0.7->0.6 / SL ATR x4->x3 / TimeStop 24->18
    ENTRY WINDOW  : Cutoff 1230 -> 1325 (widened day window)
    SESSIONS      : Day-only preserved (Night deferred to v2.1)
    STRUCT        : Holiday/Settlement/Kill/Frozen SL identical to v1.1
    LABELS        : SE/SX_RPS_v2_* (distinct from v1.1 for MC coexistence)

  v2.0.3 -> v2.0.4 PATCH (USER-MANDATED params lock-in, 2026-06-20):
    USER DIRECTIVE 2026-06-20 (DELIBERATE shift from prior "no lock-in" stance):
       SL_ATR_Mult  backtest  (1.5/2.0/2.5),SL=2.5 
      (PF 9.43 / Sharpe 0.49 / Sortino 0.91 / MaxDD -6.74% / WR 76.5%
       risk-adjusted ).User ".pla  neutral framework"
      directive, 17-trade backtest best params lock  .pla.

    [!] DISTINGUISH FROM RETIRED v2.0.2 LOCK-IN (commit 68f26e1, reverted):
      "v2.0.1  + 27-trade lock-in" Secular Filter,
      user  .pla  neutrality.
      v2.0.4 = v2.0.3 ( Secular Bull Filter)+ 17-trade lock-in,
      user explicit mandate .

    LOCKED DEFAULTS (v2.0.3 default -> v2.0.4 LOCKED):
      H60_RSI_Threshold       65   -> 70    (Tier 1 RSI )
      ATR_Spike_Mult          1.3  -> 1.0   (Tier 2 ,)
      Pullback_Min_Pct        0.3  -> 0.5   (Tier 2 )
      TP_Pct                  0.6  -> 1.0   ( winner target)
      SL_ATR_Mult             3    -> 2.5   (,)
      Max_Bars_TimeStop       18   -> 27    ( 135 min hold, winner )
      Entry_Cutoff_Time       1325 -> 1230  ( 11:xx WR 20% )
      HighConv_Threshold_Pct  2.5  -> 5.0   (log only, align with backtest)

    UNCHANGED:
      H60_FastMA_Len, H60_SlowMA_Len, H60_RSI_Len, H60_RSI_Sustained_Bars,
      H60_Dist_MA20_Pct, Consec_Red_Bars, EMA_Fast_Len, ATR_Short/Long_Len,
      Pullback_Max_Pct, TP_Use_EMA20_Backup, TP_MA_Len, TP_EMA20_MinBars,
      SL_ATR_Len, Entry_Open_Time, Daily_Flat_Time, Holiday/Settlement/
      Registry/Kill, Enable_Secular_Bull_Filter, Daily_SecularMA_Fast/Slow

    STRUCTURE PRESERVED (v2.0.3 ):
      - Tier 1 60M regime (A AND (B OR C))
      - Tier 2 5M 4-AND momentum (M1-M4)
      - Engine SetStopLoss + Frozen SL (no trailing)
      - Holiday(63) + Settlement + Kill + Daily flat 13:25
      - Same-day cooldown ( edge case bug  audit, v2.0.5 candidate)
      - Daily Data3 Secular Bull Filter (Section 2b)

    BACKTEST  (17 trades, 2020-12 ~ 2026-06):
      PF 9.43 / Sharpe 0.49 / Sortino 0.91 / MaxDD -6.74% / WR 76.5%
      Net Profit +354,000 NTD /  942%+
      Caveat:  17  Rule #13  (100+);2026 H1  89%

  v2.0.2 -> v2.0.3 PATCH (Secular Filter switched 60M -> Daily, 2026-06-20):
    REASON:  60M MA3800  Max Bars = 5000 setting,
            chart  load 1  60M historical  backtest. Daily
            Data3 + MA60/MA200  warmup ~200 day  Max Bars  300.
    CHANGES:
      [DATA] Data3  v2.0  -> Daily (Secular Bull Filter)
      [INPUTS] H60_SecularMA_Fast/Slow (1140/3800) -> Daily_SecularMA_Fast/Slow (60/200)
      [VARS]   v_H60_SecularMA_Fast/Slow -> v_Daily_SecularMA_Fast/Slow
      [SECT 2b] of Data2 -> of Data3 (, 3  AND)
      [MC CHART]  Data1=5M + Data2=60M + Data3=Daily
      [MAX BARS Strategy Reference] 5000 -> 300

  v2.0.1 -> v2.0.2 PATCH (Secular Bull Filter, 2026-06-20, RETIRED in v2.0.3):
    NOTE:  v2.0.2  retired  v2.0.2 (params lock-in) .
     thesis-driven  filter module, opt-fitted params .
     defaults  v2.0.1 , filter default ON .

    BACKGROUND:  2026-06-20 audit 15-trade :
      - 4  trade ""(2022 trend bear / 2025 weak rally)
      -  -32.6k, thesis ""
      -  Tier 1 A  (60M MA20>MA60) , bear 

    SOLUTION:  Section 2b Secular Bull Filter (mirror L1 P6 Weekly)
      3  AND(, S3  counter-trend):
        1. Close (60M, [1]) > MA_Fast (~60 day)
        2. Close (60M, [1]) > MA_Slow (~200 day)
        3. MA_Fast > MA_Slow ()
       inputs: Enable_Secular_Bull_Filter (True), H60_SecularMA_Fast (1140),
                 H60_SecularMA_Slow (3800)
       variables: v_H60_SecularMA_Fast/Slow, v_Secular_Bull_OK

    EXPECTED EFFECT (TWII daily proxy ):
      - 2022 #8/#9/#10  (-21.8k) -> ALL BLOCKED
      - 2025 #12 (-10.8k) -> BLOCKED ( 3 MA60<MA200)
      - 2026 H1 #13/#14/#15 (+274k) -> ALL PASS
      -  trades -> ALL PASS
      -  15 trades -> 11 trades,  ~32.6k

  v2.0 -> v2.0.1 PATCH (MC12 compliance, 2026-06-20):
    [MC12-1] Section 4 boundary detection: Hour(Time) -> ( Date of Data2,
             Time of Data2 ) tuple. Hour() assumed 60M align hour, FALSE
             for TXF1 session-aligned 60M (typical close at 09:45 /
             10:45 / ... not 09:00 / 10:00 / ...).
    [MC12-2] Section 4 Snap0 reads ( RSI(...) of Data2 )[1] not
             RSI(...) of Data2 - the latter is current Data2 partial
             bar at moment of boundary advance; [1] is just-closed.
    [MC12-3] Section 4 init branch bootstrap Snap0..Snap3 from
             ( RSI(...) of Data2 )[1..4] historical, avoids 4-hour
             warmup with all-zeros.
    [MC12-4] Section 2 60M MA reads ( Average(...) of Data2 )[1]
             with explicit parens (was Average(...)[1] of Data2 -
             [1] binding ambiguous between Data1/Data2 offset across
             PowerLanguage parser versions). Mirrors v1.1 BUG FIX #7
             idiom for Close.
    [MC12-5] Variables: v_LastSeenHour removed; v_LastSeenData2Date +
             v_LastSeenData2Time added.

  v1.1 -> v2.0 is REGIME-FRAME shortened. Same thesis, faster cadence,
  more trades expected per year. v2.0.1 makes the Data2 reads MC12-safe.
============================================================ }
