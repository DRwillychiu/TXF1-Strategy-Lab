    v_M4_Pullback            ( False ),
    v_5M_EMA                 ( 0     ),
    v_5M_EMA_Prev            ( 0     ),
    v_5M_ATR_Short           ( 0     ),
    v_5M_ATR_Long            ( 0     ),
    v_Pullback_Pct           ( 0     ),
    v_Trigger_Fired          ( False ),
    v_Red_Loop_OK            ( True  ),
    v_red_idx                ( 0     ),
    { Day-session-only intraday high (v1.1 BUG FIX #4 preserved):
      HighD(0) is calendar-date-scoped; TXF1 night-tail 00:00-05:00 bars
      carry NEXT trading day's Date, so HighD(0) at 08:45 already includes
      overnight tail high. Reset and accumulate from Entry_Open_Time per Date. }
    v_DaySess_High           ( 0     ),
    v_DaySess_HighDate       ( 0     ),

    { ===== Exit state - preserved from v1.1 ===== }
    v_TP_Pct_Level           ( 0     ),
    v_TP_EMA20               ( 0     ),
    v_5M_EMA20               ( 0     ),
    v_SL_ATR                 ( 0     ),
    v_SL_Locked              ( False ),
    v_Frozen_ATR_5M          ( 0     ),
    v_Frozen_SL_Dist         ( 0     ),
    v_SL_Level               ( 0     ),
    v_Bars_Held              ( 0     ),

    { ===== Cooldown (one trade per day) ===== }
    v_DailyCooldown_Active   ( False ),
    v_LastSeenDate           ( 0     ),

    { ===== Priority 0 protection state ===== }
    v_Holiday_Block          ( False ),
    v_Registry_Expired       ( False ),
    v_Settlement_Day         ( False ),
    Registry_Warn_ID         ( -1    ),
    hidx                     ( 0     ),
    ExitFired                ( 0     ),

    { ===== Secular Bull Filter state (v2.0.3 Section 2b, Daily Data3) ===== }
    v_Daily_SecularMA_Fast   ( 0     ),
    v_Daily_SecularMA_Slow   ( 0     ),
    v_Secular_Bull_OK        ( False ),

    { ===== Diagnostic ===== }
    v_HighConv_Active        ( False );


