{ ============================================================
  SECTION 5 - HOLIDAY / REGISTRY / SETTLEMENT DETECTION
  Byte-identical to v1.9.1.
  ============================================================ }

v_Holiday_Block = False;

if Time < 500 then begin
    for hidx = 1 to 80 begin
        if Date = Holiday_Tail[hidx] then
            v_Holiday_Block = True;
    end;
end;

v_Registry_Expired = False;

if Date > Registry_Valid_Until then begin
    v_Registry_Expired = True;
    v_Holiday_Block    = True;
end;

{ Monthly Settlement detection (3rd Wed of month) }
v_Settlement_Day = ( DayOfWeek( Date ) = 3 ) and
                   ( DayOfMonth( Date ) >= 15 ) and
                   ( DayOfMonth( Date ) <= 21 );

{ Registry-expiry red warning, 30 days out }
if LastBarOnChart and
   DateToJulian( Date ) >= DateToJulian( Registry_Valid_Until ) - 30 then begin
    if Registry_Warn_ID < 0 then begin
        Registry_Warn_ID = Text_New( Date, Time, High + 400,
            "HOLIDAY REGISTRY EXPIRES " +
            NumToStr( Registry_Valid_Until, 0 ) +
            " - REBUILD FROM TAIFEX CALENDAR" );
        Text_SetColor( Registry_Warn_ID, Red );
        Text_SetSize( Registry_Warn_ID, 14 );
        Text_SetAttribute( Registry_Warn_ID, 1, True );
    end;
end;


{ ============================================================
  SECTION 5.5 - REGIME FILTER (Daily via Data3)
  Byte-identical to v1.9.1.
  ============================================================ }

if Use_Regime_Filter = True then begin
    v_MA_Fast_D = ( Average( Close, Regime_FastMA ) of Data3 )[1];
    v_MA_Slow_D = ( Average( Close, Regime_SlowMA ) of Data3 )[1];

    if v_MA_Slow_D > 0 then
        v_Regime_Ratio = v_MA_Fast_D / v_MA_Slow_D
    else
        v_Regime_Ratio = 1;

    v_In_WeakBull_Zone = ( v_Regime_Ratio > 1.02 ) and ( v_Regime_Ratio < 1.05 );
    v_In_Range_Zone = ( v_Regime_Ratio >= 0.98 ) and ( v_Regime_Ratio <= 1.02 );

    v_Regime_OK = True;

    if Regime_BlockRange = True and v_In_Range_Zone = True then
        v_Regime_OK = False;

    if Regime_BlockWeakBull = True and v_In_WeakBull_Zone = True then
        v_Regime_OK = False;
end
else
    v_Regime_OK = True;


{ ============================================================
  SECTION 6 - BOLLINGER BANDS + SQUEEZE DETECTION + HUNT STATE
  v1.9.4 HUNT STATE MACHINE (replaces v1.9.3 bar-count window):
    ARM    : squeeze bar -> v_Hunt_Active=True and v_Hunt_Low refreshed
             to the current v_LowerBand (the squeeze floor). Repeated
             squeeze bars keep refreshing the floor (tracks band drift).
    DISARM : no squeeze AND Close of Data2 > v_MidBand
             = structure repaired, episode over. Cannot happen during
             a crash (closes stay below MidBand) -> no mid-crash expiry.
    v_Hunt_Low is updated with each armed bar's Low in Section 10.5,
    which runs AFTER the entry check: the entry decision always
    compares against PRIOR bars' floor, never the current bar's own low.
  BB / BWRank computation byte-identical to v1.9.1.
  Between 60M closes, all states retain last values.
  ============================================================ }

if BarStatus(2) = 2 then begin

    v_MidBand   = Average( Close, BBLen ) of Data2;
    v_UpperBand = v_MidBand + BBStd * StandardDev( Close, BBLen, 1 ) of Data2;
    v_LowerBand = v_MidBand - BBStd * StandardDev( Close, BBLen, 1 ) of Data2;

    if v_MidBand > 0 then
        v_BandWidth = ( v_UpperBand - v_LowerBand ) / v_MidBand * 100
    else
        v_BandWidth = 0;

    { BWRank: count bars NARROWER than current (low rank = narrow bands = squeeze) }
    v_BWCount = 0;
    for v_i = 1 to v_BW_Filled begin
        if BW_History[v_i] < v_BandWidth then
            v_BWCount = v_BWCount + 1;
    end;
    if v_BW_Filled > 0 then
        v_BWRank = v_BWCount / v_BW_Filled * 100
    else
        v_BWRank = 100;

    v_Squeeze = ( v_BWRank <= BWPctile );

    { v1.9.6 ITEM 3: BWRank Equal-BW Guard (bug fix, default ON) }
    { When all lookback BW = current BW, count(<) = 0 -> BWRank = 0 ->
      v_Squeeze incorrectly = True. Guard: force False when count = 0
      AND enough history has filled. }
    if BWRank_EqualGuard_On = True and
       v_BWCount = 0 and
       v_BW_Filled >= BWRank_MinFilled then
        v_Squeeze = False;

    { Hunt state machine: arm on squeeze, disarm on structure repair (v1.9.4) }
    if v_Squeeze = True then begin
        if v_Hunt_Active = False then
            v_Hunt_StopCount = 0;
        v_Hunt_Active = True;
        v_Hunt_Low    = v_LowerBand;
    end
    else if ( v_Hunt_Active = True ) and ( Close of Data2 > v_MidBand ) then begin
        v_Hunt_Active    = False;
        v_Hunt_Low       = 0;
        v_Hunt_StopCount = 0;
    end;

    { Store current BW into circular buffer (after comparison) }
    v_BW_Ptr = v_BW_Ptr + 1;
    if v_BW_Ptr > BWLookback then
        v_BW_Ptr = 1;
    BW_History[v_BW_Ptr] = v_BandWidth;
    if v_BW_Filled < BWLookback then
        v_BW_Filled = v_BW_Filled + 1;

end;


{ ============================================================
  SECTION 7 - ATR + STOP / TARGET DISTANCES
  v1.9.6: detect night session on Data1 for anti-hunt widening.
  ============================================================ }

v_ATR        = AvgTrueRange( ATR_Len ) of Data2;
v_StopDist   = v_ATR * StopATRMult;
v_TargetDist = v_ATR * TargetATRMult;

{ v1.9.6 ITEM 1: Detect night session on Data1 (1M) }
{ Night session = Time >= NightSL_Start_Time (2200) OR Time < NightSL_End_Time (500) }
{ Time on Data1 = end-of-1M-bar time in HHMM format }
if Time >= NightSL_Start_Time or Time < NightSL_End_Time then
    v_Night_Session = True
else
    v_Night_Session = False;

{ SL multiplier: night widen only when in position, night session, and switch ON }
if NightSL_Widen_On = True and v_Night_Session = True and MarketPosition = -1 then
    v_SL_Mult_Effective = NightSL_Mult
else
    v_SL_Mult_Effective = 1.0;


{ ============================================================
  SECTION 8 - SAME-DAY COOLDOWN RESET
  Byte-identical to v1.9.1.
  ============================================================ }

if v_LastExit_Date > 0 and
   DateToJulian( Date ) - DateToJulian( v_LastExit_Date ) >= Cooldown_Days then
    v_Cooldown_Active = False;


{ ============================================================
  SECTION 9 - FROZEN SL SETUP + SetStopLoss (Rule #12, SHORT variant)
  v1.9.2: reset v_SP_Retain_Dynamic on exit.
  ============================================================ }

{ Frozen SL setup (locks once per trade on entry bar) }
{ v1.9.6: v_SL_Level_Effective applies dynamic night widening on top of frozen level }
if MarketPosition = -1 then begin
    if v_SL_Locked = False then begin
        v_Frozen_ATR     = v_ATR;
        v_Frozen_SL_Dist = v_Frozen_ATR * StopATRMult;
        v_SL_Level       = EntryPrice + v_Frozen_SL_Dist;
        v_SL_Locked      = True;
    end;
    { Effective SL applies night widen multiplier (short: SL is above entry) }
    v_SL_Level_Effective = EntryPrice + v_Frozen_SL_Dist * v_SL_Mult_Effective;
end
else begin
    v_SL_Locked          = False;
    v_Frozen_ATR         = 0;
    v_Frozen_SL_Dist     = 0;
    v_SL_Level           = 0;
    v_SL_Level_Effective = 0;
    v_SP_Armed           = False;
    v_Peak_Profit_Pts    = 0;
    v_SP_Floor_Price     = 0;
    v_SP_Retain_Dynamic  = SP_Retain_Pct;
    v_ConfirmSL_Count    = 0;
    v_MidExit_ConfirmHits = 0;
end;

{ SetStopLoss engine guard (shares frozen ATR once locked) }
{ v1.9.6 ITEM 1: SetStopLoss distance also gets night widening }
if v_SL_Locked = True then
    v_StopDist = v_Frozen_SL_Dist * v_SL_Mult_Effective;

{ Rule #12 SL_Pct cap (added 2026-08-04).                                   }
{ The guard runs pre-entry, so EntryPrice is not yet known; Close is used   }
{ as the anchor proxy - same convention as L2/L4/S16_S short strategies.    }
{ Applied AFTER the night-widen multiplier so the cap bounds the widened    }
{ distance too. SL_Pct = 0 leaves this inert, so behaviour is unchanged     }
{ until a sweep sets a value.                                              }
if SL_Pct > 0 then
    v_StopDist = MinList( v_StopDist, Close * SL_Pct / 100 );

{ Rule #12: SetStopContract MUST be called before SetStopLoss so the        }
{ amount is PER-CONTRACT instead of TOTAL POSITION. Deployment is a fixed   }
{ 2-lot size, so without this call the engine stop sits at half the         }
{ intended distance.                                                       }
{ NOTE: the original was a single-statement if with no begin/end; begin/end }
{ is required now that two statements are guarded.                          }
if MarketPosition >= 0 then begin
    SetStopContract;
    SetStopLoss( v_StopDist * BigPointValue );
end;


{ ============================================================
  SECTION 9.5 - 1M MULTI-LAYER EXIT MONITORING
  Byte-identical to v1.9.1.
  ============================================================ }

if MarketPosition = -1 and v_1M_ExitFired = False then begin

    { --- Reset all factor scores --- }
    v_Score_A1 = 0;
    v_Score_A2 = 0;
    v_Score_A4 = 0;
    v_Score_A6 = 0;
    v_Score_B1 = 0;
    v_Score_B2 = 0;
    v_Score_C1 = 0;
    v_Score_C2 = 0;
    v_Score_D2 = 0;
    v_Score_D3 = 0;
    v_Score_E3 = 0;
    v_1M_Trigger = False;

    { --- Gate 1: Activation threshold --- }
    v_1M_Loss = Close - EntryPrice;
    v_1M_Gate1 = ( v_Frozen_SL_Dist > 0 ) and
                 ( v_1M_Loss > v_Frozen_SL_Dist * ML_ActivationPct / 100 );

    if v_1M_Gate1 = True then begin

        { --- 1M helper calculations --- }
        v_1M_AvgVol = Average( Volume, ML_VolAvgLen );
        v_1M_Body = AbsValue( Close - Open );
        v_1M_LowerShadow = MinList( Close, Open ) - Low;

        { === 1F: K-bar Patterns === }

        { A1: Volume + Long Lower Shadow (3 pts) }
        if Close > Open and
           v_1M_Body > 0 and
           v_1M_LowerShadow > 2 * v_1M_Body and
           v_1M_AvgVol > 0 and
           Volume > ML_VolSpikeMult * v_1M_AvgVol then
            v_Score_A1 = 3;

        { A2: Bullish Engulfing (3 pts) }
        if Close > Open and
           Close[1] < Open[1] and
           Close > Open[1] and
           Open < Close[1] then
            v_Score_A2 = 3;

        { A4: Consecutive Bullish Bars (2 pts) }
        v_1M_ConsecUp = 0;
        if Close > Close[1] then begin
            v_1M_ConsecUp = 1;
            if Close[1] > Close[2] then begin
                v_1M_ConsecUp = 2;
                if Close[2] > Close[3] then
                    v_1M_ConsecUp = 3;
            end;
        end;
        if v_1M_ConsecUp >= 2 then
            v_Score_A4 = 2;

        { A6: Expanding Bullish Bars (3 pts) }
        v_1M_Body0 = AbsValue( Close - Open );
        v_1M_Body1 = AbsValue( Close[1] - Open[1] );
        v_1M_Body2 = AbsValue( Close[2] - Open[2] );
        if Close > Open and
           Close[1] > Open[1] and
           Close[2] > Open[2] and
           v_1M_Body0 > v_1M_Body1 and
           v_1M_Body1 > v_1M_Body2 and
           v_1M_Body2 > 0 then
            v_Score_A6 = 3;

        { === 2F: Volume-Price === }

        { B1: Sudden Volume Spike + Up (3 pts) }
        if v_1M_AvgVol > 0 and
           Volume > ML_VolSpikeMult * v_1M_AvgVol and
           Close > Open then
            v_Score_B1 = 3;

        { B2: Rising Volume + Rising Price, 3 bars (3 pts) }
        if Volume > Volume[1] and
           Close > Close[1] and
           Volume[1] > Volume[2] and
           Close[1] > Close[2] then
            v_Score_B2 = 3;

        { === 3F: Momentum Speed === }

        { C1: Price Acceleration (3 pts) }
        v_1M_SpeedBarsP1 = ML_SpeedBars + 1;
        v_1M_Speed_Cur = Close - Close[ML_SpeedBars];
        v_1M_Speed_Prev = Close[1] - Close[v_1M_SpeedBarsP1];
        if v_1M_Speed_Cur > v_1M_Speed_Prev and
           v_1M_Speed_Cur > 0 then
            v_Score_C1 = 3;

        { C2: Speed Threshold (3 pts) }
        if Close - Close[ML_SpeedBars] > ML_SpeedThreshPts then
            v_Score_C2 = 3;

        { === 4F: Structure Break === }

        { D2: 1M Gap Up (2 pts) }
        if Open > High[1] then
            v_Score_D2 = 2;

        { D3: Break Entry Price (2 pts) }
        if Close > EntryPrice then
            v_Score_D3 = 2;

        { === 5F: Volatility Environment === }

        { E3: Volatility Regime Shift (3 pts) }
        v_1M_ATR_S = AvgTrueRange( ML_ATR_Short_Len );
        v_1M_ATR_L = AvgTrueRange( ML_ATR_Long_Len );
        if v_1M_ATR_L > 0 and
           v_1M_ATR_S > ML_ATR_Ratio * v_1M_ATR_L then
            v_Score_E3 = 3;

        { --- Score summation (max 30 pts) --- }
        v_1M_Score = v_Score_A1 + v_Score_A2 + v_Score_A4 + v_Score_A6
                   + v_Score_B1 + v_Score_B2
                   + v_Score_C1 + v_Score_C2
                   + v_Score_D2 + v_Score_D3
                   + v_Score_E3;

        v_1M_Score_Pct = v_1M_Score / 30 * 100;

        { --- Gate 2: Score threshold --- }
        v_1M_Gate2 = ( v_1M_Score_Pct >= ML_ScoreTrigger );

        { --- Gate 3: Cross-category count --- }
        v_1M_CatCount = 0;
        if v_Score_A1 + v_Score_A2 + v_Score_A4 + v_Score_A6 > 0 then
            v_1M_CatCount = v_1M_CatCount + 1;
        if v_Score_B1 + v_Score_B2 > 0 then
            v_1M_CatCount = v_1M_CatCount + 1;
        if v_Score_C1 + v_Score_C2 > 0 then
            v_1M_CatCount = v_1M_CatCount + 1;
        if v_Score_D2 + v_Score_D3 > 0 then
            v_1M_CatCount = v_1M_CatCount + 1;
        if v_Score_E3 > 0 then
            v_1M_CatCount = v_1M_CatCount + 1;

        v_1M_Gate3 = ( v_1M_CatCount >= ML_MinCategories );

        { --- TRIGGER: All 3 gates passed --- }
        v_1M_Trigger = v_1M_Gate1 and v_1M_Gate2 and v_1M_Gate3;

    end;

end;

{ Reset 1M exit flag when not in short position }
if MarketPosition <> -1 then
    v_1M_ExitFired = False;


{ ============================================================
  SECTION 10 - ENTRY LOGIC (Short-only per R-6 split)
  v1.9.5 gate (adds thrust margin over v1.9.4):
    v_Hunt_Active            = a squeeze armed this episode and the
                               structure is still broken (window open)
    Close of Data2 < v_LowerBand  = breakdown context (2-sigma)
    Close of Data2 < v_Hunt_Low - Thrust_Margin_ATR * v_ATR
                               = FRESH THRUST with minimum force:
                               must break below hunt low by at least
                               0.25 x ATR (~37-50 pts). Marginal
                               1-point breaks (T73) are filtered out.
    Use_Cooldown default False: date cooldown superseded by the
    fresh-thrust gate (GA can re-enable for A/B).
  ============================================================ }

if BarStatus(2) = 2 then begin
    if ( MarketPosition = 0 ) and
       ( v_Hunt_Active = True ) and
       ( Close of Data2 < v_LowerBand ) and
       ( Close of Data2 < v_Hunt_Low - Thrust_Margin_ATR * v_ATR ) and
       ( Use_Cooldown = False or v_Cooldown_Active = False ) and
       ( v_Holiday_Block = False ) and
       ( v_Settlement_Day = False ) and
       ( v_Registry_Expired = False ) and
       ( v_Regime_OK = True ) then begin
        sell short ( "SE_VS_Entry" ) next bar at Market;
        v_EntryBar = BarNumber of Data2;
    end;
end;


{ ============================================================
  SECTION 10.5 - HUNT LOW UPDATE (v1.9.4 NEW)
  Runs AFTER the entry check on the same 60M close: the entry always
  compares against the floor of PRIOR bars, never its own bar's low
  (a close can never be below its own low - gate would be dead code).
  ============================================================ }

if ( BarStatus(2) = 2 ) and ( v_Hunt_Active = True ) then begin
    if Low of Data2 < v_Hunt_Low then
        v_Hunt_Low = Low of Data2;
end;


{ ============================================================
  SECTION 11 - EXIT CHAIN (v1.9.2: P0.5 SP Priority + Tiered Retain)
  Priority order:
    P0-1 ~ P0-4  Safety gates (Kill/Registry/Holiday/Settlement)
    Layer 2 SP tracking (peak/arm/floor with tiered retain)
    P0.5 NEW     SP Armed Priority Fire (Market)
    S-0          1M_Exit (Market, only if P0.5 not fired)
    S-1          TP limit
    S-2          Mid-band exit (60M gate)
    S-3          Time stop (60M gate)
    S-4          SP / SL Stop (backup)
  ============================================================ }

ExitFired = 0;

if MarketPosition = -1 then begin

    { ---- P0-1 Manual kill switch ---- }
    if ( ExitFired = 0 ) and ( Manual_Kill_Switch = True ) then begin
        buy to cover ( "SX_VS_Kill" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- P0-2 Registry fail-safe ---- }
    if ( ExitFired = 0 ) and ( v_Registry_Expired = True ) then begin
        buy to cover ( "SX_VS_RegistryEnd" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- P0-3 Holiday iron rule (state-guarded + closed interval) ---- }
    if ( ExitFired = 0 ) and
       ( v_Holiday_Block = True ) and
       ( Time >= Holiday_Flat_Time ) and
       ( Time <= 455 ) then begin
        buy to cover ( "SX_VS_HolFlat" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- P0-4 Settlement flat (state-guarded) ---- }
    if ( ExitFired = 0 ) and
       ( v_Settlement_Day = True ) and
       ( Time >= Settlement_Flat_Time ) then begin
        buy to cover ( "SX_VS_Settlement" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- Layer 2 SP tracking: peak profit + arm + tiered floor ---- }
    { Peak profit for short = max(EntryPrice - Low) over hold }
    { Low = Data1 (1M) for fine-grained peak tracking }
    if EntryPrice - Low > v_Peak_Profit_Pts then
        v_Peak_Profit_Pts = EntryPrice - Low;

    { Arm SP once peak crosses threshold (irreversible per design) }
    if ( v_SP_Armed = False ) and
       ( v_Peak_Profit_Pts >= v_ATR * SP_Trigger_ATRMult ) then
        v_SP_Armed = True;

    { v1.9.2 NEW: Tiered SP_Retain_Pct based on Peak profit (pts) }
    { Bigger peak = higher confidence = tighter retention }
    if v_Peak_Profit_Pts >= 300 then
        v_SP_Retain_Dynamic = SP_Retain_Tier3_Pct
    else if v_Peak_Profit_Pts >= 200 then
        v_SP_Retain_Dynamic = SP_Retain_Tier2_Pct
    else if v_Peak_Profit_Pts >= 100 then
        v_SP_Retain_Dynamic = SP_Retain_Tier1_Pct
    else
        v_SP_Retain_Dynamic = SP_Retain_Pct;

    { Compute SP floor price using dynamic (tiered) retain % }
    if v_SP_Armed = True then
        v_SP_Floor_Price = EntryPrice - ( v_Peak_Profit_Pts * v_SP_Retain_Dynamic / 100 );

    { ---- P0.5 NEW v1.9.2: SP Armed Priority Fire ---- }
    { Fires BEFORE 1M_Exit to lock alpha at Floor level (Market order) }
    { Condition: SP armed AND Close (Data1 1M) has crossed above Floor }
    { For SHORT: rebound to Floor level = profit-give-back reached retain point }
    { v1.9.6 ITEM 6: Peak Min Pts gate (SP_Peak_Min_Pts default 0 = v1.9.5) }
    { v1.9.6 ITEM 7: Night Volume Confirm (SP_Night_VolConfirm_On default OFF) }
    v_SP_Night_VolAvg = Average( Volume, SP_Night_VolAvgLen );
    v_SP_Night_VolOK  = True;
    if SP_Night_VolConfirm_On = True and v_Night_Session = True then begin
        if Volume > v_SP_Night_VolAvg then
            v_SP_Night_VolOK = True
        else
            v_SP_Night_VolOK = False;
    end;

    if ( ExitFired = 0 ) and
       ( v_SP_Armed = True ) and
       ( Close >= v_SP_Floor_Price ) and
       ( v_Peak_Profit_Pts >= SP_Peak_Min_Pts ) and
       ( v_SP_Night_VolOK = True ) then begin
        buy to cover ( "SX_VS_SP_Armed" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- S-0: Preemptive 1M exit (native on Data1, fills at next 1M bar) ---- }
    if ( ExitFired = 0 ) and ( v_1M_Trigger = True ) then begin
        buy to cover ( "SX_VS_1M_Exit" ) next bar at Market;
        v_1M_ExitFired = True;
        v_Was_1M_Stop  = True;
        ExitFired = 1;
    end;

    { ---- Strategy exits ---- }
    if ExitFired = 0 then begin

        { S-1: TP at ATR x TargetMult (limit, fills at target price) }
        buy to cover ( "SX_VS_TP" ) next bar at EntryPrice - v_TargetDist limit;

        { S-2: Mid-band exit (thesis fail) - gated to 60M bar close }
        { v1.9.6 ITEM 4: ConfirmBars gate (default 1 = v1.9.5) }
        { v1.9.6 ITEM 5: PeakMinATR gate (default 0 = v1.9.5) }
        if BarStatus(2) = 2 then begin
            { Track consecutive Close of Data2 > MidBand hits }
            if Close of Data2 > v_MidBand then
                v_MidExit_ConfirmHits = v_MidExit_ConfirmHits + 1
            else
                v_MidExit_ConfirmHits = 0;

            if UseMidExit = True and
               BarNumber of Data2 - v_EntryBar >= MidExit_MinBars and
               Close of Data2 > v_MidBand and
               v_MidExit_ConfirmHits >= MidExit_ConfirmBars and
               v_Peak_Profit_Pts >= v_ATR * MidExit_PeakMinATR then begin
                buy to cover ( "SX_VS_Mid" ) next bar at Market;
                ExitFired = 1;
            end;
        end;

        { S-3: Time stop - gated to 60M bar close }
        if BarStatus(2) = 2 then begin
            if ExitFired = 0 and
               BarNumber of Data2 - v_EntryBar >= MaxBars then begin
                buy to cover ( "SX_VS_TimeStop" ) next bar at Market;
                ExitFired = 1;
            end;
        end;

        { S-4: SP / SL stop (backup for P0.5 miss or SP not armed)
          Stop orders fill at next 1M bar - Bug 2 eliminated.
          v1.9.6 ITEM 1: uses v_SL_Level_Effective (night widen applied).
          v1.9.6 ITEM 2: Confirmation SL (needs N consecutive 1M close > SL). }
        if ExitFired = 0 then begin
            if v_SP_Armed = True then
                buy to cover ( "SX_VS_SP" ) next bar at v_SP_Floor_Price Stop
            else if v_SL_Locked = True then begin
                if ConfirmSL_On = True then begin
                    { Confirmation-based SL: only fire after N consecutive
                      1M K close beyond SL. For short: close >= SL_Level. }
                    if Close >= v_SL_Level_Effective then
                        v_ConfirmSL_Count = v_ConfirmSL_Count + 1
                    else
                        v_ConfirmSL_Count = 0;
                    if v_ConfirmSL_Count >= ConfirmSL_Bars then begin
                        buy to cover ( "SX_VS_SL_Confirmed" ) next bar at Market;
                        ExitFired = 1;
                    end;
                end
                else begin
                    { Original Stop order behavior, with widened SL level }
                    buy to cover ( "SX_VS_SL" ) next bar at v_SL_Level_Effective Stop;
                end;
            end;
        end;

    end;

end;


{ ============================================================
  SECTION 12 - COOLDOWN + HUNT CIRCUIT BREAKER ON EXIT
  v1.9.5: tracks consecutive 1M_Exit stops per hunt episode.
  After Hunt_Max_Stops consecutive 1M_Exit losses, force DISARM.
  Any non-1M exit (TP/SP/Mid) resets counter (episode is profitable).
  v_Was_1M_Stop bridges the fill-bar gap: set in Section 11 when
  S-0 fires, consumed here on the actual position close bar.
  ============================================================ }

if v_Prev_MP = -1 and MarketPosition <> -1 then begin
    v_Cooldown_Active = True;
    v_LastExit_Date   = Date;

    { v1.9.5: hunt circuit breaker - consecutive 1M_Exit stop counter }
    if v_Was_1M_Stop = True then begin
        v_Hunt_StopCount = v_Hunt_StopCount + 1;
        if v_Hunt_StopCount >= Hunt_Max_Stops then begin
            v_Hunt_Active    = False;
            v_Hunt_Low       = 0;
            v_Hunt_StopCount = 0;
        end;
    end
    else
        v_Hunt_StopCount = 0;

    v_Was_1M_Stop = False;
end;


{ ============================================================
  SECTION 13 - PREV_MP TRACKING (last line, per Rule #8)
  ============================================================ }

v_Prev_MP = MarketPosition;
