{================================================================================
 Script Name : _Backtest_Adaptive_Farmer_v15_ShortMatrix
 MC Load Name: STRATEGY_WILLY_SHORT_CTEST2
 Description : Matrix Range Capture (Full-Range Consolidation Short)
 Version     : v15.0 Matrix Range Capture + ImmediateStop
 Symbol      : TXF1 (Taiwan Stock Index Futures Front Month)
 Platform    : MultiCharts 9.0 PowerLanguage x64
 Timeframe   : Data1 = 15M / Data2 = 60M / Data3 = Daily

 ARCHITECTURE REDESIGN (v15.0, 2026-07-04):
   Problem: v14.x Spring Trap had structural CS_BreakExit bleed
            (28 trades, 0% WR, -378K to -545K). 7 A/B variants
            and v14.5 filter attempts all failed to fix it.
            84 trades / 6.4yr, Sharpe 0.058 = portfolio weakest.

   New thesis: Mirror L3 V14 Matrix Range Capture for shorts.
   User ruling: "Consolidation earns oscillation money.
   Support -> long (L3), resistance -> short (L4)."

   Solution: Multi-dimensional matrix (mirrors L3 V14 structure).
     Dim 1 [Box Qualification]: skip boxes < Min_Box_ATR * ATR
     Dim 2 [Resistance Zone]:   short at top Entry_Zone_Pct of box
     Dim 3 [Dynamic Target]:    Frozen swing low (capped at Box_Btm)
     Dim 4 [Trend + Daily]:     60M MA + Daily Macro Block

   Changes from v14.4:
     - REMOVED: Spring Trap (v_In_Trap_Zone, v_Trap_Counter)
     - REMOVED: Trailing stop (v_Trail_Active, Trail_ATR_Mult)
     - REMOVED: Time stop (Time_Stop_Bars)
     - REMOVED: BE/SP mechanism (rejected v14.2 A/B)
     - REMOVED: Night block (Spring Trap specific)
     - REMOVED: i_Buffer_ATR_Mult, Time_Limit_Bars
     - ADDED:   CS_Entry via resistance zone + Box_Top Limit order
     - ADDED:   CS_TP via dynamic swing low target
     - ADDED:   Entry_Zone_Pct / Min_Box_ATR / Swing_Lookback
     - KEPT:    Daily Macro Block, 60M trend, all safety modules
     - KEPT:    Cooldown_Bars (prevent re-entry after SL above box)

   V14.4 preserved in git history.

 PERFORMANCE (v15.0 INITIAL, MC9 pending backtest):
   Entry_Zone_Pct=0.50 / Min_Box_ATR=8.5 / Swing_Lookback=80
================================================================================}

[IntrabarOrderGeneration = false]

inputs:
    { --- Data2 (60M) Box Detection --- }
    Lookback_Bars(15),
    Range_Shrink_Rate(0.7),
    Weekly_MA_Len(48),

    { --- V15 Matrix Dimensions --- }
    Entry_Zone_Pct(0.50),       { resistance zone = top 50% of box range }
    Min_Box_ATR(8.5),           { skip boxes smaller than N * 15M ATR }
    Swing_Lookback(80),         { 15M bars for dynamic swing low target }

    { --- Risk Management (15M) --- }
    ATR_Length(60),
    ATR_Stop_Mult(2.0),
    Cooldown_Bars(8),

    { --- Data3 (Daily) Filter Settings --- }
    Daily_FastMA_Len(20),
    Daily_SlowMA_Len(60),

    { --- Holiday Flat Rule v3 (Iron Rule 2026-06-12) --- }
    Holiday_Flat_Time(415),
    Registry_Valid_Until(1270101),
    Manual_Kill_Switch(false),

    { --- Monthly Settlement Flat (2026-06-17) --- }
    Settlement_Flat_Time(1230),

    { --- Frozen SL (always-on in v15) --- }
    Freeze_SL_On(true);

variables:
    { --- Data2 (60M) Box State --- }
    v_Ref_High(0),
    v_Ref_Low(0),
    v_Curr_Range(0),
    v_Ref_Range(0),
    v_is_in_consolidation(false),
    v_Box_Top(0),
    v_Box_Btm(0),

    { --- V15 Matrix State --- }
    v_Box_Range(0),
    v_Box_Qualified(false),
    v_Resistance_Zone(0),

    { --- Data2 Trend Filter --- }
    v_Weekly_MA(0),
    v_Trend_Dir(0),

    { --- Data3 Daily Filter --- }
    v_Daily_FastMA(0),
    v_Daily_SlowMA(0),
    v_Macro_Block(false),

    { --- Risk + Frozen State --- }
    v_Current_ATR(0),
    v_Stop_Level(0),
    v_SL_Locked(false),
    v_Frozen_ATR(0),
    v_Frozen_BoxTop(0),
    v_Frozen_Target(0),
    v_BarsSinceExit(999),

    { --- Holiday / Safety --- }
    v_Holiday_Block(false),
    v_Registry_Expired(false),
    Registry_Warn_ID(-1),
    hidx(0),
    v_Settlement_Day(false),

    { --- Exit chain --- }
    ExitFired(0);

arrays:
    Holiday_Tail[80](0);

{ ==========================================
  Phase -1: Holiday Tail Registry (TAIFEX-verified, shared
  with L1/L2/L3). Holiday_Tail = last trading day + 1 calendar
  day = the date stamped on the 00:00-05:00 tail bars of the
  final night session before each closure. * = reconstructed.
  ========================================== }

if CurrentBar = 1 then begin
    Holiday_Tail[1]  = 1190913;  Holiday_Tail[2]  = 1191010;
    Holiday_Tail[3]  = 1200101;
    { 2020 } Holiday_Tail[4]  = 1200121;  Holiday_Tail[5]  = 1200228;
    Holiday_Tail[6]  = 1200402;  Holiday_Tail[7]  = 1200501;
    Holiday_Tail[8]  = 1200625;  Holiday_Tail[9]  = 1201001;
    Holiday_Tail[10] = 1201009;  Holiday_Tail[11] = 1210101;
    { 2021 } Holiday_Tail[12] = 1210206;  Holiday_Tail[13] = 1210227;
    Holiday_Tail[14] = 1210402;  Holiday_Tail[15] = 1210612;
    Holiday_Tail[16] = 1210918;  Holiday_Tail[17] = 1211009;
    Holiday_Tail[18] = 1211231;
    { 2022 } Holiday_Tail[19] = 1220127;  Holiday_Tail[20] = 1220226;
    Holiday_Tail[21] = 1220402;  Holiday_Tail[22] = 1220430;
    Holiday_Tail[23] = 1220603;  Holiday_Tail[24] = 1220909;
    Holiday_Tail[25] = 1221008;  Holiday_Tail[26] = 1221231;
    { 2023 } Holiday_Tail[27] = 1230118;  Holiday_Tail[28] = 1230225;
    Holiday_Tail[29] = 1230401;  Holiday_Tail[30] = 1230429;
    Holiday_Tail[31] = 1230622;  Holiday_Tail[32] = 1230929;
    Holiday_Tail[33] = 1231007;  Holiday_Tail[34] = 1231230;
    { 2024 } Holiday_Tail[35] = 1240206;  Holiday_Tail[36] = 1240228;
    Holiday_Tail[37] = 1240404;  Holiday_Tail[38] = 1240501;
    Holiday_Tail[39] = 1240608;  Holiday_Tail[40] = 1240917;
    Holiday_Tail[41] = 1241010;  Holiday_Tail[42] = 1250101;
    { 2025 }
    Holiday_Tail[43] = 1250123;  Holiday_Tail[44] = 1250228;
    Holiday_Tail[45] = 1250403;  Holiday_Tail[46] = 1250501;
    Holiday_Tail[47] = 1250530;  Holiday_Tail[48] = 1250927;
    Holiday_Tail[49] = 1251004;  Holiday_Tail[50] = 1251010;
    Holiday_Tail[51] = 1251024;  Holiday_Tail[52] = 1251225;
    Holiday_Tail[53] = 1260101;
    { 2026 (verified: TAIFEX official 115-yr calendar) }
    Holiday_Tail[54] = 1260212;  Holiday_Tail[55] = 1260227;
    Holiday_Tail[56] = 1260403;  Holiday_Tail[57] = 1260501;
    Holiday_Tail[58] = 1260619;  Holiday_Tail[59] = 1260925;
    Holiday_Tail[60] = 1261009;  Holiday_Tail[61] = 1261024;
    Holiday_Tail[62] = 1261225;  Holiday_Tail[63] = 1270101;
end;

v_Holiday_Block = false;

if Time <= 500 then begin
    for hidx = 1 to 80 begin
        if Date = Holiday_Tail[hidx] then
            v_Holiday_Block = true;
    end;
end;

v_Registry_Expired = false;

if Date > Registry_Valid_Until then begin
    v_Registry_Expired = true;
    v_Holiday_Block    = true;
end;

{ Monthly Settlement Day detection (3rd Wed of month) }
v_Settlement_Day = (DayOfWeek(Date) = 3) and
                   (DayOfMonth(Date) >= 15) and
                   (DayOfMonth(Date) <= 21);

if LastBarOnChart and
   DateToJulian(Date) >= DateToJulian(Registry_Valid_Until) - 30 then begin
    if Registry_Warn_ID < 0 then begin
        Registry_Warn_ID = Text_New(Date, Time, High + 400,
            "HOLIDAY REGISTRY EXPIRES " +
            NumToStr(Registry_Valid_Until, 0) +
            " - REBUILD FROM TAIFEX CALENDAR");
        Text_SetColor(Registry_Warn_ID, Red);
        Text_SetSize(Registry_Warn_ID, 14);
        Text_SetAttribute(Registry_Warn_ID, 1, true);
    end;
end;

{ ==========================================
  Phase 0: Master Environment Filter (Data3 - Daily)
  Block all short entries in strong bull markets.
  Condition A: Close > SlowMA AND SlowMA rising (strong bull)
  Condition B: FastMA > SlowMA (golden cross)
  Either true = v_Macro_Block = true = no shorts allowed
  ========================================== }

v_Daily_FastMA = Average(Close, Daily_FastMA_Len) of Data3;
v_Daily_SlowMA = Average(Close, Daily_SlowMA_Len) of Data3;

if ((Close of Data3 > v_Daily_SlowMA) and
    (v_Daily_SlowMA >= v_Daily_SlowMA[1]))
   or (v_Daily_FastMA > v_Daily_SlowMA) then begin
    v_Macro_Block = true;
end else begin
    v_Macro_Block = false;
end;

{ ==========================================
  Phase 1: Macro Commander Logic (Data2 - 60M)
  ========================================== }

v_Ref_High   = Highest(High, Lookback_Bars)[1] of Data2;
v_Ref_Low    = Lowest(Low,   Lookback_Bars)[1] of Data2;
v_Curr_Range = (High of Data2) - (Low of Data2);
v_Ref_Range  = v_Ref_High - v_Ref_Low;

v_Weekly_MA = Average(Close, Weekly_MA_Len) of Data2;

if Close of Data2 < v_Weekly_MA then
    v_Trend_Dir = -1
else
    v_Trend_Dir = 1;

if (High of Data2 <= v_Ref_High) and (Low of Data2 >= v_Ref_Low) then begin
    if v_Ref_Range > 0 and
       (v_Curr_Range / v_Ref_Range <= Range_Shrink_Rate) then begin
        v_is_in_consolidation = true;
        v_Box_Top = v_Ref_High;
        v_Box_Btm = v_Ref_Low;
    end;
end;

if v_is_in_consolidation then begin
    if (Close of Data2 > v_Box_Top) or
       (Close of Data2 < v_Box_Btm) then
        v_is_in_consolidation = false;
end;

{ ==========================================
  Phase 2: V15 Matrix Entry Engine
  ========================================== }

v_Current_ATR = AvgTrueRange(ATR_Length);

{ Cooldown counter }
if MarketPosition <> 0 then
    v_BarsSinceExit = 0
else if MarketPosition = 0 and MarketPosition[1] <> 0 then
    v_BarsSinceExit = 1
else if MarketPosition = 0 then
    v_BarsSinceExit = v_BarsSinceExit + 1;

if v_is_in_consolidation and v_Box_Top > v_Box_Btm then begin

    { Matrix dimension calculations }
    v_Box_Range       = v_Box_Top - v_Box_Btm;
    v_Box_Qualified   = (v_Box_Range / v_Current_ATR >= Min_Box_ATR);
    v_Resistance_Zone = v_Box_Top - v_Box_Range * Entry_Zone_Pct;

    { P3b: Immediate Stop Guard (entry-bar protection)
      Only when not short -> freezes when position opens. }
    if MarketPosition >= 0 then
        SetStopLoss(AbsValue((v_Box_Top + v_Current_ATR * ATR_Stop_Mult) - Close)
                    * BigPointValue);

    { V15 Entry: short at resistance zone via Box_Top Limit
      Limit at Box_Top: in zone = fills when price reaches top;
      above box (false breakout) = fills at open. }
    if MarketPosition       =  0              and
       v_BarsSinceExit     >= Cooldown_Bars   and
       v_Box_Qualified      = true            and
       v_Trend_Dir          = -1              and
       v_Macro_Block        = false           and
       Close                > v_Resistance_Zone and
       Close                < v_Box_Top + v_Current_ATR * 3.0 and
       v_Holiday_Block      = false           and
       v_Settlement_Day     = false           then begin

        SellShort ("CS_Entry") next bar at v_Box_Top Limit;

    end;

end;

{ ==========================================
  Phase 3: V15 Exit Logic
  ========================================== }

{ Reset state when flat }
if MarketPosition = 0 then begin
    v_SL_Locked     = false;
    v_Frozen_ATR    = 0;
    v_Frozen_BoxTop = 0;
    v_Frozen_Target = 0;
end;

if MarketPosition = -1 then begin

    { Freeze target + SL on entry bar (once) }
    if v_SL_Locked = false then begin
        v_Frozen_ATR    = v_Current_ATR;
        v_Frozen_BoxTop = v_Box_Top;

        { Dim 3: Dynamic swing low, capped at Box_Btm }
        v_Frozen_Target = MaxList(Lowest(Low, Swing_Lookback), v_Box_Btm);

        { Minimum reward: if target too close to entry, use Box_Btm }
        if v_Frozen_Target > v_Box_Btm + (v_Box_Top - v_Box_Btm) * 0.5 - v_Frozen_ATR then
            v_Frozen_Target = v_Box_Btm;

        v_Stop_Level = v_Frozen_BoxTop + ATR_Stop_Mult * v_Frozen_ATR;
        v_SL_Locked  = true;
    end;

    { Exit chain with priority gates }
    ExitFired = 0;

    { Priority 0 - Manual Kill }
    if (ExitFired = 0) and Manual_Kill_Switch then begin
        BuyToCover ("CS_Kill") next bar at Market;
        ExitFired = 1;
    end;

    { Priority 0 - Registry Fail-Safe }
    if (ExitFired = 0) and v_Registry_Expired then begin
        BuyToCover ("CS_RegistryEnd") next bar at Market;
        ExitFired = 1;
    end;

    { Priority 0 - Holiday Iron Rule }
    if (ExitFired = 0) and v_Holiday_Block and
       (Time >= Holiday_Flat_Time) then begin
        BuyToCover ("CS_Holiday") next bar at Market;
        ExitFired = 1;
    end;

    { Priority 0 - Monthly Settlement Flat }
    if (ExitFired = 0) and v_Settlement_Day and
       (Time >= Settlement_Flat_Time) then begin
        BuyToCover ("CS_Settlement") next bar at Market;
        ExitFired = 1;
    end;

    { Priority 1 - Box break upward (bad for short position) }
    if (ExitFired = 0) and
       (v_is_in_consolidation = false) and
       (Close of Data2 > v_Frozen_BoxTop) then begin
        BuyToCover ("CS_BreakExit") next bar at Market;
        ExitFired = 1;
    end;

    { Priority 2 - Target + Stop (simultaneous, engine picks first) }
    if ExitFired = 0 then begin
        BuyToCover ("CS_TP") next bar at v_Frozen_Target Limit;
        BuyToCover ("CS_SL") next bar at v_Stop_Level Stop;
    end;

end;
