{ ============================================================
  SECTION 1B - HOLIDAY / REGISTRY / SETTLEMENT DETECTION
  Closed time interval: the tail-bar scan is naturally bounded
  by  Time <= 500, so the 24hr-pitfall does not apply here.
  Other Time>=X usages later are guarded by these state flags.
  ============================================================ }

v_Holiday_Block = False;

{ BUG FIX v1.1 #2: strict < 500. At Time=500 (last night bar) a P0-3
  BuyToCover next bar at Market would fill at post-holiday session reopen
  (could be 3+ days away). Mirrors S1 v2.3 architectural rule. }
if Time < 500 then begin
    for hidx = 1 to 80 begin
        if Date = Holiday_Tail[hidx] then
            v_Holiday_Block = True;
    end;
end;

v_Registry_Expired = False;

if Date > Registry_Valid_Until then begin
    v_Registry_Expired = True;
    v_Holiday_Block    = True;
end;

{ Monthly Settlement detection (3rd Wed of month) }
v_Settlement_Day = ( DayOfWeek( Date ) = 3 ) and
                   ( DayOfMonth( Date ) >= 15 ) and
                   ( DayOfMonth( Date ) <= 21 );

{ Registry-expiry red warning, 30 days out }
if LastBarOnChart and
   DateToJulian( Date ) >= DateToJulian( Registry_Valid_Until ) - 30 then begin
    if Registry_Warn_ID < 0 then begin
        Registry_Warn_ID = Text_New( Date, Time, High + 400,
            "HOLIDAY REGISTRY EXPIRES " +
            NumToStr( Registry_Valid_Until, 0 ) +
            " - REBUILD FROM TAIFEX CALENDAR" );
        Text_SetColor( Registry_Warn_ID, Red );
        Text_SetSize( Registry_Warn_ID, 14 );
        Text_SetAttribute( Registry_Warn_ID, 1, True );
    end;
end;


{ ============================================================
  SECTION 2 - DAILY TIER 1 CALCULATIONS (Data3)

  Per CLAUDE.md Rule #3: Data3 current bar may be partial -
  use [1] for already-closed Daily values. All Tier 1 inputs
  reference [1] of Data3 for stability.
  ============================================================ }

v_Daily_FastMA = Average( Close, Daily_FastMA_Len )[1] of Data3;
v_Daily_SlowMA = Average( Close, Daily_SlowMA_Len )[1] of Data3;
{ BUG FIX v1.0.1: v_Daily_RSI is now read from snapshot (Section 4),
  NOT from inline RSI(...)[1] which was Data1-indexed (5M offset, not Daily). }
v_Daily_RSI    = v_Daily_RSI_Snap0;

{ Distance from MA20 as percentage. Positive when price above MA20.
  BUG FIX v1.1 #7: ( Close of Data3 )[1] with explicit parentheses
  forces parser to bind 'of Data3' first, then apply [1] history to
  the Data3-bound expression. Removes Data1/Data3 binding ambiguity
  across PowerLanguage parser versions. }
if v_Daily_FastMA > 0 then
    v_Daily_Dist_Pct = ( ( Close of Data3 )[1] - v_Daily_FastMA ) /
                       v_Daily_FastMA * 100
else
    v_Daily_Dist_Pct = 0;

{ A: bullish daily structure }
if v_Daily_FastMA > v_Daily_SlowMA then
    v_Trend_OK = True
else
    v_Trend_OK = False;

{ B: RSI > threshold sustained for N completed daily bars.

  BUG FIX v1.0.1 2026-06-19:
    Original loop used RSI(Close of Data3, N)[hidx] where [hidx] is
    Data1-indexed (5M offset), NOT Daily offset. Within the same trading
    day, RSI[1] = RSI[2] = today's RSI (Daily close doesn't change), so
    sustained check collapsed to "today's RSI > threshold" — useless.

  Fix: snapshot-based history (Snap0..Snap3) maintained at new-calendar-day
  boundary in Section 4. Each Snap value is a genuine separate Daily bar's
  closed RSI. Supports Daily_RSI_Sustained_Bars in [1..4]; values >4 are
  capped at 4 (warn user via design doc if optimization sweep needs more). }

v_Daily_RSI_Sustained = True;
if Daily_RSI_Sustained_Bars >= 1 and
   v_Daily_RSI_Snap0 <= Daily_RSI_Threshold then
    v_Daily_RSI_Sustained = False;
if Daily_RSI_Sustained_Bars >= 2 and
   v_Daily_RSI_Snap1 <= Daily_RSI_Threshold then
    v_Daily_RSI_Sustained = False;
if Daily_RSI_Sustained_Bars >= 3 and
   v_Daily_RSI_Snap2 <= Daily_RSI_Threshold then
    v_Daily_RSI_Sustained = False;
if Daily_RSI_Sustained_Bars >= 4 and
   v_Daily_RSI_Snap3 <= Daily_RSI_Threshold then
    v_Daily_RSI_Sustained = False;

if v_Daily_RSI_Sustained then
    v_RSI_OK = True
else
    v_RSI_OK = False;

{ C: distance from MA20 exceeds threshold (overextended) }
if v_Daily_Dist_Pct > Daily_Dist_MA20_Pct then
    v_Dist_OK = True
else
    v_Dist_OK = False;

{ Regime: A AND (B OR C) }
if v_Trend_OK and ( v_RSI_OK or v_Dist_OK ) then
    v_Regime_Watch = True
else
    v_Regime_Watch = False;

{ D8 logging-only: flag when dist > +5% (HighConviction zone).
  v1.1 may sweep a parameter modifier here. v1.0 is observational. }
if v_Daily_Dist_Pct > HighConv_Threshold_Pct then
    v_HighConv_Active = True
else
    v_HighConv_Active = False;


{ ============================================================
  SECTION 3 - 5M TIER 2 CALCULATIONS (Data1)

  M1: Consec_Red_Bars consecutive red 5M candles.
  M2: Close < EMA(EMA_Fast_Len) AND EMA falling vs prior bar.
  M3: ATR(ATR_Short_Len) > ATR(ATR_Long_Len) * ATR_Spike_Mult.
  M4: (HighD(0) - Close) / HighD(0) * 100 within [Min, Max] %.
  ============================================================ }

{ M1 : consecutive red bars (uses small loop) }
v_Red_Loop_OK = True;
for v_red_idx = 0 to Consec_Red_Bars - 1 begin
    if Close[v_red_idx] >= Open[v_red_idx] then
        v_Red_Loop_OK = False;
end;
v_M1_Consec = v_Red_Loop_OK;

{ M2 : EMA fast break + slope down.
  BUG FIX v1.1 #9: second XAverage call instantiated a parallel
  function-series; idiom is one call + variable[1] lookback. }
v_5M_EMA      = XAverage( Close, EMA_Fast_Len );
v_5M_EMA_Prev = v_5M_EMA[1];

if ( Close < v_5M_EMA ) and ( v_5M_EMA < v_5M_EMA_Prev ) then
    v_M2_BelowEMA = True
else
    v_M2_BelowEMA = False;

{ M3 : short/long ATR spike }
v_5M_ATR_Short = AvgTrueRange( ATR_Short_Len );
v_5M_ATR_Long  = AvgTrueRange( ATR_Long_Len );

if ( v_5M_ATR_Long > 0 ) and
   ( v_5M_ATR_Short > v_5M_ATR_Long * ATR_Spike_Mult ) then
    v_M3_ATR_Spike = True
else
    v_M3_ATR_Spike = False;

{ M4 : intraday DAY-SESSION pullback geometry.
  BUG FIX v1.1 #4: HighD(0) is calendar-date-scoped on Data1; for TXF1
  the 00:00-05:00 night-tail bars carry the NEXT trading day's Date,
  so HighD(0) at 08:45 day-open already includes the overnight tail high.
  Track a day-session-only running high that resets at the first bar
  >= Entry_Open_Time on each new Date. }
if ( Date <> v_DaySess_HighDate ) and ( Time >= Entry_Open_Time ) then begin
    v_DaySess_High     = High;
    v_DaySess_HighDate = Date;
end
else if ( Date = v_DaySess_HighDate ) and
        ( Time >= Entry_Open_Time ) and ( Time <= 1345 ) then begin
    if High > v_DaySess_High then
        v_DaySess_High = High;
end;

if v_DaySess_High > 0 then
    v_Pullback_Pct = ( v_DaySess_High - Close ) / v_DaySess_High * 100
else
    v_Pullback_Pct = 0;

if ( v_Pullback_Pct >= Pullback_Min_Pct ) and
   ( v_Pullback_Pct <= Pullback_Max_Pct ) then
    v_M4_Pullback = True
else
    v_M4_Pullback = False;

{ All four AND-ed }
if v_M1_Consec and v_M2_BelowEMA and v_M3_ATR_Spike and v_M4_Pullback then
    v_Trigger_Fired = True
else
    v_Trigger_Fired = False;

{ Exit-side indicator: 5M EMA20 (for D4 structural TP backup) }
v_5M_EMA20 = XAverage( Close, TP_MA_Len );


{ ============================================================
  SECTION 4 - SAME-DAY COOLDOWN RESET
  Strategy is once-per-day. On the first bar of a new date,
  clear the cooldown flag so the next entry window can fire.
  ============================================================ }

{ BUG FIX v1.1 #8: cooldown reset and RSI snapshot have different
  natural cadences. RSI snapshot shifts on calendar-date rollover
  (Data3 bar close cadence) - fires at 00:00 night-session bar.
  Cooldown reset, however, gates entries which only happen during
  day session; reset must wait until Time >= Entry_Open_Time so a
  same-trading-day late-night re-entry attempt can't get past the
  gate accidentally if Entry_Open_Time is ever optimized lower. }
if Date <> v_LastSeenDate then begin
    { Snapshot shift: always on calendar-date rollover }
    v_Daily_RSI_Snap3 = v_Daily_RSI_Snap2;
    v_Daily_RSI_Snap2 = v_Daily_RSI_Snap1;
    v_Daily_RSI_Snap1 = v_Daily_RSI_Snap0;
    v_Daily_RSI_Snap0 = RSI( Close, Daily_RSI_Len ) of Data3;

    { Cooldown reset: gated by day-session open }
    if Time >= Entry_Open_Time then begin
        v_DailyCooldown_Active = False;
        v_LastSeenDate         = Date;
    end;
end;


{ ============================================================
  SECTION 5 - P3b IMMEDIATE STOP GUARD (SetStopLoss)  [Rule #12]

  MC engine-level stop. Active on entry bar without IOG
  dependency. Closes the structural unprotected window
  between fill and the first custom stop evaluation.

  Distance = SL_ATR_Mult * ATR(SL_ATR_Len) * BigPointValue.
  Same anchor that drives the implicit ATR stop in v1.0.

  Short strategy variant: gate on MP >= 0 (when flat or long).
  Freezes at signal-bar ATR once the short opens.

  Per CLAUDE.md Rule #12: exactly ONE SetStopLoss call.
  ============================================================ }

{ BUG FIX v1.1 #10: Frozen SL backup (Section 5a) +
  SetStopLoss engine guard (Section 5b). Both use the same ATR
  anchor frozen at entry, mirroring L5 pattern. }

{ ---- 5a: Frozen SL setup (locks once per trade on entry bar) ---- }
if MarketPosition = -1 then begin
    if v_SL_Locked = False then begin
        v_Frozen_ATR_5M  = AvgTrueRange( SL_ATR_Len );
        v_Frozen_SL_Dist = v_Frozen_ATR_5M * SL_ATR_Mult;
        v_SL_Level       = EntryPrice + v_Frozen_SL_Dist;
        v_SL_Locked      = True;
    end;
end
else begin
    v_SL_Locked      = False;
    v_Frozen_ATR_5M  = 0;
    v_Frozen_SL_Dist = 0;
    v_SL_Level       = 0;
end;

{ ---- 5b: P3b SetStopLoss engine guard (shares frozen ATR once locked) ---- }
if v_SL_Locked = True then
    v_SL_ATR = v_Frozen_ATR_5M
else
    v_SL_ATR = AvgTrueRange( SL_ATR_Len );

if MarketPosition >= 0 then
    SetStopLoss( v_SL_ATR * SL_ATR_Mult * BigPointValue );


{ ============================================================
  SECTION 6 - ENTRY LOGIC

  Gates (all must be true):
    - Flat (MP = 0)
    - v_Regime_Watch          (Tier 1 daily regime)
    - v_Trigger_Fired         (Tier 2 4-AND momentum)
    - Time within [Entry_Open_Time, Entry_Cutoff_Time]  (D5)
    - Not on cooldown
    - Not on a holiday tail bar (v_Holiday_Block = false)
    - Not on a settlement day (v_Settlement_Day = false)
    - Holiday registry not expired

  Closed-interval safety: the time window is explicitly
  Time >= X AND Time <= Y (no half-open trap).
  ============================================================ }

if ( MarketPosition = 0 ) and
   ( v_Regime_Watch = True ) and
   ( v_Trigger_Fired = True ) and
   ( Time >= Entry_Open_Time ) and
   ( Time <= Entry_Cutoff_Time ) and
   ( v_DailyCooldown_Active = False ) and
   ( v_Holiday_Block = False ) and
   ( v_Settlement_Day = False ) and
   ( v_Registry_Expired = False ) then begin
    { BUG FIX v1.1 #5: manual entry-bar counter removed -
      use BarsSinceEntry built-in in Section 7. }
    SellShort( "SE_RPS_Entry" ) next bar at Market;
end;


{ ============================================================
  SECTION 7 - EXIT CHAIN (Priority 0 first)

  PRIORITY ORDER (per CLAUDE.md Rule #11 Settlement_Flat):
    P0-1  SX_RPS_Kill          (Manual_Kill_Switch)
    P0-2  SX_RPS_RegistryEnd   (registry expired)
    P0-3  SX_RPS_HolFlat       (holiday tail + Holiday_Flat_Time)
    P0-4  SX_RPS_Settlement    (settlement day + Settlement_Flat_Time)
    P0a   SX_RPS_DayClose      (daily force flat by 13:25)
    S-1   SX_RPS_TP            (0.7% target OR EMA20 touch)
    S-2   SX_RPS_TimeStop      (24 5M bars)
    (SL handled by engine-level SetStopLoss in Section 5)

  CLOSED-INTERVAL AUDIT for every Time >= X in this block:
    Holiday_Flat_Time : guarded by v_Holiday_Block (which is
                        only true for Time <= 500 OR registry
                        expiry). Bounded.
    Settlement_Flat_Time : guarded by v_Settlement_Day (date
                        condition; Time effectively scoped to
                        the current trading day window).
    Daily_Flat_Time   : closes the day session. Day session
                        ends 13:45 so Time stays bounded.
                        Note: night session does NOT trigger
                        this because by then MP would have
                        been flattened by Daily_Flat_Time
                        earlier in the same trading day.
  ============================================================ }

ExitFired = 0;

if MarketPosition = -1 then begin

    { ---- P0-1 Manual kill switch ---- }
    if ( ExitFired = 0 ) and ( Manual_Kill_Switch = True ) then begin
        BuyToCover( "SX_RPS_Kill" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- P0-2 Registry fail-safe ---- }
    if ( ExitFired = 0 ) and ( v_Registry_Expired = True ) then begin
        BuyToCover( "SX_RPS_RegistryEnd" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- P0-3 Holiday iron rule (state-guarded Time>=X)
           BUG FIX v1.1 #2: explicit Time <= 455 upper bound as
           belt-and-suspenders against future revert of strict < 500. ---- }
    if ( ExitFired = 0 ) and
       ( v_Holiday_Block = True ) and
       ( Time >= Holiday_Flat_Time ) and
       ( Time <= 455 ) then begin
        BuyToCover( "SX_RPS_HolFlat" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- P0-4 Settlement flat (state-guarded Time>=X) ---- }
    if ( ExitFired = 0 ) and
       ( v_Settlement_Day = True ) and
       ( Time >= Settlement_Flat_Time ) then begin
        BuyToCover( "SX_RPS_Settlement" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- P0a Daily force flat before 13:25.
           Bounded by day session end; safe with Time>=X.
           BUG FIX v1.1 #3: upper bound MUST be 1340 (not 1345).
           An order placed on the 1345 bar would fill at 15:00
           night-session open, crossing a 1h15m no-trading gap.
           With Time<=1340 latest firing bar is 1340 which fills at
           1345 open (still inside day session). ---- }
    if ( ExitFired = 0 ) and
       ( Time >= Daily_Flat_Time ) and
       ( Time <= 1340 ) then begin
        BuyToCover( "SX_RPS_DayClose" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- Strategy exits (TP / time stop) ---- }
    if ExitFired = 0 then begin

        v_Bars_Held     = BarsSinceEntry;   { BUG FIX v1.1 #5: +1 offset removed }
        v_TP_Pct_Level  = EntryPrice * ( 1 - TP_Pct / 100 );
        v_TP_EMA20      = v_5M_EMA20;

        { TP: percentage target OR (optional) 5M EMA20 touch from above.
          For a short, both are "favorable price lower than entry".

          BUG FIX v1.1 #1: EMA20 backup requires THREE additional guards
          to prevent fill-bar trap (in original v1.0, M2 sets up Close<EMA5
          with EMA5 falling and M4 = 0.5-1.5% pullback, geometry that
          almost always has EMA20 above Close on fill bar; backup fired
          on bar 1 with 5min hold and gutted the 0.7% TP design):

            1. v_Bars_Held >= TP_EMA20_MinBars : skip the fill-bar trap
            2. v_5M_EMA20[1] < EntryPrice : EMA20 sat structurally below
                                            entry (real "from above" geometry)
            3. Close[1] > v_TP_EMA20[1]   : genuine cross-from-above THIS bar
                                            (not stale pre-existing level) }
        if ( Close <= v_TP_Pct_Level ) or
           ( ( TP_Use_EMA20_Backup = True ) and
             ( v_Bars_Held >= TP_EMA20_MinBars ) and
             ( v_5M_EMA20[1] < EntryPrice ) and
             ( Close[1] > v_TP_EMA20[1] ) and
             ( Close <= v_TP_EMA20 ) ) then begin
            BuyToCover( "SX_RPS_TP" ) next bar at Market;
            ExitFired = 1;
        end
        else if v_Bars_Held >= Max_Bars_TimeStop then begin
            BuyToCover( "SX_RPS_TimeStop" ) next bar at Market;
            ExitFired = 1;
        end;

        { ---- S-3 Frozen SL backup (BUG FIX v1.1 #10: belt+suspenders
                with Section 5b SetStopLoss engine guard) ---- }
        if ( ExitFired = 0 ) and ( v_SL_Locked = True ) then
            BuyToCover( "SX_RPS_SL" ) next bar at v_SL_Level Stop;

        { SL: handled by SetStopLoss (Section 5).
          No explicit SellAtStop here -> avoids double-stop conflict
          and respects Rule #12's single-call mandate. }

    end;

end;


{ ============================================================
  SECTION 8 - COOLDOWN SET ON EXIT
  Any exit fired this bar -> cooldown active until tomorrow.
  Cleared in Section 4 when Date changes.
  ============================================================ }

if ExitFired > 0 then begin
    v_DailyCooldown_Active = True;
    { BUG FIX v1.1 #11: v_S3_LastExitDate removed (dead state - never read) }
end;


{ ============================================================
  SECTION 9 - DIAGNOSTIC LOGGING (D8 v1.0 logging-only)
  HighConviction zone: Daily distance from MA20 > +5%.
  v1.0 prints to MC output log only - no parameter change yet.
  v1.1 may sweep a TP_Pct modifier when v_HighConv_Active.
  ============================================================ }

{ BUG FIX v1.0.1 2026-06-19:
    LastBarOnChart_Ex( 0 ) does NOT exist in PowerLanguage. MC fails to
    compile. Standard name is LastBarOnChart (bool keyword, no parens).

    BUT: LastBarOnChart only fires on the very last bar of the dataset,
    which gives only 1 log line per backtest — useless for diagnostic.

    Better: log once per NEW Daily day (Date <> Date[1]) to give one
    snapshot per Daily-bar update without spamming 240+ lines/day. }
if Log_HighConviction and v_HighConv_Active and ( Date <> Date[1] ) then
    Print( "S3 HighConv ", Date:8:0,
           " dist=", v_Daily_Dist_Pct:0:2, "%",
           " regime=",  v_Regime_Watch,
           " trigger=", v_Trigger_Fired,
           " RSI0=", v_Daily_RSI_Snap0:0:2,
           " RSI1=", v_Daily_RSI_Snap1:0:2 );


{ ============================================================
  END OF FILE - S3_RapidPullbackShort.pla  v1.1

  TIME-SAFETY VERIFICATION (closed-interval audit):
    Line in Section 1B  if Time < 500            OK upper-bounded
    Line in Section 6   Time >= Entry_Open_Time
                        AND Time <= Entry_Cutoff_Time
                                                  OK paired
    Line in Section 7   Time >= Holiday_Flat_Time guarded by
                        v_Holiday_Block (only true when Time<500
                        OR registry expired) AND Time <= 455
                                                  OK state-guarded + paired
    Line in Section 7   Time >= Settlement_Flat_Time guarded by
                        v_Settlement_Day (date-scoped)  OK
    Line in Section 7   Time >= Daily_Flat_Time
                        AND Time <= 1340          OK paired

  No bare Time>=X without a pair or a state-guard. Cross-day
  pitfall avoided.

  v1.1 PATCH NOTES (2026-06-19):
    13 audit-workflow bugs patched on top of v1.0.1 (which had
    fixed the 3 critical pre-release blockers: LastBarOnChart_Ex
    compile blocker, RSI[1] Daily-vs-5M indexing, RSI[hidx]
    sustained-loop). The patches in this revision:

      #1  [HIGH]   EMA20 backup TP fill-bar trap fixed with three
                   new guards (TP_EMA20_MinBars, EMA20[1]<EntryPrice,
                   Close[1]>EMA20[1] cross-from-above this bar).
      #2  [HIGH]   Holiday block strict < 500 (was <= 500) +
                   explicit Time <= 455 on P0-3 HolFlat exit.
      #3  [HIGH]   Daily flat upper bound 1340 (was 1345) - avoids
                   filling at 15:00 night-session reopen across
                   the 1h15m no-trading gap.
      #4  [HIGH]   HighD(0) overnight contamination replaced with
                   day-session-only v_DaySess_High tracker that
                   resets at Entry_Open_Time on each new Date.
      #5  [MED]    BarsSinceEntry replaces manual entry-bar
                   counter (removes +1 offset bug).
      #6  [MED]    Holiday_Flat_Time = 245 (was 415) to align with
                   design_spec_v2 §5.2/§5.3 (27 retry windows).
      #7  [MED]    ( Close of Data3 )[1] explicit parentheses
                   removes Data1/Data3 binding ambiguity.
      #8  [MED]    Cooldown reset split from RSI snapshot shift;
                   gated by Time >= Entry_Open_Time.
      #9  [MED]    XAverage dedup - one call + variable[1] instead
                   of two parallel function-series instances.
      #10 [MED]    Frozen SL backup (L1-L5 pattern): Section 5a
                   locks ATR/SL on entry bar, 5b shares frozen ATR
                   with SetStopLoss, S-3 BuyToCover at Stop in
                   Section 7 belt-and-suspenders.
      #11 [LOW]    v_S3_LastExitDate dead-state removed.
      #15 [LOW]    MC Load Name gets S3_ infix.
      #16 [LOW]    Entry_Open_Time = 850 (was 845) - 5M bars stamp
                   at close time; 845 stamp does not exist.

  NOT applied in v1.1 (intentional, documented):
      #12 Data2 unused      - preserve 3-feed shape for v1.1 MFE.
      #13 Loop 1..80        - byte-identical with L1-L5 invariant.
      #14 Section renumber  - high churn, zero runtime benefit.
============================================================ }
