{ ================================================================================
  S16_S_10M - MOVING AVERAGE CROSS SHORT STRATEGY (10M TIMEFRAME EXPERIMENT)
  Signal Name : S16_S_10M_MACrossShort
  MC Load Name: STRATEGY_GEN_S16_S_10M_MACrossShort   << DIFFERENT from 5M version!
  Version     : v0.1-PORT  (2026-07-18 - W2 port from S16_S v1.4-BELATE)

  PURPOSE (Stage-1 ruling 2026-07-18):
    Primary = timeframe ROBUSTNESS evidence for the deployed 5M sniper
    (S16_S v1.4, live_simulation). Secondary = IF standalone PF >= 1.5
    AND monthly P&L correlation vs 5M < 0.5, option C (second sleeve)
    opens for discussion (requires portfolio-saturation exception).
    NOT a replacement for the 5M version (deployed and frozen).

  CONVERSION DOCTRINE (G2-proven): TIME CONSTANTS FIXED, bar counts
  halved, price thresholds unchanged, ATR-relative values provisional.

  CONVERSION TABLE (5M v1.4 -> 10M v0.1):
    ZLEMA_Fast            25 -> 12   (125min -> 120min, time-preserving)
    ZLEMA_Slow            70 -> 35   (350min -> 350min)
    MinSlope              28 -> 44 PROVISIONAL - THE ONLY GA PARAMETER
                          (bar slope scales x1.4-2.0 at 10M; scan 32-64
                          step 4 once at W3, plateau-check, then FREEZE
                          per Parameter Freeze Doctrine)
    QuickStop_MaxBars      4 -> 2    (20min unchanged)
    QuickStop_MaxLoss_Pts 60 -> 60   (price units timeframe-independent)
    MaxHoldingBars        24 -> 12   (2hr momentum window, G2 two-sided proof)
    ATR_Len               14 -> 7    (70min)
    StopATRMult          4.0 -> 4.0  (kept; last-resort layer - W3 review:
                          ATR at 10M is ~1.4x larger in points)
    BE 2.5/3.5 ATR + 15/20 buffers   (kept provisional; ATR unit larger
                          means BE arms later - W3 review)
    ML_VolAvgLen          15 -> 8 / ML_MA_ShortLen 10 -> 5
    ML_ATR_ShortLen        3 -> 2 / ML_ATR_LongLen 90 -> 45
    Tail_LastEntry 430 / Tail_ForceExit 440 UNCHANGED
                          (10M tail bars stamp 0420/0430/0440/0450/0500;
                          signal 430 -> fill 04:30, signal 440 -> fill 04:40,
                          verified same semantics as 5M)
    Holiday registry / Settlement / Registry expiry IDENTICAL.

  PRE-COMMITTED GATES (locked before any backtest, 2026-07-18):
    Survival: PF >= 1.5 AND >= 8 trades/yr AND TimeStop-class winners exist
    Correlation: monthly P&L corr vs 5M v1.4 measured (< 0.5 opens option C)
    KILL line: PF < 1.3 across the whole reasonable MinSlope scan
               -> KILL + FINAL_VERDICT.md (records 5M-granularity-edge proof)

  EXPECTED TRADE-OFF (the experimental question):
    10M enters 5-10 min later = misses the steepest opening segment of
    each burst (structural disadvantage), but halved bar count filters
    more fake bursts = fewer whipsaw premiums (structural advantage).
    Does the saved insurance premium repay the missed opening segment?

  CHART SETUP REQUIRED:
    Data1 = TXF1 10M  << NOT 5M
    IntrabarOrderGeneration = FALSE
    MaxBarsBack >= 200
    Slippage 1000/side, capital 1,000,000, fixed 1 lot (same as 5M runs)

  LABEL CONVENTIONS: same SE_MA_ / SX_MA_ set as 5M version.
  EXIT PRIORITY CHAIN: identical P0 -> P0.5 -> P1 ... P7 structure.
================================================================================ }

[IntrabarOrderGeneration = False]


{ ============================================================
  SECTION 1 - INPUTS
  ============================================================ }
inputs:
    { ===== Group A: Entry (ZLEMA) - 10M time-preserving port ===== }
    ZLEMA_Fast              ( 12    ),
    ZLEMA_Slow              ( 35    ),
    { MinSlope PROVISIONAL 44 - the ONLY parameter to GA at W3     }
    { (scan 32-64 step 4, Net Profit, everything else LOCKED),     }
    { plateau-check, then FREEZE per Parameter Freeze Doctrine.    }
    MinSlope                ( 44    ),

    { ===== Group B: M5 Quick Stop (20min / 60pts) ===== }
    QuickStop_On            ( True  ),
    QuickStop_MaxBars       ( 2     ),
    QuickStop_MaxLoss_Pts   ( 60    ),

    { ===== Group C: M6 Rule #17 Multi-Layer Monitor ===== }
    ML_On                   ( True  ),
    ML_ActivationPct        ( 20    ),
    ML_ScoreTrigger         ( 60    ),
    ML_MinCategories        ( 3     ),
    ML_VolAvgLen            ( 8     ),
    ML_VolSpikeMult         ( 2.0   ),
    ML_MA_ShortLen          ( 5     ),
    ML_ATR_ShortLen         ( 2     ),
    ML_ATR_LongLen          ( 45    ),
    ML_ATR_Ratio            ( 2.5   ),

    { ===== Group D: M7 Breakeven Trailing - LATE activation (v1.4 doctrine) ===== }
    BE_On                   ( True  ),
    BE_Trigger_ATR          ( 2.5   ),
    BE_Buffer_Pts           ( 15    ),
    BE_Tier2_ATR            ( 3.5   ),
    BE_Tier2_Buffer_Pts     ( 20    ),

    { ===== Group E: M8 Time Stop (2hr momentum window, G2-proven) ===== }
    M8_On                   ( True  ),
    MaxHoldingBars          ( 12    ),

    { ===== Group F: ATR SL (Frozen, 70min basis) ===== }
    ATR_Len                 ( 7     ),
    StopATRMult             ( 4.0   ),

    { ===== Group H: Rule #11 Compliance ===== }
    Holiday_Flat_Time       ( 415   ),
    Registry_Valid_Until    ( 1270101 ),
    Manual_Kill_Switch      ( False ),
    Settlement_Flat_Time    ( 1230  ),

    { ===== Group I: Tail Time Guard (identical semantics at 10M) ===== }
    Tail_LastEntry_Time     ( 430   ),
    Tail_ForceExit_Time     ( 440   );


{ ============================================================
  SECTION 2 - VARIABLES
  ============================================================ }
variables:
    v_Fast_Lag              ( 0     ),
    v_Slow_Lag              ( 0     ),
    v_ZLEMA_Fast            ( 0     ),
    v_ZLEMA_Slow            ( 0     ),
    v_Slope                 ( 0     ),

    v_Death_Cross           ( False ),
    v_Golden_Cross          ( False ),

    v_ATR                   ( 0     ),
    v_StopDist              ( 0     ),

    v_EntryBar              ( 0     ),
    v_BarsSince             ( 0     ),
    v_Prev_MP               ( 0     ),
    v_Loss                  ( 0     ),
    v_Profit                ( 0     ),

    v_SL_Locked             ( False ),
    v_Frozen_ATR            ( 0     ),
    v_Frozen_SL_Dist        ( 0     ),
    v_SL_Level              ( 0     ),

    v_QuickStop_Fired       ( False ),

    v_ML_Loss               ( 0     ),
    v_ML_Activation_Level   ( 0     ),
    v_ML_Score              ( 0     ),
    v_ML_Score_Pct          ( 0     ),
    v_ML_CatCount           ( 0     ),
    v_ML_Trigger            ( False ),
    v_ML_Cat_1F             ( 0     ),
    v_ML_Cat_2F             ( 0     ),
    v_ML_Cat_3F             ( 0     ),
    v_ML_Cat_4F             ( 0     ),
    v_ML_Cat_5F             ( 0     ),
    v_ML_AvgVol             ( 0     ),
    v_ML_ATR_Short          ( 0     ),
    v_ML_ATR_Long           ( 0     ),
    v_ML_RSI                ( 0     ),
    v_ML_RSI_Prior          ( 0     ),
    v_ML_MA_Short           ( 0     ),

    v_BE_Tier1_Active       ( False ),
    v_BE_Tier2_Active       ( False ),
    v_BE_Stop_Tier1         ( 0     ),
    v_BE_Stop_Tier2         ( 0     ),

    v_Holiday_Block         ( False ),
    v_Registry_Expired      ( False ),
    v_Settlement_Day        ( False ),
    hidx                    ( 0     ),
    ExitFired               ( 0     );

arrays:
    Holiday_Tail[80](0);


{ ============================================================
  SECTION 3 - PRIORITY 0 COMPLIANCE CHECKS
  (identical to S16_S 5M v1.4: HolidayFlat_v3 63 entries)
  ============================================================ }

if CurrentBar = 1 then begin
    Holiday_Tail[1]  = 1190913;  Holiday_Tail[2]  = 1191010;
    Holiday_Tail[3]  = 1200101;
    Holiday_Tail[4]  = 1200121;  Holiday_Tail[5]  = 1200228;
    Holiday_Tail[6]  = 1200402;  Holiday_Tail[7]  = 1200501;
    Holiday_Tail[8]  = 1200625;  Holiday_Tail[9]  = 1201001;
    Holiday_Tail[10] = 1201009;  Holiday_Tail[11] = 1210101;
    Holiday_Tail[12] = 1210206;  Holiday_Tail[13] = 1210227;
    Holiday_Tail[14] = 1210402;  Holiday_Tail[15] = 1210612;
    Holiday_Tail[16] = 1210918;  Holiday_Tail[17] = 1211009;
    Holiday_Tail[18] = 1211231;
    Holiday_Tail[19] = 1220127;  Holiday_Tail[20] = 1220226;
    Holiday_Tail[21] = 1220402;  Holiday_Tail[22] = 1220430;
    Holiday_Tail[23] = 1220603;  Holiday_Tail[24] = 1220909;
    Holiday_Tail[25] = 1221008;  Holiday_Tail[26] = 1221231;
    Holiday_Tail[27] = 1230118;  Holiday_Tail[28] = 1230225;
    Holiday_Tail[29] = 1230401;  Holiday_Tail[30] = 1230429;
    Holiday_Tail[31] = 1230622;  Holiday_Tail[32] = 1230929;
    Holiday_Tail[33] = 1231007;  Holiday_Tail[34] = 1231230;
    Holiday_Tail[35] = 1240206;  Holiday_Tail[36] = 1240228;
    Holiday_Tail[37] = 1240404;  Holiday_Tail[38] = 1240501;
    Holiday_Tail[39] = 1240608;  Holiday_Tail[40] = 1240917;
    Holiday_Tail[41] = 1241010;  Holiday_Tail[42] = 1250101;
    Holiday_Tail[43] = 1250123;  Holiday_Tail[44] = 1250228;
    Holiday_Tail[45] = 1250403;  Holiday_Tail[46] = 1250501;
    Holiday_Tail[47] = 1250530;  Holiday_Tail[48] = 1250927;
    Holiday_Tail[49] = 1251004;  Holiday_Tail[50] = 1251010;
    Holiday_Tail[51] = 1251024;  Holiday_Tail[52] = 1251225;
    Holiday_Tail[53] = 1260101;
    Holiday_Tail[54] = 1260212;  Holiday_Tail[55] = 1260227;
    Holiday_Tail[56] = 1260403;  Holiday_Tail[57] = 1260501;
    Holiday_Tail[58] = 1260619;  Holiday_Tail[59] = 1260925;
    Holiday_Tail[60] = 1261009;  Holiday_Tail[61] = 1261024;
    Holiday_Tail[62] = 1261225;  Holiday_Tail[63] = 1270101;
end;

v_Registry_Expired = False;
if Date > Registry_Valid_Until then
    v_Registry_Expired = True;

v_Holiday_Block = False;
if Time <= 500 then begin
    for hidx = 1 to 80 begin
        if Date = Holiday_Tail[hidx] then
            v_Holiday_Block = True;
    end;
end;

if v_Registry_Expired = True then
    v_Holiday_Block = True;

v_Settlement_Day = ( DayOfWeek(Date) = 3 ) and
                   ( DayOfMonth(Date) >= 15 ) and
                   ( DayOfMonth(Date) <= 21 );


{ ============================================================
  SECTION 4 - INDICATORS (ZLEMA)
  ============================================================ }

v_Fast_Lag = IntPortion( ( ZLEMA_Fast - 1 ) / 2 );
v_Slow_Lag = IntPortion( ( ZLEMA_Slow - 1 ) / 2 );

v_ZLEMA_Fast = XAverage( 2 * Close - Close[v_Fast_Lag], ZLEMA_Fast );
v_ZLEMA_Slow = XAverage( 2 * Close - Close[v_Slow_Lag], ZLEMA_Slow );

{ Positive value = Fast is falling = bearish momentum = good for short }
v_Slope = v_ZLEMA_Fast[1] - v_ZLEMA_Fast;


{ ============================================================
  SECTION 5 - CROSS DETECTION
  ============================================================ }

v_Death_Cross  = v_ZLEMA_Fast[1] >= v_ZLEMA_Slow[1] and
                 v_ZLEMA_Fast    <  v_ZLEMA_Slow;

v_Golden_Cross = v_ZLEMA_Fast[1] <= v_ZLEMA_Slow[1] and
                 v_ZLEMA_Fast    >  v_ZLEMA_Slow;


{ ============================================================
  SECTION 6 - ATR + STOP DISTANCE
  ============================================================ }

v_ATR      = AvgTrueRange( ATR_Len );
v_StopDist = v_ATR * StopATRMult;


{ ============================================================
  SECTION 7 - FROZEN SL SETUP + SetStopLoss (Rule #12)
  ============================================================ }

if MarketPosition = -1 then begin
    if v_SL_Locked = False then begin
        v_Frozen_ATR     = v_ATR;
        v_Frozen_SL_Dist = v_Frozen_ATR * StopATRMult;
        v_SL_Level       = EntryPrice + v_Frozen_SL_Dist;
        v_SL_Locked      = True;
        v_EntryBar        = CurrentBar;
        v_QuickStop_Fired = False;
        v_BE_Tier1_Active = False;
        v_BE_Tier2_Active = False;
    end;
end
else begin
    v_SL_Locked          = False;
    v_Frozen_ATR         = 0;
    v_Frozen_SL_Dist     = 0;
    v_SL_Level           = 0;
    v_EntryBar           = 0;
    v_QuickStop_Fired    = False;
    v_BE_Tier1_Active    = False;
    v_BE_Tier2_Active    = False;
end;

if v_SL_Locked = True then
    v_StopDist = v_Frozen_SL_Dist;

if MarketPosition >= 0 then
    SetStopLoss( v_StopDist * BigPointValue );


{ ============================================================
  SECTION 8 - M6 MULTI-LAYER INDICATOR PRECOMPUTE
  5 categories, 1 factor each. Lightweight by design.
  ============================================================ }

v_ML_AvgVol    = Average( Volume, ML_VolAvgLen );
v_ML_ATR_Short = AvgTrueRange( ML_ATR_ShortLen );
v_ML_ATR_Long  = AvgTrueRange( ML_ATR_LongLen );
v_ML_RSI       = RSI( Close, 14 );
v_ML_MA_Short  = Average( Close, ML_MA_ShortLen );


{ ============================================================
  SECTION 9 - ENTRY (Death Cross + Slope + gates)
  ============================================================ }

if MarketPosition = 0 and
   v_Death_Cross         = True and
   v_Slope               > MinSlope and
   ( Time <= Tail_LastEntry_Time or Time > 500 ) and
   v_Settlement_Day      = False and
   v_Holiday_Block       = False and
   v_Registry_Expired    = False and
   Manual_Kill_Switch    = False then begin
    sell short ( "SE_MA_DeathCross" ) next bar at market;
end;


{ ============================================================
  SECTION 10 - EXIT PRIORITY CHAIN (P0 to P7)
  ============================================================ }

if MarketPosition = -1 then begin

    ExitFired = 0;
    v_BarsSince = CurrentBar - v_EntryBar;
    v_Loss = Close - EntryPrice;
    v_Profit = EntryPrice - Close;

    { ---- P0: Priority 0 compliance ---- }
    if Manual_Kill_Switch = True then begin
        buy to cover ( "SX_MA_Kill" ) next bar at market;
        ExitFired = 1;
    end;

    if ExitFired = 0 and v_Registry_Expired = True then begin
        buy to cover ( "SX_MA_Registry" ) next bar at market;
        ExitFired = 1;
    end;

    if ExitFired = 0 and v_Holiday_Block = True and
       Time >= Holiday_Flat_Time then begin
        buy to cover ( "SX_MA_Holiday" ) next bar at market;
        ExitFired = 1;
    end;

    if ExitFired = 0 and v_Settlement_Day = True and
       Time >= Settlement_Flat_Time then begin
        buy to cover ( "SX_MA_Settlement" ) next bar at market;
        ExitFired = 1;
    end;

    { ---- P0.5: Tail Force Exit - flat before session close ---- }
    if ExitFired = 0 and
       Time >= Tail_ForceExit_Time and Time <= 500 then begin
        buy to cover ( "SX_MA_TailFlat" ) next bar at market;
        ExitFired = 1;
    end;

    { ---- P1: M5 Quick Stop ---- }
    if ExitFired = 0 and QuickStop_On = True and
       v_QuickStop_Fired = False then begin

        if v_Loss > QuickStop_MaxLoss_Pts then begin
            buy to cover ( "SX_MA_QuickStop_Loss" ) next bar at market;
            v_QuickStop_Fired = True;
            ExitFired = 1;
        end;

        if ExitFired = 0 and
           v_BarsSince >= QuickStop_MaxBars and
           Close >= EntryPrice then begin
            buy to cover ( "SX_MA_QuickStop_Time" ) next bar at market;
            v_QuickStop_Fired = True;
            ExitFired = 1;
        end;
    end;

    { ---- P2: M6 Rule #17 Multi-Layer Monitor ---- }
    if ExitFired = 0 and ML_On = True then begin

        v_ML_Activation_Level = v_StopDist * ML_ActivationPct / 100;

        if v_Loss > v_ML_Activation_Level then begin

            v_ML_Cat_1F = 0;
            v_ML_Cat_2F = 0;
            v_ML_Cat_3F = 0;
            v_ML_Cat_4F = 0;
            v_ML_Cat_5F = 0;

            if Close > High[1] and Close > Open then
                v_ML_Cat_1F = 1;

            if Volume > v_ML_AvgVol * ML_VolSpikeMult then
                v_ML_Cat_2F = 1;

            v_ML_RSI_Prior = Lowest( RSI( Close, 14 ), 5 );
            if v_ML_RSI_Prior < 30 and v_ML_RSI > 40 then
                v_ML_Cat_3F = 1;

            if Low > Low[1] and Close > v_ML_MA_Short then
                v_ML_Cat_4F = 1;

            if v_ML_ATR_Long > 0 and
               v_ML_ATR_Short / v_ML_ATR_Long > ML_ATR_Ratio then
                v_ML_Cat_5F = 1;

            v_ML_Score    = v_ML_Cat_1F + v_ML_Cat_2F + v_ML_Cat_3F +
                            v_ML_Cat_4F + v_ML_Cat_5F;
            v_ML_Score_Pct = v_ML_Score / 5 * 100;
            v_ML_CatCount = v_ML_Score;

            v_ML_Trigger = v_ML_Score_Pct >= ML_ScoreTrigger and
                           v_ML_CatCount >= ML_MinCategories;

            if v_ML_Trigger = True then begin
                buy to cover ( "SX_MA_ML_Exit" ) next bar at market;
                ExitFired = 1;
            end;
        end;
    end;

    { ---- P3: M7 Breakeven Trailing (late activation) ---- }
    if ExitFired = 0 and BE_On = True then begin

        if v_Profit >= BE_Tier2_ATR * v_ATR then begin
            v_BE_Tier2_Active = True;
            v_BE_Tier1_Active = True;
        end
        else if v_Profit >= BE_Trigger_ATR * v_ATR then begin
            v_BE_Tier1_Active = True;
        end;

        if ExitFired = 0 and v_BE_Tier2_Active = True then begin
            v_BE_Stop_Tier2 = EntryPrice - BE_Tier2_Buffer_Pts;
            if Close >= v_BE_Stop_Tier2 then begin
                buy to cover ( "SX_MA_BE_Trail2" ) next bar at market;
                ExitFired = 1;
            end;
        end;

        if ExitFired = 0 and v_BE_Tier1_Active = True then begin
            v_BE_Stop_Tier1 = EntryPrice - BE_Buffer_Pts;
            if Close >= v_BE_Stop_Tier1 then begin
                buy to cover ( "SX_MA_BE_Trail1" ) next bar at market;
                ExitFired = 1;
            end;
        end;
    end;

    { ---- P4: Golden Cross main exit ---- }
    if ExitFired = 0 and v_Golden_Cross = True then begin
        buy to cover ( "SX_MA_GoldenCross" ) next bar at market;
        ExitFired = 1;
    end;

    { ---- P5: M8 Time Stop (12 bars = 2hr at 10M) ---- }
    if ExitFired = 0 and M8_On = True and
       v_BarsSince >= MaxHoldingBars then begin
        buy to cover ( "SX_MA_TimeStop" ) next bar at market;
        ExitFired = 1;
    end;

    { ---- P6: ATR-based Frozen SL (last resort) ---- }
    if ExitFired = 0 and v_SL_Locked = True then begin
        buy to cover ( "SX_MA_SL" ) next bar at v_SL_Level Stop;
    end;

    { P7 handled by SetStopLoss in Section 7 }

end;


{ ============================================================
  SECTION 11 - PREV_MP TRACKING (last line, per PL Rule 8)
  ============================================================ }
v_Prev_MP = MarketPosition;
