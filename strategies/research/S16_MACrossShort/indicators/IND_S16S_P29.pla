    v_Cnt29                 ( 0     ),

    { ---- diamond, its own everything.  Nothing below is read by the
      six-pivot chain and nothing above is written by this block. ---- }
    v_DChain                ( 0     ),
    v_DOk                   ( False ),
    v_DKind                 ( 0     ),     { 30 top, 61 bottom }
    v_DOrder                ( 0     ),     { 1 high first, 2 low first }
    v_DH1( 0 ), v_DH2( 0 ), v_DH3( 0 ), v_DH4( 0 ), v_DH5( 0 ),
    v_DL1( 0 ), v_DL2( 0 ), v_DL3( 0 ), v_DL4( 0 ), v_DL5( 0 ),
    v_DH1d( 0 ), v_DH3d( 0 ), v_DH5d( 0 ),
    v_DL1d( 0 ), v_DL3d( 0 ), v_DL5d( 0 ),
    v_DH1t( 0 ), v_DH3t( 0 ), v_DH5t( 0 ),
    v_DL1t( 0 ), v_DL3t( 0 ), v_DL5t( 0 ),
    v_Seq30                 ( 0     ),
    v_Seq61                 ( 0     ),
    v_dj                    ( 0     ),
    v_DBack                 ( 0     ),
    v_DPaint                ( 0     ),
    v_DHit                  ( False ),     { this bar completed a diamond }
    v_DTL                   ( -1    ),
    v_Cnt51                 ( 0     ),
    v_Cnt52                 ( 0     ),
    v_Cnt53                 ( 0     ),
    v_Cnt54                 ( 0     ),
    v_TestDir               ( 0     ),     { 1 up, 2 down }
    v_StartBar              ( 0     ),
    v_LastBar               ( 0     ),
    v_Life                  ( 0     ),
    v_SlopeUp               ( 0     ),
    v_SlopeDn               ( 0     ),
    v_UpLine                ( 0     ),
    v_DnLine                ( 0     ),
    v_S1                    ( 0     ),     { ruling 9.  0-6, no threshold. }
    v_Open                  ( 0     ),     { ruling 13. attribute only. }
    v_M2                    ( 0     ),
    v_Order                 ( 0     ),     { 1 high first, 2 low first }
    v_Sig                   ( 0     ),     { bearish signals emitted so far }
    v_i                     ( 0     ),
    v_j                     ( 0     ),
    v_PendA                 ( -1    ),     { slot awaiting its window-2 verdict }
    v_PendB                 ( -1    ),     { second slot, outside bars only }
    v_k                     ( 0     ),
    v_Push                  ( False ),
    v_TLup                  ( -1    ),     { drawing-object ids for this pattern }
    v_TLdn                  ( -1    ),
    v_RunUp                 ( False ),     { Run_Bars consecutive up closes }
    v_RunDn                 ( False ),
    v_Ymd                   ( 0     ),

    { ruling C break tracking -- record }
    v_s                     ( 0     ),
    v_Free                  ( -1    ),
    v_Floor                 ( 0     ),     { min of the three pivot lows }
    v_Ceil                  ( 0     ),     { max of the three pivot highs }
    v_BkHit                 ( 0     ),     { this bar: 0 none, 1 down, 2 up }
    v_BkHitSq               ( 0     ),     { sequence no. of the formation that broke }
    v_Seq49                 ( 0     ),
    v_Seq50                 ( 0     ),
    v_CntForm               ( 0     ),
    v_CntDn                 ( 0     ),
    v_CntUp                 ( 0     ),
    v_CntExp                ( 0     ),
    v_Overflow              ( 0     ),     { must stay 0.  if it does not, the
                                             three-slot measurement was wrong }
    v_MySeq                 ( 0     ),
    v_LblPx                 ( 0     ),
    v_LblOff                ( 0     ),
    v_Txt                   ( -1    ),

    { ---- 260870.  Pivot_Window scratch, and the three revisit patterns. ---- }
    v_wj                    ( 0     ),     { own loop var: v_k and v_pk are taken }
    v_OkH                   ( False ),
    v_OkL                   ( False ),
    v_a                     ( 0     ),     { first index of the slice under test }
    v_bandLo                ( 0     ),
    v_bandHi                ( 0     ),
    v_Cnt18                 ( 0     ),
    v_Cnt57                 ( 0     ),
    v_Cnt68                 ( 0     ),
    v_Seq18                 ( 0     ),
    v_Seq57                 ( 0     ),
    v_Seq68                 ( 0     ),

    { 260880 -- record }
    v_d0                    ( 0     ),
    v_c                     ( 0     ),
    v_cupLo                 ( 0     ),
    v_cupHi                 ( 0     ),
    v_lead                  ( 0     ),
    v_bump                  ( 0     ),
    v_proj                  ( 0     ),
    v_Cnt28                 ( 0     ),
    v_Cnt64                 ( 0     ),
    v_Cnt55                 ( 0     ),
    v_Seq28                 ( 0     ),
    v_Seq64                 ( 0     ),
    v_Seq55                 ( 0     ),
    v_Dn18                  ( 0     ),
    v_Up18                  ( 0     ),
    v_Ex18                  ( 0     ),
    v_Dn57                  ( 0     ),
    v_Up57                  ( 0     ),
    v_Ex57                  ( 0     ),
    v_Dn68                  ( 0     ),
    v_Up68                  ( 0     ),
    v_Ex68                  ( 0     ),
    v_TL                    ( 0     ),
    v_RevPx                 ( 0     ),

    { 260841 -- record }
    v_AncH                  ( 0     ),
    v_AncL                  ( 0     ),
    v_AncHb                 ( 0     ),
    v_AncLb                 ( 0     ),

    { 260842 diagnostics -- record }
    v_NBars                 ( 0     ),
    v_NPvH                  ( 0     ),
    v_NPvL                  ( 0     ),
    v_FirstYmd              ( 0     ),
    v_FirstTm               ( 0     ),
    v_Yr                    ( 0     ),

    { ---- SECTION 6e working set.  These read the SAME twelve-slot chain the
      diamond and the cup use.  Writing a second chain is what made the
      2026-08-30 census run against the wrong one and cost a whole rebuild,
      so there is no second chain here.  Every window start is computed as
      v_DChain - need, never a hard-coded 0 -- that is the 260881 bug. ---- }
    v_s7w                   ( 0     ),     { window start = v_DChain - need }
    v_s7a                   ( 0     ),     { the five highs, oldest first }
    v_s7b                   ( 0     ),
    v_s7c                   ( 0     ),
    v_s7d                   ( 0     ),
    v_s7e                   ( 0     ),
    v_s7ub                  ( 0     ),     { P65: bars up, bars down }
    v_s7db                  ( 0     ),
    v_s7Ok                  ( False ),
    v_s7Kind                ( 0     ),
    v_s7Col                 ( 0     ),
    v_s7Px                  ( 0     ),
    v_s7Seq                 ( 0     ),
    v_s7Lane                ( 0     ),     { 260893: fixed row per pattern }
    v_s7Unit                ( 0     ),
    v_C15                   ( 0     ),
    v_C26                   ( 0     ),
    v_C32                   ( 0     ),
    v_C56                   ( 0     ),
    v_C59                   ( 0     ),
    v_C65                   ( 0     ),
    v_C72                   ( 0     );

arrays:
    v_PvPx[7]               ( 0     ),
    v_PvBar[7]              ( 0     ),
    v_PvTyp[7]              ( 0     ),     { 1 = high, 2 = low }
    v_PvM7[7]               ( 0     ),
    v_PvW2[7]               ( 0     ),     { 1 if also a window-2 pivot }
    v_PvDt[7]               ( 0     ),     { latched so TL_New needs no lookback }
    v_PvTm[7]               ( 0     ),

    { TWELVE slots since 260880.  P29 peaked at three; P18 adds 6,352
      formations at a nine-bar median life.  v_Overflow is the only
      guard, so the table is widened rather than the estimate trusted. }
    v_BkOn[15]               ( 0     ),     { 1 = slot in use }
    v_BkDn[15]               ( 0     ),     { floor price }
    v_BkUp[15]               ( 0     ),     { ceiling price }
    v_BkSt[15]               ( 0     ),     { first bar the window is live }
    v_BkEnd[15]              ( 0     ),     { last bar the window is live }
    v_BkSeq[15]              ( 0     ),     { sequence no. for the label pair }
    v_Yr52[15]               ( 0     ),     { 260854: P52 per year, to localise
                                             the one-formation disagreement }
    v_BkVar[15]              ( 0     ),     { 260852: which variant owns the slot,
                                             so the tally stays P29-only }

    { 260843 -- record }
    v_YrCnt[9]              ( 0     ),

    { ---- the diamond's own ten-pivot chain.  [11] gives indices 0..11;
      only 0..9 are used, matching the six-chain's [7]-for-6 convention. ---- }
    v_DPx[11]               ( 0     ),
    v_DBar[11]              ( 0     ),
    v_DTyp[11]              ( 0     ),     { 1 = high, 2 = low }
    v_DM7a[11]              ( 0     ),
    v_DDt[11]               ( 0     ),
    v_DTm[11]               ( 0     );

    { ---------- SECTION 1 - SESSION ---------------------------------- }

v_In_Day   = Time >  Sess_Day_Start   and Time <= Sess_Day_End;
v_In_Night = Time >  Sess_Night_Start or  Time <= Sess_Night_End;
v_In_Sess  = v_In_Day or v_In_Night;

v_Sess_First = False;
if CurrentBar > 1 then begin
    if v_In_Day   and ( v_In_Day[1]   = False ) then v_Sess_First = True;
    if v_In_Night and ( v_In_Night[1] = False ) then v_Sess_First = True;
end;

if v_Sess_First then
    v_BIS = 1
else if v_In_Sess then
    v_BIS = v_BIS + 1
else
    v_BIS = 0;

    { SECTION 2 - M7, THE PRIOR-HOUR SLOPE -- record }

v_M7 = 0;
if CurrentBar > M7_Bars then
    v_M7 = ( 6 * Close     + 5 * Close[1]  + 4 * Close[2]
           + 3 * Close[3]  + 2 * Close[4]  + 1 * Close[5]
           - 1 * Close[7]  - 2 * Close[8]  - 3 * Close[9]
           - 4 * Close[10] - 5 * Close[11] - 6 * Close[12] ) / 182;

    { SECTION 2 -- record }

v_RunUp = True;
v_RunDn = True;
if CurrentBar > Run_Bars then begin
    for v_i = 0 to Run_Bars - 1 begin
        if Close[v_i] <= Open[v_i] then v_RunUp = False;
        if Close[v_i] >= Open[v_i] then v_RunDn = False;
    end;
end
else begin
    v_RunUp = False;
    v_RunDn = False;
end;

    { SECTION 3 - FRACTAL PIVOTS -- record }

    { resolve last bar's pending window-2 verdict, BEFORE any push -- record }

if v_PendA >= 0 and v_BIS >= 5 then begin
    if v_PvTyp[v_PendA] = 1 then begin
        if High[2] > High[3] and High[2] > High[4]
           and High[2] > High[1] and High[2] > High then
            v_PvW2[v_PendA] = 1;
    end
    else begin
        if Low[2] < Low[3] and Low[2] < Low[4]
           and Low[2] < Low[1] and Low[2] < Low then
            v_PvW2[v_PendA] = 1;
    end;
end;
if v_PendB >= 0 and v_BIS >= 5 then begin
    if v_PvTyp[v_PendB] = 1 then begin
        if High[2] > High[3] and High[2] > High[4]
           and High[2] > High[1] and High[2] > High then
            v_PvW2[v_PendB] = 1;
    end
    else begin
        if Low[2] < Low[3] and Low[2] < Low[4]
           and Low[2] < Low[1] and Low[2] < Low then
            v_PvW2[v_PendB] = 1;
    end;
end;
v_PendA = -1;
v_PendB = -1;

v_DHit = False;
{ 260870: the window-1 fractal generalised -- record }
v_IsPvH = False;
v_IsPvL = False;
if v_BIS >= 2 * Pivot_Window + 1 then begin
    v_OkH = True;
    v_OkL = True;
    for v_wj = 1 to Pivot_Window begin
        if High[Pivot_Window] <= High[Pivot_Window + v_wj] then
            v_OkH = False;
        if High[Pivot_Window] <= High[Pivot_Window - v_wj] then
            v_OkH = False;
        if Low[Pivot_Window] >= Low[Pivot_Window + v_wj] then
            v_OkL = False;
        if Low[Pivot_Window] >= Low[Pivot_Window - v_wj] then
            v_OkL = False;
    end;
    v_IsPvH = v_OkH;
    v_IsPvL = v_OkL;
end;

{ 260842: count what the chart actually contains, so a shortfall can be
  attributed to the data rather than guessed at. }
v_NBars = v_NBars + 1;
if v_NBars = 1 then begin
    v_FirstYmd = Date + 19000000;
    v_FirstTm  = Time;
end;
if v_IsPvH then
    v_NPvH = v_NPvH + 1;
if v_IsPvL then
    v_NPvL = v_NPvL + 1;

    { SECTIONS 4-6 - PUSH, TEST, ADOPT -- record }

for v_k = 1 to 2 begin

    v_Push = False;
    if v_k = 1 and v_IsPvH then v_Push = True;
    if v_k = 2 and v_IsPvL then v_Push = True;

    if v_Push then begin

        if v_Chain > 0 and v_PvTyp[v_Chain - 1] = v_k then
            v_Chain = 0;

        if v_Chain >= 6 then begin
            { 260842: v_PvDt and v_PvTm were missing from this shift, so -- record }
            for v_j = 0 to 4 begin
                v_PvPx[v_j]  = v_PvPx[v_j + 1];
                v_PvBar[v_j] = v_PvBar[v_j + 1];
                v_PvTyp[v_j] = v_PvTyp[v_j + 1];
                v_PvM7[v_j]  = v_PvM7[v_j + 1];
                v_PvW2[v_j]  = v_PvW2[v_j + 1];
                v_PvDt[v_j]  = v_PvDt[v_j + 1];
                v_PvTm[v_j]  = v_PvTm[v_j + 1];
            end;
            v_Chain = 5;
        end;

        if v_k = 1 then
            v_PvPx[v_Chain] = High[Pivot_Window]
        else
            v_PvPx[v_Chain] = Low[Pivot_Window];
        v_PvBar[v_Chain] = CurrentBar - Pivot_Window;
        v_PvTyp[v_Chain] = v_k;
        v_PvM7[v_Chain]  = v_M7[Pivot_Window];
        v_PvW2[v_Chain]  = 0;
        v_PvDt[v_Chain]  = Date[Pivot_Window];
        v_PvTm[v_Chain]  = Time[Pivot_Window];
        if v_PendA < 0 then
            v_PendA = v_Chain
        else
            v_PendB = v_Chain;
        v_Chain = v_Chain + 1;

        { 260860: the same pivot also feeds the diamond's ten-slot chain -- record }
        if v_DChain > 0 and v_DTyp[v_DChain - 1] = v_k then
            v_DChain = 0;
        if v_DChain >= 12 then begin
            for v_dj = 0 to 10 begin
                v_DPx[v_dj]  = v_DPx[v_dj + 1];
                v_DBar[v_dj] = v_DBar[v_dj + 1];
                v_DTyp[v_dj] = v_DTyp[v_dj + 1];
                v_DM7a[v_dj] = v_DM7a[v_dj + 1];
                v_DDt[v_dj]  = v_DDt[v_dj + 1];
                v_DTm[v_dj]  = v_DTm[v_dj + 1];
            end;
            v_DChain = 11;
        end;
        if v_k = 1 then
            v_DPx[v_DChain] = High[Pivot_Window]
        else
            v_DPx[v_DChain] = Low[Pivot_Window];
        v_DBar[v_DChain] = CurrentBar - Pivot_Window;
        v_DTyp[v_DChain] = v_k;
        v_DM7a[v_DChain] = v_M7[Pivot_Window];
        v_DDt[v_DChain]  = Date[Pivot_Window];
        v_DTm[v_DChain]  = Time[Pivot_Window];
        v_DChain = v_DChain + 1;

        { ---- pattern test, right after this push ---- }

        v_Ok = False;
        if v_Chain >= 6 then begin

            if v_PvTyp[0] = 1 then begin
                v_H1  = v_PvPx[0];
                v_L1  = v_PvPx[1];
                v_H2  = v_PvPx[2];
                v_L2  = v_PvPx[3];
                v_H3  = v_PvPx[4];
                v_L3  = v_PvPx[5];
                v_H1b = v_PvBar[0];
                v_L1b = v_PvBar[1];
                v_H2b = v_PvBar[2];
                v_L2b = v_PvBar[3];
                v_H3b = v_PvBar[4];
                v_L3b = v_PvBar[5];
                v_Order = 1;
            end
            else begin
                v_L1  = v_PvPx[0];
                v_H1  = v_PvPx[1];
                v_L2  = v_PvPx[2];
                v_H2  = v_PvPx[3];
                v_L3  = v_PvPx[4];
                v_H3  = v_PvPx[5];
                v_L1b = v_PvBar[0];
                v_H1b = v_PvBar[1];
                v_L2b = v_PvBar[2];
                v_H2b = v_PvBar[3];
                v_L3b = v_PvBar[4];
                v_H3b = v_PvBar[5];
                v_Order = 2;
            end;

            { classify into the seven variants -- record }
            v_RiseH = ( v_H1 < v_H2 ) and ( v_H2 < v_H3 );
            v_FallH = ( v_H1 > v_H2 ) and ( v_H2 > v_H3 );
            v_FlatH = ( v_H1 = v_H2 ) and ( v_H2 = v_H3 );
            v_RiseL = ( v_L1 < v_L2 ) and ( v_L2 < v_L3 );
            v_FallL = ( v_L1 > v_L2 ) and ( v_L2 > v_L3 );
            v_FlatL = ( v_L1 = v_L2 ) and ( v_L2 = v_L3 );
            v_LowUnder = ( v_L1 < v_H1 ) and ( v_L3 < v_H3 );

            v_Var = 0;
            if v_LowUnder then begin
                if v_RiseH and v_FallL then
                    v_Var = 29
                else if v_RiseH and v_RiseL
                        and ( v_H3 - v_H1 ) > ( v_L3 - v_L1 ) then
                    v_Var = 51
                else if v_FallH and v_FallL
                        and AbsValue( v_L3 - v_L1 ) > AbsValue( v_H3 - v_H1 ) then
                    v_Var = 52
                else if v_FlatH and v_FallL then
                    v_Var = 53
                else if v_RiseH and v_FlatL then
                    v_Var = 54;
            end;

            if v_Var = 29 and Enable_P29 <> 0 then v_Ok = True;
            if v_Var = 51 and Enable_P51 <> 0 then v_Ok = True;
            if v_Var = 52 and Enable_P52 <> 0 then v_Ok = True;
            if v_Var = 53 and Enable_P53 <> 0 then v_Ok = True;
            if v_Var = 54 and Enable_P54 <> 0 then v_Ok = True;
        end;

        { ---- adopt ---- }

        if v_Ok then begin
            v_StartBar = v_PvBar[0];
            v_LastBar  = v_PvBar[5];
            v_Life     = v_LastBar - v_StartBar;

            { ruling 12: M7 is read at the pattern's FIRST pivot }
            { Only P29 splits by M7 -- record }
            if v_Var = 29 then begin
                v_Kind = 50;
                if v_PvM7[0] > 0 then
                    v_Kind = 49;
                v_Cnt29 = v_Cnt29 + 1;
            end
            else begin
                v_Kind = v_Var;
                if v_Var = 51 then
                    v_Cnt51 = v_Cnt51 + 1;
                if v_Var = 52 then begin
                    v_Cnt52 = v_Cnt52 + 1;
                    v_Yr = IntPortion( Date / 10000 ) + 1900 - 2019;
                    if v_Yr >= 0 and v_Yr <= 7 then
                        v_Yr52[v_Yr] = v_Yr52[v_Yr] + 1;
                end;
                if v_Var = 53 then
                    v_Cnt53 = v_Cnt53 + 1;
                if v_Var = 54 then
                    v_Cnt54 = v_Cnt54 + 1;
            end;

            { E1: each line runs through the LAST TWO pivots of its kind }
            v_SlopeUp = 0;
            if v_H3b <> v_H2b then
                v_SlopeUp = ( v_H3 - v_H2 ) / ( v_H3b - v_H2b );
            v_SlopeDn = 0;
            if v_L3b <> v_L2b then
                v_SlopeDn = ( v_L3 - v_L2 ) / ( v_L3b - v_L2b );

            { latch before anything downstream can see a later pivot's values }
            v_AncH  = v_H3;
            v_AncL  = v_L3;
            v_AncHb = v_H3b;
            v_AncLb = v_L3b;

            v_M2   = ( ( v_H3 - v_H1 ) / MaxList( v_H3b - v_H1b, 1 )
                     + ( v_L3 - v_L1 ) / MaxList( v_L3b - v_L1b, 1 ) ) / 2;
            v_Open = v_H3 - v_L3;
            v_S1   = v_PvW2[0] + v_PvW2[1] + v_PvW2[2]
                   + v_PvW2[3] + v_PvW2[4] + v_PvW2[5];

            v_State   = 1;
            v_TestDir = 0;
            v_Sig     = 0;

            { ruling C: claim a break slot, and number this formation -- record }
            { 260852: these four are the P29 ACCEPTANCE instruments and must -- record }
            if v_Var = 29 then begin
                v_CntForm = v_CntForm + 1;
                v_Yr = IntPortion( Date / 10000 ) + 1900 - 2019;
                if v_Yr >= 0 and v_Yr <= 8 then
                    v_YrCnt[v_Yr] = v_YrCnt[v_Yr] + 1;
                if v_Kind = 49 then begin
                    v_Seq49 = v_Seq49 + 1;
                    v_MySeq = v_Seq49;
                end
                else begin
                    v_Seq50 = v_Seq50 + 1;
                    v_MySeq = v_Seq50;
                end;
            end
            else begin
                { each variant numbers itself off the counter the -- record }
                v_MySeq = 0;
                if v_Var = 51 then
                    v_MySeq = v_Cnt51;
                if v_Var = 52 then
                    v_MySeq = v_Cnt52;
                if v_Var = 53 then
                    v_MySeq = v_Cnt53;
                if v_Var = 54 then
                    v_MySeq = v_Cnt54;
            end;

            v_Floor = MinList( v_L1, v_L2, v_L3 );
            v_Ceil  = MaxList( v_H1, v_H2, v_H3 );

            if Break_Mode <> 0 then begin
                v_Free = -1;
                for v_s = 0 to 11 begin
                    if v_Free < 0 and v_BkOn[v_s] = 0 then
                        v_Free = v_s;
                end;
                { measured maximum concurrency is 3, so this should never fire -- record }
                if v_Free < 0 then begin
                    v_Overflow = v_Overflow + 1;
                    v_Free = 0;
                end;
                v_BkOn[v_Free]  = 1;
                v_BkDn[v_Free]  = v_Floor;
                v_BkUp[v_Free]  = v_Ceil;
                v_BkSt[v_Free]  = CurrentBar + 1;
                v_BkEnd[v_Free] = CurrentBar + 1 + v_Life;
                v_BkSeq[v_Free] = v_MySeq;
                v_BkVar[v_Free] = v_Var;
            end;

            { the label -- record }
            if Show_Labels <> 0 then begin
                v_LblOff = ( v_Ceil - v_Floor ) * Label_Offset_Pct / 100;
                { top-shaped variants label above the ceiling, bottom-shaped -- record }
                if v_Kind = 49 or v_Kind = 53 then
                    v_LblPx = v_Ceil + v_LblOff
                else
                    v_LblPx = v_Floor - v_LblOff;
                v_Txt = Text_New( Date, Time, v_LblPx,
                                  "P" + NumToStr( v_Kind, 0 )
                                  + " #" + NumToStr( v_MySeq, 0 ) );
                if v_Txt >= 0 then begin
                    if v_Kind = 49 then
                        Text_SetColor( v_Txt, Col_Shape_Top )
                    else if v_Kind = 50 then
                        Text_SetColor( v_Txt, Col_Shape_Bot )
                    else if v_Kind = 51 then
                        Text_SetColor( v_Txt, Col_Shape_P51 )
                    else if v_Kind = 52 then
                        Text_SetColor( v_Txt, Col_Shape_P52 )
                    else if v_Kind = 53 then
                        Text_SetColor( v_Txt, Col_Shape_P53 )
                    else
                        Text_SetColor( v_Txt, Col_Shape_P54 );
                    Text_SetSize( v_Txt, Label_Size );
                end;
            end;

            { draw the two E1 lines as OBJECTS, not as plots -- record }
            v_TLup = -1;
            v_TLdn = -1;
            if Line_Mode = 1 then begin
                if v_Order = 1 then begin
                    v_TLup = TL_New( v_PvDt[2], v_PvTm[2], v_PvPx[2],
                                     Date, Time, v_AncH + v_SlopeUp * ( CurrentBar - v_AncHb ) );
                    v_TLdn = TL_New( v_PvDt[3], v_PvTm[3], v_PvPx[3],
                                     Date, Time, v_AncL + v_SlopeDn * ( CurrentBar - v_AncLb ) );
                end
                else begin
                    v_TLup = TL_New( v_PvDt[3], v_PvTm[3], v_PvPx[3],
                                     Date, Time, v_AncH + v_SlopeUp * ( CurrentBar - v_AncHb ) );
                    v_TLdn = TL_New( v_PvDt[2], v_PvTm[2], v_PvPx[2],
                                     Date, Time, v_AncL + v_SlopeDn * ( CurrentBar - v_AncLb ) );
                end;
                if v_TLup >= 0 then begin
                    TL_SetColor( v_TLup, Col_Upper );
                    TL_SetSize( v_TLup, Line_Width );
                end;
                if v_TLdn >= 0 then begin
                    TL_SetColor( v_TLdn, Col_Lower );
                    TL_SetSize( v_TLdn, Line_Width );
                end;

                { ---- say exactly what was drawn, and where ---- }
                if Log_Lines <> 0 then begin
                    Print( "P29 TL_NEW up  id=", v_TLup:5:0,
                           "  from ", ( v_PvDt[2] + 19000000 ):8:0, " ", v_PvTm[2]:4:0,
                           " @", v_PvPx[2]:6:0,
                           "   to ", ( Date + 19000000 ):8:0, " ", Time:4:0,
                           " @", ( v_AncH + v_SlopeUp * ( CurrentBar - v_AncHb ) ):6:0,
                           "   order=", v_Order:1:0 );
                    Print( "P29 TL_NEW dn  id=", v_TLdn:5:0,
                           "  from ", ( v_PvDt[3] + 19000000 ):8:0, " ", v_PvTm[3]:4:0,
                           " @", v_PvPx[3]:6:0,
                           "   to ", ( Date + 19000000 ):8:0, " ", Time:4:0,
                           " @", ( v_AncL + v_SlopeDn * ( CurrentBar - v_AncLb ) ):6:0,
                           "   order=", v_Order:1:0 );
                end;
            end;

            if Print_Events <> 0 then begin
                v_Ymd = Date + 19000000;
                Print( "P29 FORM ", v_Ymd:8:0, " ", Time:4:0,
                       "  kind=", v_Kind:2:0, "  order=", v_Order:1:0,
                       "  span=", v_Life:3:0, "  s1=", v_S1:1:0,
                       "  open=", v_Open:5:0, "  m7=", v_PvM7[0]:8:4,
                       "  m2=", v_M2:8:4 );
            end;
        end;

        { 260872: SECTIONS 6b AND 6c BELONG HERE, INSIDE `if v_Push`, -- record }
            { SECTION 6b - P30 / P61 DIAMOND -- record }

        if v_DChain >= 10 then begin
            { 260880: the chain now holds TWELVE, so the diamond
              reads its LAST ten rather than slots 0..9. -- record }
            v_d0 = v_DChain - 10;

            v_DOk = False;
            if v_DTyp[v_d0 + 0] = 1 then begin
                v_DH1 = v_DPx[v_d0 + 0];
                v_DL1 = v_DPx[v_d0 + 1];
                v_DH2 = v_DPx[v_d0 + 2];
                v_DL2 = v_DPx[v_d0 + 3];
                v_DH3 = v_DPx[v_d0 + 4];
                v_DL3 = v_DPx[v_d0 + 5];
                v_DH4 = v_DPx[v_d0 + 6];
                v_DL4 = v_DPx[v_d0 + 7];
                v_DH5 = v_DPx[v_d0 + 8];
                v_DL5 = v_DPx[v_d0 + 9];
                v_DH1d = v_DDt[v_d0 + 0];
                v_DH3d = v_DDt[v_d0 + 4];
                v_DH5d = v_DDt[v_d0 + 8];
                v_DL1d = v_DDt[v_d0 + 1];
                v_DL3d = v_DDt[v_d0 + 5];
                v_DL5d = v_DDt[v_d0 + 9];
                v_DH1t = v_DTm[v_d0 + 0];
                v_DH3t = v_DTm[v_d0 + 4];
                v_DH5t = v_DTm[v_d0 + 8];
                v_DL1t = v_DTm[v_d0 + 1];
                v_DL3t = v_DTm[v_d0 + 5];
                v_DL5t = v_DTm[v_d0 + 9];
                v_DOrder = 1;
            end
            else begin
                v_DL1 = v_DPx[v_d0 + 0];
                v_DH1 = v_DPx[v_d0 + 1];
                v_DL2 = v_DPx[v_d0 + 2];
                v_DH2 = v_DPx[v_d0 + 3];
                v_DL3 = v_DPx[v_d0 + 4];
                v_DH3 = v_DPx[v_d0 + 5];
                v_DL4 = v_DPx[v_d0 + 6];
                v_DH4 = v_DPx[v_d0 + 7];
                v_DL5 = v_DPx[v_d0 + 8];
                v_DH5 = v_DPx[v_d0 + 9];
                v_DL1d = v_DDt[v_d0 + 0];
                v_DL3d = v_DDt[v_d0 + 4];
                v_DL5d = v_DDt[v_d0 + 8];
                v_DH1d = v_DDt[v_d0 + 1];
                v_DH3d = v_DDt[v_d0 + 5];
                v_DH5d = v_DDt[v_d0 + 9];
                v_DL1t = v_DTm[v_d0 + 0];
                v_DL3t = v_DTm[v_d0 + 4];
                v_DL5t = v_DTm[v_d0 + 8];
                v_DH1t = v_DTm[v_d0 + 1];
                v_DH3t = v_DTm[v_d0 + 5];
                v_DH5t = v_DTm[v_d0 + 9];
                v_DOrder = 2;
            end;

            if v_DH1 < v_DH2 and v_DH2 < v_DH3
               and v_DH3 > v_DH4 and v_DH4 > v_DH5
               and v_DL1 > v_DL2 and v_DL2 > v_DL3
               and v_DL3 < v_DL4 and v_DL4 < v_DL5
               and v_DL1 < v_DH1 and v_DL5 < v_DH5 then
                v_DOk = True;

            { ruling 12 again: M7 is read at the pattern's FIRST pivot, so the
              top/bottom split costs no new parameter.
              260881: that pivot is v_d0, NOT slot 0.  The cup work widened
              this chain from 10 slots to 12, so v_d0 = v_DChain - 10 is now
              2 rather than 0 and the split was reading a pivot two positions
              BEFORE the diamond began.  It flipped the only diamond in eight
              years from P61 to P30.  The 260830 handoff predicted exactly
              this failure and put DIA TALLY in the acceptance table to catch
              it; the guardrail worked. }
            if v_DOk then begin
                v_DKind = 61;
                if v_DM7a[v_d0] > 0 then
                    v_DKind = 30;
                if ( v_DKind = 30 and Enable_P30 = 0 )
                   or ( v_DKind = 61 and Enable_P61 = 0 ) then
                    v_DOk = False;
            end;

            if v_DOk then begin
                v_DHit = True;
                if v_DKind = 30 then begin
                    v_Seq30 = v_Seq30 + 1;
                    v_MySeq = v_Seq30;
                end
                else begin
                    v_Seq61 = v_Seq61 + 1;
                    v_MySeq = v_Seq61;
                end;

                { the four edges, as objects -- record }
                if Line_Mode = 1 then begin
                    v_DTL = TL_New( v_DH1d, v_DH1t, v_DH1, v_DH3d, v_DH3t, v_DH3 );
                    if v_DTL >= 0 then begin
                        TL_SetColor( v_DTL, Col_Dia_Line );
                        TL_SetSize( v_DTL, Dia_Line_Width );
                    end;
                    v_DTL = TL_New( v_DH3d, v_DH3t, v_DH3, v_DH5d, v_DH5t, v_DH5 );
                    if v_DTL >= 0 then begin
                        TL_SetColor( v_DTL, Col_Dia_Line );
                        TL_SetSize( v_DTL, Dia_Line_Width );
                    end;
                    v_DTL = TL_New( v_DL1d, v_DL1t, v_DL1, v_DL3d, v_DL3t, v_DL3 );
                    if v_DTL >= 0 then begin
                        TL_SetColor( v_DTL, Col_Dia_Line );
                        TL_SetSize( v_DTL, Dia_Line_Width );
                    end;
                    v_DTL = TL_New( v_DL3d, v_DL3t, v_DL3, v_DL5d, v_DL5t, v_DL5 );
                    if v_DTL >= 0 then begin
                        TL_SetColor( v_DTL, Col_Dia_Line );
                        TL_SetSize( v_DTL, Dia_Line_Width );
                    end;
                end;

                if Show_Labels <> 0 then begin
                    v_LblOff = ( v_DH3 - v_DL3 ) * Label_Offset_Pct / 100;
                    if v_DKind = 30 then
                        v_LblPx = v_DH3 + v_LblOff
                    else
                        v_LblPx = v_DL3 - v_LblOff;
                    v_Txt = Text_New( Date, Time, v_LblPx,
                                      "P" + NumToStr( v_DKind, 0 )
                                      + " #" + NumToStr( v_MySeq, 0 ) );
                    if v_Txt >= 0 then begin
                        { 260861: the label takes the EDGE colour, not the body colour -- record }
                        Text_SetColor( v_Txt, Col_Dia_Line );
                        Text_SetSize( v_Txt, Label_Size );
                    end;
                end;

                if Print_Events <> 0 then begin
                    v_Ymd = Date + 19000000;
                    Print( "DIA FORM ", v_Ymd:8:0, " ", Time:4:0,
                           "  kind=", v_DKind:2:0, "  order=", v_DOrder:1:0,
                           "  span=", ( v_DBar[v_d0 + 9] - v_DBar[v_d0 + 0] ):3:0,
                           "  apexH=", v_DH3:7:0, "  apexL=", v_DL3:7:0 );
                end;
            end;
        end;

            { SECTION 6c - P18 / P57 / P68 -- record }

        v_RevPx = 0;

        if Enable_P68 <> 0 and v_Chain >= 3 then begin
            v_a = v_Chain - 3;
            if v_PvTyp[v_a] = 1 and v_PvPx[v_a] = v_PvPx[v_a + 2] then begin
                v_Cnt68 = v_Cnt68 + 1;
                v_Seq68 = v_Seq68 + 1;

                { ruling C: the break levels are the formation's OWN -- record }
                if Break_Mode <> 0 then begin
                    v_Free = -1;
                    for v_s = 0 to 11 begin
                        if v_Free < 0 and v_BkOn[v_s] = 0 then
                            v_Free = v_s;
                    end;
                    if v_Free < 0 then begin
                        v_Overflow = v_Overflow + 1;
                        v_Free = 0;
                    end;
                    v_BkOn[v_Free]  = 1;
                    v_BkDn[v_Free]  = v_PvPx[v_a + 1];
                    v_BkUp[v_Free]  = MaxList( v_PvPx[v_a], v_PvPx[v_a + 2] );
                    v_BkSt[v_Free]  = CurrentBar + 1;
                    v_BkEnd[v_Free] = CurrentBar + 1 + ( v_PvBar[v_a + 2] - v_PvBar[v_a] );
                    v_BkSeq[v_Free] = v_Seq68;
                    v_BkVar[v_Free] = 68;
                end;
                if Show_Labels <> 0 then begin
                    v_RevPx = High + ( High - Low ) * Label_Offset_Pct / 100;
                    v_Txt = Text_New( Date, Time, v_RevPx,
                                      "P68 #" + NumToStr( v_Seq68, 0 ) );
                    if v_Txt >= 0 then begin
                        Text_SetColor( v_Txt, Col_Revisit );
                        Text_SetSize( v_Txt, Label_Size );
                    end;
                end;
                if Print_Events <> 0 then begin
                    v_Ymd = Date + 19000000;
                    Print( "P68 FORM ", v_Ymd:8:0, " ", Time:4:0,
                           "  px=", v_PvPx[v_a]:7:0,
                           "  span=", ( v_PvBar[v_a + 2] - v_PvBar[v_a] ):3:0 );
                end;
            end;
        end;

        if v_Chain >= 5 then begin
            v_a = v_Chain - 5;
            if v_PvTyp[v_a] = 1 then begin

                { ---- P18 triple top: PH1 and PH2 define the zone, PH3 is tested ---- }
                if Enable_P18 <> 0 then begin
                    v_bandLo = MinList( v_PvPx[v_a], v_PvPx[v_a + 2] );
                    v_bandHi = MaxList( v_PvPx[v_a], v_PvPx[v_a + 2] );
                    if v_PvPx[v_a + 4] >= v_bandLo and v_PvPx[v_a + 4] <= v_bandHi then begin
                        v_Cnt18 = v_Cnt18 + 1;
                        v_Seq18 = v_Seq18 + 1;

                        if Break_Mode <> 0 then begin
                            v_Free = -1;
                            for v_s = 0 to 11 begin
                                if v_Free < 0 and v_BkOn[v_s] = 0 then
                                    v_Free = v_s;
                            end;
                            if v_Free < 0 then begin
                                v_Overflow = v_Overflow + 1;
                                v_Free = 0;
                            end;
                            v_BkOn[v_Free]  = 1;
                            v_BkDn[v_Free]  = MinList( v_PvPx[v_a + 1], v_PvPx[v_a + 3] );
                            v_BkUp[v_Free]  = MaxList( v_PvPx[v_a], v_PvPx[v_a + 2], v_PvPx[v_a + 4] );
                            v_BkSt[v_Free]  = CurrentBar + 1;
                            v_BkEnd[v_Free] = CurrentBar + 1 + ( v_PvBar[v_a + 4] - v_PvBar[v_a] );
                            v_BkSeq[v_Free] = v_Seq18;
                            v_BkVar[v_Free] = 18;
                        end;
                        if Show_Labels <> 0 then begin
                            v_RevPx = v_bandHi + ( v_bandHi - v_bandLo + High - Low )
                                      * Label_Offset_Pct / 100;
                            v_Txt = Text_New( Date, Time, v_RevPx,
                                              "P18 #" + NumToStr( v_Seq18, 0 ) );
                            if v_Txt >= 0 then begin
                                Text_SetColor( v_Txt, Col_Revisit );
                                Text_SetSize( v_Txt, Label_Size );
                            end;
                        end;
                        if Print_Events <> 0 then begin
                            v_Ymd = Date + 19000000;
                            Print( "P18 FORM ", v_Ymd:8:0, " ", Time:4:0,
                                   "  band=", v_bandLo:7:0, "-", v_bandHi:7:0,
                                   "  PH3=", v_PvPx[v_a + 4]:7:0,
                                   "  span=", ( v_PvBar[v_a + 4] - v_PvBar[v_a] ):3:0 );
                        end;
                    end;
                end;

                { ---- P57 measured move down: two legs of exactly equal size ---- }
                if Enable_P57 <> 0 then begin
                    if v_PvPx[v_a + 2] < v_PvPx[v_a]
                       and v_PvPx[v_a + 3] < v_PvPx[v_a + 1]
                       and ( v_PvPx[v_a] - v_PvPx[v_a + 1] )
                         = ( v_PvPx[v_a + 2] - v_PvPx[v_a + 3] ) then begin
                        v_Cnt57 = v_Cnt57 + 1;
                        v_Seq57 = v_Seq57 + 1;

                        if Break_Mode <> 0 then begin
                            v_Free = -1;
                            for v_s = 0 to 11 begin
                                if v_Free < 0 and v_BkOn[v_s] = 0 then
                                    v_Free = v_s;
                            end;
                            if v_Free < 0 then begin
                                v_Overflow = v_Overflow + 1;
                                v_Free = 0;
                            end;
                            v_BkOn[v_Free]  = 1;
                            v_BkDn[v_Free]  = MinList( v_PvPx[v_a + 1], v_PvPx[v_a + 3] );
                            v_BkUp[v_Free]  = MaxList( v_PvPx[v_a], v_PvPx[v_a + 2] );
                            v_BkSt[v_Free]  = CurrentBar + 1;
                            v_BkEnd[v_Free] = CurrentBar + 1 + ( v_PvBar[v_a + 3] - v_PvBar[v_a] );
                            v_BkSeq[v_Free] = v_Seq57;
                            v_BkVar[v_Free] = 57;
                        end;
                        if Show_Labels <> 0 then begin
                            v_RevPx = Low - ( High - Low ) * Label_Offset_Pct / 100;
                            v_Txt = Text_New( Date, Time, v_RevPx,
                                              "P57 #" + NumToStr( v_Seq57, 0 ) );
                            if v_Txt >= 0 then begin
                                Text_SetColor( v_Txt, Col_Revisit );
                                Text_SetSize( v_Txt, Label_Size );
                            end;
                        end;
                        if Print_Events <> 0 then begin
                            v_Ymd = Date + 19000000;
                            Print( "P57 FORM ", v_Ymd:8:0, " ", Time:4:0,
                                   "  leg=", ( v_PvPx[v_a] - v_PvPx[v_a + 1] ):6:0,
                                   "  span=", ( v_PvBar[v_a + 3] - v_PvBar[v_a] ):3:0 );
                        end;
                    end;
                end;

            end;
        end;

            { SECTION 6d - P28 / P64 CUP, P55 BUMP-AND-RUN
              260880, rulings of 2026-08-30.

              All three read the TWELVE-slot chain the diamond feeds, which is
              why that chain was widened rather than a third one added: the
              diamond needs its last ten, the cup all twelve, bump-and-run its
              last seven.

              The cup is drawn as its RIM BAND -- two horizontal lines at the
              rim prices.  That band is the whole reason it is kept: 7
              instances in eight years cannot carry a strategy, but a band is
              a price and a price can be acted on.

              Bump-and-run draws its LEAD-IN LINE, because that line is the
              pattern: two lows fix it, the next leg must be steeper than it,
              and it completes when price falls back below it.  No angle and
              no threshold -- a comparison and a projection, which is what
              SECTION 7 already does to track breaks.                   }

            if Enable_P28 <> 0 and v_DChain >= 12 then begin
                v_c = v_DChain - 12;
                if v_DTyp[v_c] = 1
                   and v_DPx[v_c + 1] > v_DPx[v_c + 3]
                   and v_DPx[v_c + 3] > v_DPx[v_c + 5]
                   and v_DPx[v_c + 5] < v_DPx[v_c + 7]
                   and v_DPx[v_c + 7] < v_DPx[v_c + 9]
                   and ( v_DPx[v_c + 1] - v_DPx[v_c + 3] )
                     > ( v_DPx[v_c + 3] - v_DPx[v_c + 5] )
                   and ( v_DPx[v_c + 7] - v_DPx[v_c + 5] )
                     < ( v_DPx[v_c + 9] - v_DPx[v_c + 7] ) then begin
                    v_cupLo = MinList( v_DPx[v_c], v_DPx[v_c + 10] );
                    v_cupHi = MaxList( v_DPx[v_c], v_DPx[v_c + 10] );
                    if v_DPx[v_c + 11] >= v_cupLo
                       and v_DPx[v_c + 11] <= v_cupHi then begin
                        v_Cnt28 = v_Cnt28 + 1;
                        v_Seq28 = v_Seq28 + 1;
                        if Line_Mode = 1 then begin
                            v_TL = TL_New( v_DDt[v_c], v_DTm[v_c], v_cupLo,
                                           Date, Time, v_cupLo );
                            if v_TL >= 0 then TL_SetColor( v_TL, Col_Cup );
                            v_TL = TL_New( v_DDt[v_c], v_DTm[v_c], v_cupHi,
                                           Date, Time, v_cupHi );
                            if v_TL >= 0 then TL_SetColor( v_TL, Col_Cup );
                        end;
                        if Show_Labels <> 0 then begin
                            v_Txt = Text_New( Date, Time, v_cupHi,
                                              "P28 #" + NumToStr( v_Seq28, 0 ) );
                            if v_Txt >= 0 then begin
                                Text_SetColor( v_Txt, Col_Cup );
                                Text_SetSize( v_Txt, Label_Size );
                            end;
                        end;
                        if Print_Events <> 0 then begin
                            v_Ymd = Date + 19000000;
                            Print( "P28 FORM ", v_Ymd:8:0, " ", Time:4:0,
                                   "  band=", v_cupLo:7:0, "-", v_cupHi:7:0,
                                   "  handle=", v_DPx[v_c + 11]:7:0,
                                   "  span=",
                                   ( v_DBar[v_c + 11] - v_DBar[v_c] ):4:0 );
                        end;
                    end;
                end;
            end;

            if Enable_P64 <> 0 and v_DChain >= 12 then begin
                v_c = v_DChain - 12;
                if v_DTyp[v_c] = 2
                   and v_DPx[v_c + 1] < v_DPx[v_c + 3]
                   and v_DPx[v_c + 3] < v_DPx[v_c + 5]
                   and v_DPx[v_c + 5] > v_DPx[v_c + 7]
                   and v_DPx[v_c + 7] > v_DPx[v_c + 9]
                   and ( v_DPx[v_c + 3] - v_DPx[v_c + 1] )
                     > ( v_DPx[v_c + 5] - v_DPx[v_c + 3] )
                   and ( v_DPx[v_c + 5] - v_DPx[v_c + 7] )
                     < ( v_DPx[v_c + 7] - v_DPx[v_c + 9] ) then begin
                    v_cupLo = MinList( v_DPx[v_c], v_DPx[v_c + 10] );
                    v_cupHi = MaxList( v_DPx[v_c], v_DPx[v_c + 10] );
                    if v_DPx[v_c + 11] >= v_cupLo
                       and v_DPx[v_c + 11] <= v_cupHi then begin
                        v_Cnt64 = v_Cnt64 + 1;
                        v_Seq64 = v_Seq64 + 1;
                        if Line_Mode = 1 then begin
                            v_TL = TL_New( v_DDt[v_c], v_DTm[v_c], v_cupLo,
                                           Date, Time, v_cupLo );
                            if v_TL >= 0 then TL_SetColor( v_TL, Col_Cup );
                            v_TL = TL_New( v_DDt[v_c], v_DTm[v_c], v_cupHi,
                                           Date, Time, v_cupHi );
                            if v_TL >= 0 then TL_SetColor( v_TL, Col_Cup );
                        end;
                        if Show_Labels <> 0 then begin
                            v_Txt = Text_New( Date, Time, v_cupLo,
                                              "P64 #" + NumToStr( v_Seq64, 0 ) );
                            if v_Txt >= 0 then begin
                                Text_SetColor( v_Txt, Col_Cup );
                                Text_SetSize( v_Txt, Label_Size );
                            end;
                        end;
                        if Print_Events <> 0 then begin
                            v_Ymd = Date + 19000000;
                            Print( "P64 FORM ", v_Ymd:8:0, " ", Time:4:0,
                                   "  band=", v_cupLo:7:0, "-", v_cupHi:7:0,
                                   "  handle=", v_DPx[v_c + 11]:7:0,
                                   "  span=",
                                   ( v_DBar[v_c + 11] - v_DBar[v_c] ):4:0 );
                        end;
                    end;
                end;
            end;

            if Enable_P55 <> 0 and v_DChain >= 7 then begin
                v_c = v_DChain - 7;
                if v_DTyp[v_c] = 2
                   and v_DBar[v_c + 2] > v_DBar[v_c]
                   and v_DBar[v_c + 4] > v_DBar[v_c + 2]
                   and v_DBar[v_c + 6] > v_DBar[v_c + 4] then begin
                    v_lead = ( v_DPx[v_c + 2] - v_DPx[v_c] )
                             / ( v_DBar[v_c + 2] - v_DBar[v_c] );
                    v_bump = ( v_DPx[v_c + 4] - v_DPx[v_c + 2] )
                             / ( v_DBar[v_c + 4] - v_DBar[v_c + 2] );
                    v_proj = v_DPx[v_c] + v_lead
                             * ( v_DBar[v_c + 6] - v_DBar[v_c] );
                    if v_lead > 0 and v_bump > v_lead
                       and v_DPx[v_c + 6] < v_proj then begin
                        v_Cnt55 = v_Cnt55 + 1;
                        v_Seq55 = v_Seq55 + 1;
                        if Line_Mode = 1 then begin
                            v_TL = TL_New( v_DDt[v_c], v_DTm[v_c], v_DPx[v_c],
                                           Date, Time, v_proj );
                            if v_TL >= 0 then TL_SetColor( v_TL, Col_Bump );
                        end;
                        if Show_Labels <> 0 then begin
                            v_Txt = Text_New( Date, Time, v_DPx[v_c + 6],
                                              "P55 #" + NumToStr( v_Seq55, 0 ) );
                            if v_Txt >= 0 then begin
                                Text_SetColor( v_Txt, Col_Bump );
                                Text_SetSize( v_Txt, Label_Size );
                            end;
                        end;
                        if Print_Events <> 0 then begin
                            v_Ymd = Date + 19000000;
                            Print( "P55 FORM ", v_Ymd:8:0, " ", Time:4:0,
                                   "  lead=", v_lead:7:3, "  bump=", v_bump:7:3,
                                   "  span=",
                                   ( v_DBar[v_c + 6] - v_DBar[v_c] ):4:0 );
                        end;
                    end;
                end;
            end;

            { ---------- SECTION 6e - THE SEVEN ALREADY-REVIEWED SHAPES -----
              P15 P26 P32 P56 P59 P65 P72.  One window per pattern, taken
              from the END of the shared twelve-slot chain.  Each start is
              v_DChain - need; none is a literal 0, which is the 260881 bug.

              Only ONE of the seven fires per push.  The tests run longest
              window first, so the rarer and more specific shape wins and
              v_s7Ok short-circuits the rest.  That keeps one label per
              formation instead of stacking three on the same bar. ---- }
            v_s7Ok   = False;
            v_s7Kind = 0;

            { P26 rounding top / P32 V reversal -- nine pivots, H first,
              five highs.  Both need rise-then-fall; they differ only in
              which side decelerates, so they cannot both be true. }
            if v_s7Ok = False and v_DChain >= 9 then begin
                v_s7w = v_DChain - 9;
                if v_DTyp[v_s7w] = 1 then begin
                    v_s7a = v_DPx[v_s7w + 0];
                    v_s7b = v_DPx[v_s7w + 2];
                    v_s7c = v_DPx[v_s7w + 4];
                    v_s7d = v_DPx[v_s7w + 6];
                    v_s7e = v_DPx[v_s7w + 8];
                    if v_s7a < v_s7b and v_s7b < v_s7c
                       and v_s7c > v_s7d and v_s7d > v_s7e then begin
                        if ( v_s7b - v_s7a ) > ( v_s7c - v_s7b )
                           and ( v_s7c - v_s7d ) < ( v_s7d - v_s7e ) then begin
                            if Enable_P26 <> 0 then begin
                                v_s7Ok   = True;
                                v_s7Kind = 26;
                            end;
                        end
                        else if ( v_s7b - v_s7a ) < ( v_s7c - v_s7b )
                                and ( v_s7c - v_s7d ) > ( v_s7d - v_s7e ) then begin
                            if Enable_P32 <> 0 then begin
                                v_s7Ok   = True;
                                v_s7Kind = 32;
                            end;
                        end;
                    end;
                end;
            end;

            { P59 descending scallop -- seven pivots, H first.  One completed
              J: the middle low is the trough, the recovery leg is shorter
              than the fall into it, and the far high clears the near one. }
            if v_s7Ok = False and Enable_P59 <> 0 and v_DChain >= 7 then begin
                v_s7w = v_DChain - 7;
                if v_DTyp[v_s7w] = 1 then begin
                    v_s7a = v_DPx[v_s7w + 0];
                    v_s7b = v_DPx[v_s7w + 1];
                    v_s7c = v_DPx[v_s7w + 3];
                    v_s7d = v_DPx[v_s7w + 5];
                    v_s7e = v_DPx[v_s7w + 6];
                    if v_s7b > v_s7c and v_s7c < v_s7d
                       and ( v_s7b - v_s7c ) > ( v_s7d - v_s7c )
                       and v_s7e > v_s7a then begin
                        v_s7Ok   = True;
                        v_s7Kind = 59;
                    end;
                end;
            end;

            { P15 head and shoulders -- five pivots, H first.  The head must
              clear both shoulders.  Shoulder symmetry is NOT required: how
              equal they must be is a tolerance, and a tolerance is a
              parameter.  Measured cost of adding it is in s16s_hs_scan.py. }
            if v_s7Ok = False and Enable_P15 <> 0 and v_DChain >= 5 then begin
                v_s7w = v_DChain - 5;
                if v_DTyp[v_s7w] = 1 then begin
                    if v_DPx[v_s7w] < v_DPx[v_s7w + 2]
                       and v_DPx[v_s7w + 2] > v_DPx[v_s7w + 4] then begin
                        v_s7Ok   = True;
                        v_s7Kind = 15;
                    end;
                end;
            end;

            { P56 dead-cat bounce -- four pivots, H first.  The bounce dies
              inside the band the first two pivots define, then price makes a
              lower low.  Band device, ruling of 2026-08-29: the tolerance is
              the pattern's own high-minus-low, so it costs no parameter. }
            if v_s7Ok = False and Enable_P56 <> 0 and v_DChain >= 4 then begin
                v_s7w = v_DChain - 4;
                if v_DTyp[v_s7w] = 1 then begin
                    v_s7a = v_DPx[v_s7w + 0];
                    v_s7b = v_DPx[v_s7w + 1];
                    v_s7c = v_DPx[v_s7w + 2];
                    v_s7d = v_DPx[v_s7w + 3];
                    if v_s7b < v_s7a
                       and v_s7c >= MinList( v_s7b, v_s7a )
                       and v_s7c <= MaxList( v_s7b, v_s7a )
                       and v_s7d < v_s7b then begin
                        v_s7Ok   = True;
                        v_s7Kind = 56;
                    end;
                end;
            end;

            { P65 tower top -- three pivots, L first.  Up, then down through
              where it started, and the fall takes no more bars than the
              rise.  Bars compared with bars, not a speed threshold. }
            if v_s7Ok = False and Enable_P65 <> 0 and v_DChain >= 3 then begin
                v_s7w = v_DChain - 3;
                if v_DTyp[v_s7w] = 2 then begin
                    v_s7ub = v_DBar[v_s7w + 1] - v_DBar[v_s7w];
                    v_s7db = v_DBar[v_s7w + 2] - v_DBar[v_s7w + 1];
                    if v_DPx[v_s7w + 1] > v_DPx[v_s7w]
                       and v_DPx[v_s7w + 2] < v_DPx[v_s7w]
                       and v_s7db <= v_s7ub then begin
                        v_s7Ok   = True;
                        v_s7Kind = 65;
                    end;
                end;
            end;

            { P72 order block -- three pivots, H first.  A higher high whose
              intervening low sat below the first high: the leg that took out
              the old high began from under it. }
            if v_s7Ok = False and Enable_P72 <> 0 and v_DChain >= 3 then begin
                v_s7w = v_DChain - 3;
                if v_DTyp[v_s7w] = 1 then begin
                    if v_DPx[v_s7w + 2] > v_DPx[v_s7w]
                       and v_DPx[v_s7w + 1] < v_DPx[v_s7w] then begin
                        v_s7Ok   = True;
                        v_s7Kind = 72;
                    end;
                end;
            end;

            { ---- count first, draw second.  The count is the census and is
              never gated on a drawing switch -- that was the 260852 bug. -- }
            if v_s7Ok then begin
                v_s7Col = Col_P72;
                v_s7Seq = 0;
                if v_s7Kind = 15 then begin
                    v_C15   = v_C15 + 1;
                    v_s7Seq  = v_C15;
                    v_s7Col  = Col_P15;
                    v_s7Lane = 3;
                end;
                if v_s7Kind = 26 then begin
                    v_C26   = v_C26 + 1;
                    v_s7Seq  = v_C26;
                    v_s7Col  = Col_P26;
                    v_s7Lane = 6;
                end;
                if v_s7Kind = 32 then begin
                    v_C32   = v_C32 + 1;
                    v_s7Seq  = v_C32;
                    v_s7Col  = Col_P32;
                    v_s7Lane = 5;
                end;
                if v_s7Kind = 56 then begin
                    v_C56   = v_C56 + 1;
                    v_s7Seq  = v_C56;
                    v_s7Col  = Col_P56;
                    v_s7Lane = 2;
                end;
                if v_s7Kind = 59 then begin
                    v_C59   = v_C59 + 1;
                    v_s7Seq  = v_C59;
                    v_s7Col  = Col_P59;
                    v_s7Lane = 4;
                end;
                if v_s7Kind = 65 then begin
                    v_C65   = v_C65 + 1;
                    v_s7Seq  = v_C65;
                    v_s7Col  = Col_P65;
                    v_s7Lane = 1;
                end;
                if v_s7Kind = 72 then begin
                    v_C72   = v_C72 + 1;
                    v_s7Seq  = v_C72;
                    v_s7Col  = Col_P72;
                    v_s7Lane = 0;
                end;

                { 260893: LANES.  The old placement was the last pivot
                  price plus one offset, so two formations a few bars apart
                  printed on top of each other -- and the worst 300-bar
                  window holds 58 of them.  Anchoring to High and stepping by
                  a fixed lane makes every pattern keep its own row: the rows
                  stay level because the unit is a percentage of PRICE, not
                  of each formation's span, which differs.  Ruling of
                  2026-08-31: draw all seven, fix the arrangement. }
                if Show_Labels <> 0 then begin
                    v_s7Unit = Close * Label_Offset_Pct / 10000;
                    v_s7Px   = High + ( v_s7Lane + 1 ) * v_s7Unit;
                    v_Txt  = Text_New( Date, Time, v_s7Px,
                                       "P" + NumToStr( v_s7Kind, 0 )
                                       + " #" + NumToStr( v_s7Seq, 0 ) );
                    if v_Txt >= 0 then begin
                        Text_SetColor( v_Txt, v_s7Col );
                        Text_SetSize( v_Txt, Label_Size );
                    end;
                end;

                if Line_Mode = 1 then begin
                    v_TLup = TL_New( v_DDt[v_s7w], v_DTm[v_s7w],
                                     v_DPx[v_s7w],
                                     v_DDt[v_DChain - 1], v_DTm[v_DChain - 1],
                                     v_DPx[v_DChain - 1] );
                    if v_TLup >= 0 then begin
                        TL_SetColor( v_TLup, v_s7Col );
                        TL_SetSize( v_TLup, 1 );
                    end;
                end;

                if Print_Events <> 0 then begin
                    v_Ymd = Date + 19000000;
                    Print( "SEVEN FORM  P", v_s7Kind:2:0, "  ", v_Ymd:8:0,
                           " ", Time:4:0, "  seq=", v_s7Seq:6:0,
                           "  span=",
                           ( v_DBar[v_DChain - 1] - v_DBar[v_s7w] ):4:0 );
                end;
            end;


    end;


    end;

    { SECTION 7 - LIFECYCLE -- record }

v_UpLine = 0;
v_DnLine = 0;

if v_State = 1 or v_State = 2 then begin

    { 260841: extend from the LATCHED anchors, not the shared ones }
    v_UpLine = v_AncH + v_SlopeUp * ( CurrentBar - v_AncHb );
    v_DnLine = v_AncL + v_SlopeDn * ( CurrentBar - v_AncLb );

    { extend while alive.  Once the pattern dies the object stops growing
      and stays on the chart, so history can be scrolled back and read. }
    if Line_Mode = 1 then begin
        if v_TLup >= 0 then TL_SetEnd( v_TLup, Date, Time, v_UpLine );
        if v_TLdn >= 0 then TL_SetEnd( v_TLdn, Date, Time, v_DnLine );
        { one row per extension -- record }
        if Log_Lines <> 0 then
            Print( "P29 TL_END     up=", v_TLup:5:0, " dn=", v_TLdn:5:0,
                   "  at ", ( Date + 19000000 ):8:0, " ", Time:4:0,
                   "  up@", v_UpLine:6:0, "  dn@", v_DnLine:6:0,
                   "  state=", v_State:1:0 );
    end;

    if CurrentBar - v_LastBar > v_Life then begin
        v_State = 3;
        if Print_Events <> 0 then begin
            v_Ymd = Date + 19000000;
            Print( "P29 EXPIRE ", v_Ymd:8:0, " ", Time:4:0,
                   "  kind=", v_Kind:2:0, "  sigs=", v_Sig:2:0 );
        end;
    end
    else if v_State = 1 then begin

        if Close > v_UpLine then begin
            if v_RunUp then begin
                v_State = 3;
                if Print_Events <> 0 then begin
                    v_Ymd = Date + 19000000;
                    Print( "P29 KILL_RUN3 ", v_Ymd:8:0, " ", Time:4:0,
                           "  kind=", v_Kind:2:0 );
                end;
            end
            else begin
                v_State = 2;
                v_TestDir = 1;
                if Print_Events <> 0 then begin
                    v_Ymd = Date + 19000000;
                    Print( "P29 TEST_UP ", v_Ymd:8:0, " ", Time:4:0,
                           "  kind=", v_Kind:2:0 );
                end;
            end;
        end
        else if Close < v_DnLine then begin
            v_Sig = v_Sig + 1;
            if v_RunDn then begin
                v_State = 3;
                if Print_Events <> 0 then begin
                    v_Ymd = Date + 19000000;
                    Print( "P29 SIG_RUN3 ", v_Ymd:8:0, " ", Time:4:0,
                           "  kind=", v_Kind:2:0, "  n=", v_Sig:2:0 );
                end;
            end
            else begin
                v_State = 2;
                v_TestDir = 2;
                if Print_Events <> 0 then begin
                    v_Ymd = Date + 19000000;
                    Print( "P29 SIG_TEST ", v_Ymd:8:0, " ", Time:4:0,
                           "  kind=", v_Kind:2:0, "  n=", v_Sig:2:0 );
                end;
            end;
        end;
    end
    else begin
        { TESTING.  Only a pivot resolves it -- ruling 14. }
        if v_IsPvH or v_IsPvL then begin
            if ( v_TestDir = 1 and Close <= v_UpLine )
               or ( v_TestDir = 2 and Close >= v_DnLine ) then begin
                v_State = 1;
                v_TestDir = 0;
                if Print_Events <> 0 then begin
                    v_Ymd = Date + 19000000;
                    Print( "P29 FALSE_BREAK ", v_Ymd:8:0, " ", Time:4:0,
                           "  kind=", v_Kind:2:0, "  back to ACTIVE" );
                end;
            end
            else begin
                v_State = 3;
                if Print_Events <> 0 then begin
                    v_Ymd = Date + 19000000;
                    Print( "P29 KILL_PIVOT ", v_Ymd:8:0, " ", Time:4:0,
                           "  kind=", v_Kind:2:0, "  dir=", v_TestDir:1:0 );
                end;
            end;
        end;
    end;
end;

    { SECTION 7b - RULING C BREAK -- record }

v_BkHit   = 0;
v_BkHitSq = 0;

if Break_Mode <> 0 then begin
    for v_s = 0 to 11 begin
        if v_BkOn[v_s] = 1 then begin

            if CurrentBar > v_BkEnd[v_s] then begin
                v_BkOn[v_s] = 0;
                if v_BkVar[v_s] = 29 then
                    v_CntExp = v_CntExp + 1;
                if v_BkVar[v_s] = 18 then v_Ex18 = v_Ex18 + 1;
                if v_BkVar[v_s] = 57 then v_Ex57 = v_Ex57 + 1;
                if v_BkVar[v_s] = 68 then v_Ex68 = v_Ex68 + 1;
                if Print_Events <> 0 then begin
                    v_Ymd = Date + 19000000;
                    Print( "P29 BK_NONE ", v_Ymd:8:0, " ", Time:4:0,
                           "  seq=", v_BkSeq[v_s]:4:0 );
                end;
            end
            else if CurrentBar >= v_BkSt[v_s] then begin

                if Close < v_BkDn[v_s] then begin
                    v_BkOn[v_s] = 0;
                    if v_BkVar[v_s] = 29 then
                        v_CntDn = v_CntDn + 1;
                    if v_BkVar[v_s] = 18 then v_Dn18 = v_Dn18 + 1;
                    if v_BkVar[v_s] = 57 then v_Dn57 = v_Dn57 + 1;
                    if v_BkVar[v_s] = 68 then v_Dn68 = v_Dn68 + 1;
                    if v_BkHit <> 1 then begin
                        v_BkHit   = 1;
                        v_BkHitSq = v_BkSeq[v_s];
                    end;
                    if Print_Events <> 0 then begin
                        v_Ymd = Date + 19000000;
                        Print( "P29 BK_DOWN ", v_Ymd:8:0, " ", Time:4:0,
                               "  seq=", v_BkSeq[v_s]:4:0,
                               "  floor=", v_BkDn[v_s]:6:0,
                               "  close=", Close:6:0 );
                    end;
                end
                else if Close > v_BkUp[v_s] then begin
                    v_BkOn[v_s] = 0;
                    if v_BkVar[v_s] = 29 then
                        v_CntUp = v_CntUp + 1;
                    if v_BkVar[v_s] = 18 then v_Up18 = v_Up18 + 1;
                    if v_BkVar[v_s] = 57 then v_Up57 = v_Up57 + 1;
                    if v_BkVar[v_s] = 68 then v_Up68 = v_Up68 + 1;
                    if v_BkHit = 0 then begin
                        v_BkHit   = 2;
                        v_BkHitSq = v_BkSeq[v_s];
                    end;
                    if Print_Events <> 0 then begin
                        v_Ymd = Date + 19000000;
                        Print( "P29 BK_UP   ", v_Ymd:8:0, " ", Time:4:0,
                               "  seq=", v_BkSeq[v_s]:4:0,
                               "  ceil=", v_BkUp[v_s]:6:0,
                               "  close=", Close:6:0 );
                    end;
                end;

            end;
        end;
    end;

    { ---- the break label, sharing the formation's number so the two can be
      matched by eye.  ASCII only, per CLAUDE.md rule 15 -- no arrows. ---- }
    if Show_Labels <> 0 and v_BkHit <> 0 then begin
        v_LblOff = ( High - Low ) * Label_Offset_Pct / 100;
        if v_BkHit = 1 then
            v_LblPx = Low - v_LblOff
        else
            v_LblPx = High + v_LblOff;
        if v_BkHit = 1 then
            v_Txt = Text_New( Date, Time, v_LblPx,
                              "#" + NumToStr( v_BkHitSq, 0 ) + " DN" )
        else
            v_Txt = Text_New( Date, Time, v_LblPx,
                              "#" + NumToStr( v_BkHitSq, 0 ) + " UP" );
        if v_Txt >= 0 then begin
            if v_BkHit = 1 then
                Text_SetColor( v_Txt, Col_Break )
            else
                Text_SetColor( v_Txt, Col_BreakUp );
            Text_SetSize( v_Txt, Label_Size );
        end;
    end;
end;

    { SECTION 8 - PLOTS -- record }

    { SECTION 8a - PAINT THE PATTERN'S OWN BARS -- record }

{ the pattern's OWN span, painted backwards on the forming bar -- record }

{ 260860: the diamond paints first, and it paints over the P29 -- record }
if Paint_Mode <> 0 and v_DHit then begin
    v_DBack = CurrentBar - v_DBar[0];
    if v_DBack > Paint_MaxBack then
        v_DBack = Paint_MaxBack;
    if v_DKind = 30 then
        v_DPaint = Col_Shape_P30
    else
        v_DPaint = Col_Shape_P61;
    for v_dj = 1 to v_DBack begin
        PlotPaintBar[v_dj]( High[v_dj], Low[v_dj], Open[v_dj], Close[v_dj],
                            "P29", v_DPaint );
    end;
end;

if Paint_Mode <> 0 and v_State = 1 and v_State[1] <> 1 and v_DHit = False then begin
    v_PaintBack = CurrentBar - v_PvBar[0];
    if v_PaintBack > Paint_MaxBack then
        v_PaintBack = Paint_MaxBack;
    { P49 and P50 are the same SHAPE told apart by M7, the trend -- record }
    if v_Kind = 49 then
        v_PaintCol = Col_Shape_Top
    else if v_Kind = 50 then
        v_PaintCol = Col_Shape_Bot
    else if v_Kind = 51 then
        v_PaintCol = Col_Shape_P51
    else if v_Kind = 52 then
        v_PaintCol = Col_Shape_P52
    else if v_Kind = 53 then
        v_PaintCol = Col_Shape_P53
    else
        v_PaintCol = Col_Shape_P54;
    for v_pk = 1 to v_PaintBack begin
        PlotPaintBar[v_pk]( High[v_pk], Low[v_pk], Open[v_pk], Close[v_pk],
                            "P29", v_PaintCol );
    end;
end;

{ ---- forward: while the pattern is still able to act ---- }
{ The break bar outranks the formation body, and reuses the -- record }
if Paint_Mode <> 0 and v_BkHit <> 0 then begin
    if v_BkHit = 1 then
        v_PaintCol = Col_Break
    else
        v_PaintCol = Col_BreakUp;
    PlotPaintBar( High, Low, Open, Close, "P29", v_PaintCol );
end
else if Paint_Mode <> 0 and ( v_State = 1 or v_State = 2 ) then begin
    if v_State = 2 then
        v_PaintCol = Col_Testing
    else
        v_PaintCol = Col_Active;
    PlotPaintBar( High, Low, Open, Close, "P29", v_PaintCol );
end
else begin
    NoPlot( 1 );
    NoPlot( 2 );
    NoPlot( 3 );
    NoPlot( 4 );
end;

SetPlotColor( 5, Col_Upper );
SetPlotColor( 6, Col_Lower );
SetPlotWidth( 5, Line_Width );
SetPlotWidth( 6, Line_Width );

{ Line_Mode 2 keeps the old plots for comparison -- record }
if Line_Mode = 2 and ( v_State = 1 or v_State = 2 ) then begin
    Plot5( v_UpLine, "UpperLine" );
    Plot6( v_DnLine, "LowerLine" );
end
else begin
    NoPlot( 5 );
    NoPlot( 6 );
end;

if Show_Pivots <> 0 and v_IsPvH then
    Plot7[1]( High[1], "PivotHigh" )
else
    NoPlot( 7 );
if Show_Pivots <> 0 and v_IsPvL then
    Plot8[1]( Low[1],  "PivotLow"  )
else
    NoPlot( 8 );

if Show_State <> 0 then
    Plot9( v_State, "State" )
else
    NoPlot( 9 );

if CurrentBar = 1 then Print( "IND_S16S_P29 build ", Build_ID:6:0 );

{ the acceptance test, printed rather than eyeballed -- record }
if LastBarOnChart then begin
    { the reference, measured from scripts/research/s16s_5min -- record }
    Print( "P29 DIAG   bars=", v_NBars:8:0,
           "  first=", v_FirstYmd:8:0, " ", v_FirstTm:4:0,
           "  last=", ( Date + 19000000 ):8:0, " ", Time:4:0 );
    Print( "P29 DIAG   pivot_high=", v_NPvH:7:0,
           "  pivot_low=", v_NPvL:7:0 );
    Print( "P29 DIAG   by_year 2019..2026 = ",
           v_YrCnt[0]:4:0, v_YrCnt[1]:4:0, v_YrCnt[2]:4:0, v_YrCnt[3]:4:0,
           v_YrCnt[4]:4:0, v_YrCnt[5]:4:0, v_YrCnt[6]:4:0, v_YrCnt[7]:4:0 );
    Print( "P29 DIAG   reference       =    8  15  18  31  24  31  42  33" );
    Print( "P29 TALLY  formations=", v_CntForm:5:0,
           "  P49=", v_Seq49:5:0, "  P50=", v_Seq50:5:0 );
    Print( "P29 TALLY  reference     202          112        90" );
    Print( "P29 VARIANT  P29=", v_Cnt29:6:0,
           "  P51=", v_Cnt51:6:0, "  P52=", v_Cnt52:6:0,
           "  P53=", v_Cnt53:5:0, "  P54=", v_Cnt54:5:0 );
    Print( "P52 DIAG   by_year 2019..2026 = ",
           v_Yr52[0]:5:0, v_Yr52[1]:5:0, v_Yr52[2]:5:0, v_Yr52[3]:5:0,
           v_Yr52[4]:5:0, v_Yr52[5]:5:0, v_Yr52[6]:5:0, v_Yr52[7]:5:0 );
    Print( "P52 DIAG   reference          =    94  172  229  267  169  258  302  224" );
    Print( "P29 VARIANT  reference  202    1670    1716      7      8",
           "   (P52 is 1715 if the chart starts 20190102 1340)" );
    Print( "REV TALLY  P18=", v_Cnt18:6:0,
           "  P57=", v_Cnt57:5:0, "  P68=", v_Cnt68:6:0 );
    Print( "REV TALLY  reference  6352          255    1367",
           "   (Pivot_Window = 1)" );
    Print( "PIVOT      window=", Pivot_Window:2:0,
           "  pivot_high=", v_NPvH:7:0, "  pivot_low=", v_NPvL:7:0 );
    Print( "CUP TALLY  P28=", v_Cnt28:5:0, "  P64=", v_Cnt64:5:0,
           "  P55=", v_Cnt55:6:0 );
    Print( "CUP TALLY  reference  P28= 7  P64= 4  P55= 628" );
    Print( "P18 LIFE   dn=", v_Dn18:6:0, "  up=", v_Up18:6:0,
           "  exp=", v_Ex18:6:0, "  sum=", ( v_Dn18 + v_Up18 + v_Ex18 ):6:0,
           "  formations=", v_Cnt18:6:0 );
    Print( "P57 LIFE   dn=", v_Dn57:6:0, "  up=", v_Up57:6:0,
           "  exp=", v_Ex57:6:0, "  sum=", ( v_Dn57 + v_Up57 + v_Ex57 ):6:0,
           "  formations=", v_Cnt57:6:0 );
    Print( "P68 LIFE   dn=", v_Dn68:6:0, "  up=", v_Up68:6:0,
           "  exp=", v_Ex68:6:0, "  sum=", ( v_Dn68 + v_Up68 + v_Ex68 ):6:0,
           "  formations=", v_Cnt68:6:0 );
    Print( "P18 LIFE   sum must equal formations; dn vs up is the verdict" );
    Print( "SEVEN TALLY  P15=", v_C15:6:0, "  P26=", v_C26:4:0,
           "  P32=", v_C32:4:0, "  P56=", v_C56:6:0,
           "  P59=", v_C59:5:0, "  P65=", v_C65:6:0,
           "  P72=", v_C72:6:0 );
    Print( "SEVEN TALLY  reference   5216    60    97    9133    307    3977   18433" );
    Print( "DIA TALLY  P30=", v_Seq30:4:0, "  P61=", v_Seq61:4:0 );
    Print( "DIA TALLY  reference  P30=   0  P61=   1",
           "   (20250908 0955-1150, span 23)" );
    Print( "P29 TALLY  break_down=", v_CntDn:5:0,
           "  break_up=", v_CntUp:5:0,
           "  expired=", v_CntExp:5:0,
           "  slot_overflow=", v_Overflow:5:0 );
end;
