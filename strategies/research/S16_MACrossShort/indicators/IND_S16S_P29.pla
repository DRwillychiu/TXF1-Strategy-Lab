    v_Ok                    ( False ),
    v_H1( 0 ), v_H2( 0 ), v_H3( 0 ),       { pivot high prices, oldest first }
    v_L1( 0 ), v_L2( 0 ), v_L3( 0 ),
    v_H1b( 0 ), v_H2b( 0 ), v_H3b( 0 ),    { their bar numbers }
