{ ==========================================================================
  IND_S16S_P29  --  broadening formation detector (P29 / P49 / P50)

  Build_ID 260826.  DETECTION ONLY.  This file places no orders and holds no
  position.  It exists so the detection can be checked by eye and by diff
  before a single line of it goes near the strategy.

  WHY AN INDICATOR FIRST
    The pattern layer publishes STATE.  The signal layer decides whether to
    trade.  Keeping them in separate files makes the first question -- is the
    implementation correct -- answerable on its own.  Print emits one line per
    event; diff those lines against the 202 patterns that
    scripts/research/s16s_p29_clean.py finds.  Any difference is an
    implementation bug, not a strategy question.

  WHAT IT DETECTS
    P29  six alternating fractal pivots, three highs rising and three lows
         falling, lows under highs, symmetric 3+3
    P49  P29 whose prior hour trended up    -> broadening top,    bearish
    P50  P29 whose prior hour trended down  -> broadening bottom, bullish

  PINNED CONSTANTS -- two, both trading rulings, NEITHER may be swept
    M7_Bars  = 12   one hour of 5-minute bars (ruling 11, 2026-08-26)
    Run_Bars = 3    a run needs three; two is only a pair (ruling 18)

  RULINGS BUILT IN
     1  pivots are plain fractals, no ATR gate
     7  the six pivots must alternate, and lows must sit under highs
    10  the pattern MAY span a session gap; the pivot test may not
    12  M7 is the least-squares slope over 13 closes, not the endpoint diff
    13  opening size is recorded as an attribute, never as a threshold
    14  an ambiguous break waits for the next pivot, not for a fixed N
    18  three same-direction bars at the break is decisive on its own.
        Long bodies were measured and dropped: with a 50 percent body
        requirement only 2 of 44 upward breaks qualified, which makes the
        rule dead code.  Plain red/black fires on 45.5 percent.
    19  a breakdown carries a strength tag: run-of-three, or pivot-confirmed
    20  this file never emits an order

  NO FORWARD REFERENCE
    A pivot at bar i is only known at i+1, so every test reads [1] and [2].
    Nothing reads [0] of a series it is deciding about.

  NO DEEP LOOKBACK
    Pivot prices, bars and M7 are latched into arrays when the pivot forms.
    The pattern test is arithmetic on latched values, so MaxBarsBack only has
    to cover M7's 13 closes, not the pattern's span.
  ========================================================================== }

inputs:
    Build_ID                ( 260826 ),
    M7_Bars                 ( 12    ),     { ruling 11.  PINNED.  Never sweep. }
    Run_Bars                ( 3     ),     { ruling 18.  PINNED.  Never sweep. }
    Sess_Day_Start          ( 845   ),
    Sess_Day_End            ( 1345  ),
    Sess_Night_Start        ( 1500  ),
    Sess_Night_End          ( 500   ),
    Show_Lines              ( 1     ),     { plot the two extended trendlines }
    Print_Events            ( 1     ),     { emit one line per event for diff }
    Show_State              ( 0     );     { 0 = off.  Plot5 shares the price axis. }

variables:
    v_In_Day                ( False ),
    v_In_Night              ( False ),
    v_In_Sess               ( False ),
    v_Sess_First            ( False ),
    v_BIS                   ( 0     ),     { bars in session, 1 on the first }

    v_M7                    ( 0     ),     { least-squares slope, points/bar }

    v_IsPvH                 ( False ),
    v_IsPvL                 ( False ),
    v_Chain                 ( 0     ),     { how many alternating pivots held }

    v_Ok                    ( False ),
    v_H1( 0 ), v_H2( 0 ), v_H3( 0 ),       { pivot high prices, oldest first }
    v_L1( 0 ), v_L2( 0 ), v_L3( 0 ),
    v_H1b( 0 ), v_H2b( 0 ), v_H3b( 0 ),    { their bar numbers }
    v_L1b( 0 ), v_L2b( 0 ), v_L3b( 0 ),

    v_State                 ( 0     ),     { 0 none 1 active 2 testing 3 dead }
    v_Kind                  ( 0     ),     { 49 top, 50 bottom }
    v_TestDir               ( 0     ),     { 1 up, 2 down }
    v_StartBar              ( 0     ),
    v_LastBar               ( 0     ),
    v_Life                  ( 0     ),
    v_SlopeUp               ( 0     ),
    v_SlopeDn               ( 0     ),
    v_UpLine                ( 0     ),
    v_DnLine                ( 0     ),
    v_S1                    ( 0     ),     { ruling 9.  0-6, no threshold. }
    v_Open                  ( 0     ),     { ruling 13. attribute only. }
    v_M2                    ( 0     ),
    v_Order                 ( 0     ),     { 1 high first, 2 low first }
    v_Sig                   ( 0     ),     { bearish signals emitted so far }
    v_i                     ( 0     ),
    v_j                     ( 0     ),
    v_PendA                 ( -1    ),     { slot awaiting its window-2 verdict }
    v_PendB                 ( -1    ),     { second slot, outside bars only }
    v_k                     ( 0     ),
    v_Push                  ( False ),
    v_RunUp                 ( False ),     { Run_Bars consecutive up closes }
    v_RunDn                 ( False ),
    v_Ymd                   ( 0     );

arrays:
    v_PvPx[7]               ( 0     ),
    v_PvBar[7]              ( 0     ),
    v_PvTyp[7]              ( 0     ),     { 1 = high, 2 = low }
    v_PvM7[7]               ( 0     ),
    v_PvW2[7]               ( 0     );     { 1 if also a window-2 pivot }

    { ---------- SECTION 1 - SESSION ---------------------------------- }

v_In_Day   = Time >  Sess_Day_Start   and Time <= Sess_Day_End;
v_In_Night = Time >  Sess_Night_Start or  Time <= Sess_Night_End;
v_In_Sess  = v_In_Day or v_In_Night;

v_Sess_First = False;
if CurrentBar > 1 then begin
    if v_In_Day   and ( v_In_Day[1]   = False ) then v_Sess_First = True;
    if v_In_Night and ( v_In_Night[1] = False ) then v_Sess_First = True;
end;

if v_Sess_First then
    v_BIS = 1
else if v_In_Sess then
    v_BIS = v_BIS + 1
else
    v_BIS = 0;

    { ---------- SECTION 2 - M7, THE PRIOR-HOUR SLOPE ------------------
      Ruling 12.  Least squares over the 13 closes ending on this bar.
      With a fixed window the denominator is a constant: sum of (k-6)^2
      for k = 0..12 is 182.  The mean term cancels because the weights
      sum to zero, so the whole fit collapses to one weighted sum.
      Weight for C[j] is (6 - j).  C[6] therefore drops out entirely.  }

v_M7 = 0;
if CurrentBar > M7_Bars then
    v_M7 = ( 6 * Close     + 5 * Close[1]  + 4 * Close[2]
           + 3 * Close[3]  + 2 * Close[4]  + 1 * Close[5]
           - 1 * Close[7]  - 2 * Close[8]  - 3 * Close[9]
           - 4 * Close[10] - 5 * Close[11] - 6 * Close[12] ) / 182;

    { ---------- SECTION 2.5 - RUNS OF Run_Bars SAME-DIRECTION BARS ----
      Ruling 18.  Read the input rather than hard-coding three, so the
      constant stays visible in the dialog and cannot silently drift out
      of step with the spec.  It is PINNED, not swept.
      Plain red/black only: a 50 percent body requirement was measured and
      dropped -- it fired on 2 of 44 upward breaks, which is dead code. }

v_RunUp = True;
v_RunDn = True;
if CurrentBar > Run_Bars then begin
    for v_i = 0 to Run_Bars - 1 begin
        if Close[v_i] <= Open[v_i] then v_RunUp = False;
        if Close[v_i] >= Open[v_i] then v_RunDn = False;
    end;
end
else begin
    v_RunUp = False;
    v_RunDn = False;
end;

    { ---------- SECTION 3 - FRACTAL PIVOTS ----------------------------
      The pivot sits on bar [1] and is confirmed here on bar [0].
      v_BIS >= 3 guarantees [0], [1] and [2] share one session, which is
      what ruling 10 requires: the pivot test is adjacency-dependent even
      though the pattern it feeds is not.
      A bar can be both a pivot high and a pivot low -- an outside bar.
      The high is pushed first, matching the Python sort order.           }

    { ---- resolve last bar's pending window-2 verdict, BEFORE any push ----
      A window-2 pivot at bar i needs bars i-2..i+2.  The window-1 pivot is
      confirmed at i+1, one bar too early, so the verdict is deferred by one
      bar and written back into the slot the pivot already occupies.
      Resolving before the push keeps the slot index valid: the chain only
      shifts or resets while pushing.
      The first version tested High[2] on the confirming bar, which asks
      whether the bar BEFORE the pivot was a window-2 pivot -- and since
      High[1] > High[2] is the pivot condition itself, High[2] > High[1] is
      false by construction.  S1 came out 0 on every pattern.               }

if v_PendA >= 0 and v_BIS >= 5 then begin
    if v_PvTyp[v_PendA] = 1 then begin
        if High[2] > High[3] and High[2] > High[4]
           and High[2] > High[1] and High[2] > High then
            v_PvW2[v_PendA] = 1;
    end
    else begin
        if Low[2] < Low[3] and Low[2] < Low[4]
           and Low[2] < Low[1] and Low[2] < Low then
            v_PvW2[v_PendA] = 1;
    end;
end;
if v_PendB >= 0 and v_BIS >= 5 then begin
    if v_PvTyp[v_PendB] = 1 then begin
        if High[2] > High[3] and High[2] > High[4]
           and High[2] > High[1] and High[2] > High then
            v_PvW2[v_PendB] = 1;
    end
    else begin
        if Low[2] < Low[3] and Low[2] < Low[4]
           and Low[2] < Low[1] and Low[2] < Low then
            v_PvW2[v_PendB] = 1;
    end;
end;
v_PendA = -1;
v_PendB = -1;

v_IsPvH = False;
v_IsPvL = False;
if v_BIS >= 3 then begin
    if High[1] > High[2] and High[1] > High then v_IsPvH = True;
    if Low[1]  < Low[2]  and Low[1]  < Low  then v_IsPvL = True;
end;

    { ---------- SECTIONS 4-6 - PUSH, TEST, ADOPT ----------------------
      One pass per pivot, NOT one pass per bar.

      An outside bar is both a pivot high and a pivot low.  The first
      version pushed both and then ran the pattern test once, so the
      intermediate chain -- the one ending on the HIGH -- was never tested.
      Python tests every six-window, so it saw those and the indicator did
      not.  The diff caught exactly two misses out of 48, 20250804 0945 and
      20251023 0250, and both sit on an outside bar.

      Wrapping push and test in a two-iteration loop makes the indicator
      test after every push, which is what the reference does.

      A run of same-type pivots cannot sit inside a valid window, so a
      repeat restarts the chain at one -- the surviving windows are exactly
      the alternating runs.                                              }

for v_k = 1 to 2 begin

    v_Push = False;
    if v_k = 1 and v_IsPvH then v_Push = True;
    if v_k = 2 and v_IsPvL then v_Push = True;

    if v_Push then begin

        if v_Chain > 0 and v_PvTyp[v_Chain - 1] = v_k then
            v_Chain = 0;

        if v_Chain >= 6 then begin
            for v_j = 0 to 4 begin
                v_PvPx[v_j]  = v_PvPx[v_j + 1];
                v_PvBar[v_j] = v_PvBar[v_j + 1];
                v_PvTyp[v_j] = v_PvTyp[v_j + 1];
                v_PvM7[v_j]  = v_PvM7[v_j + 1];
                v_PvW2[v_j]  = v_PvW2[v_j + 1];
            end;
            v_Chain = 5;
        end;

        if v_k = 1 then
            v_PvPx[v_Chain] = High[1]
        else
            v_PvPx[v_Chain] = Low[1];
        v_PvBar[v_Chain] = CurrentBar - 1;
        v_PvTyp[v_Chain] = v_k;
        v_PvM7[v_Chain]  = v_M7[1];
        v_PvW2[v_Chain]  = 0;
        if v_PendA < 0 then
            v_PendA = v_Chain
        else
            v_PendB = v_Chain;
        v_Chain = v_Chain + 1;

        { ---- pattern test, right after this push ---- }

        v_Ok = False;
        if v_Chain >= 6 then begin

            if v_PvTyp[0] = 1 then begin
                v_H1  = v_PvPx[0];
                v_L1  = v_PvPx[1];
                v_H2  = v_PvPx[2];
                v_L2  = v_PvPx[3];
                v_H3  = v_PvPx[4];
                v_L3  = v_PvPx[5];
                v_H1b = v_PvBar[0];
                v_L1b = v_PvBar[1];
                v_H2b = v_PvBar[2];
                v_L2b = v_PvBar[3];
                v_H3b = v_PvBar[4];
                v_L3b = v_PvBar[5];
                v_Order = 1;
            end
            else begin
                v_L1  = v_PvPx[0];
                v_H1  = v_PvPx[1];
                v_L2  = v_PvPx[2];
                v_H2  = v_PvPx[3];
                v_L3  = v_PvPx[4];
                v_H3  = v_PvPx[5];
                v_L1b = v_PvBar[0];
                v_H1b = v_PvBar[1];
                v_L2b = v_PvBar[2];
                v_H2b = v_PvBar[3];
                v_L3b = v_PvBar[4];
                v_H3b = v_PvBar[5];
                v_Order = 2;
            end;

            if v_H1 < v_H2 and v_H2 < v_H3
               and v_L1 > v_L2 and v_L2 > v_L3
               and v_L1 < v_H1 and v_L3 < v_H3 then
                v_Ok = True;
        end;

        { ---- adopt ---- }

        if v_Ok then begin
            v_StartBar = v_PvBar[0];
            v_LastBar  = v_PvBar[5];
            v_Life     = v_LastBar - v_StartBar;

            { ruling 12: M7 is read at the pattern's FIRST pivot }
            v_Kind = 50;
            if v_PvM7[0] > 0 then
                v_Kind = 49;

            { E1: each line runs through the LAST TWO pivots of its kind }
            v_SlopeUp = 0;
            if v_H3b <> v_H2b then
                v_SlopeUp = ( v_H3 - v_H2 ) / ( v_H3b - v_H2b );
            v_SlopeDn = 0;
            if v_L3b <> v_L2b then
                v_SlopeDn = ( v_L3 - v_L2 ) / ( v_L3b - v_L2b );

            v_M2   = ( ( v_H3 - v_H1 ) / MaxList( v_H3b - v_H1b, 1 )
                     + ( v_L3 - v_L1 ) / MaxList( v_L3b - v_L1b, 1 ) ) / 2;
            v_Open = v_H3 - v_L3;
            v_S1   = v_PvW2[0] + v_PvW2[1] + v_PvW2[2]
                   + v_PvW2[3] + v_PvW2[4] + v_PvW2[5];

            v_State   = 1;
            v_TestDir = 0;
            v_Sig     = 0;

            if Print_Events <> 0 then begin
                v_Ymd = Date + 19000000;
                Print( "P29 FORM ", v_Ymd:8:0, " ", Time:4:0,
                       "  kind=", v_Kind:2:0, "  order=", v_Order:1:0,
                       "  span=", v_Life:3:0, "  s1=", v_S1:1:0,
                       "  open=", v_Open:5:0, "  m7=", v_PvM7[0]:8:4,
                       "  m2=", v_M2:8:4 );
            end;
        end;
    end;
end;


    { ---------- SECTION 7 - LIFECYCLE ---------------------------------
      Precedence, most terminal first:
        expiry           lifetime equals the bars the pattern took to form
        run of three     decisive on its own, no wait                (r18)
        ambiguous break  hold as TESTING until the next pivot rules   (r14)
      A false break returns the pattern to ACTIVE.  It is never consumed
      by emitting a signal -- that is the signal layer's business.     }

v_UpLine = 0;
v_DnLine = 0;

if v_State = 1 or v_State = 2 then begin

    v_UpLine = v_H3 + v_SlopeUp * ( CurrentBar - v_H3b );
    v_DnLine = v_L3 + v_SlopeDn * ( CurrentBar - v_L3b );

    if CurrentBar - v_LastBar > v_Life then begin
        v_State = 3;
        if Print_Events <> 0 then begin
            v_Ymd = Date + 19000000;
            Print( "P29 EXPIRE ", v_Ymd:8:0, " ", Time:4:0,
                   "  kind=", v_Kind:2:0, "  sigs=", v_Sig:2:0 );
        end;
    end
    else if v_State = 1 then begin

        if Close > v_UpLine then begin
            if v_RunUp then begin
                v_State = 3;
                if Print_Events <> 0 then begin
                    v_Ymd = Date + 19000000;
                    Print( "P29 KILL_RUN3 ", v_Ymd:8:0, " ", Time:4:0,
                           "  kind=", v_Kind:2:0 );
                end;
            end
            else begin
                v_State = 2;
                v_TestDir = 1;
                if Print_Events <> 0 then begin
                    v_Ymd = Date + 19000000;
                    Print( "P29 TEST_UP ", v_Ymd:8:0, " ", Time:4:0,
                           "  kind=", v_Kind:2:0 );
                end;
            end;
        end
        else if Close < v_DnLine then begin
            v_Sig = v_Sig + 1;
            if v_RunDn then begin
                v_State = 3;
                if Print_Events <> 0 then begin
                    v_Ymd = Date + 19000000;
                    Print( "P29 SIG_RUN3 ", v_Ymd:8:0, " ", Time:4:0,
                           "  kind=", v_Kind:2:0, "  n=", v_Sig:2:0 );
                end;
            end
            else begin
                v_State = 2;
                v_TestDir = 2;
                if Print_Events <> 0 then begin
                    v_Ymd = Date + 19000000;
                    Print( "P29 SIG_TEST ", v_Ymd:8:0, " ", Time:4:0,
                           "  kind=", v_Kind:2:0, "  n=", v_Sig:2:0 );
                end;
            end;
        end;
    end
    else begin
        { TESTING.  Only a pivot resolves it -- ruling 14. }
        if v_IsPvH or v_IsPvL then begin
            if ( v_TestDir = 1 and Close <= v_UpLine )
               or ( v_TestDir = 2 and Close >= v_DnLine ) then begin
                v_State = 1;
                v_TestDir = 0;
                if Print_Events <> 0 then begin
                    v_Ymd = Date + 19000000;
                    Print( "P29 FALSE_BREAK ", v_Ymd:8:0, " ", Time:4:0,
                           "  kind=", v_Kind:2:0, "  back to ACTIVE" );
                end;
            end
            else begin
                v_State = 3;
                if Print_Events <> 0 then begin
                    v_Ymd = Date + 19000000;
                    Print( "P29 KILL_PIVOT ", v_Ymd:8:0, " ", Time:4:0,
                           "  kind=", v_Kind:2:0, "  dir=", v_TestDir:1:0 );
                end;
            end;
        end;
    end;
end;

    { ---------- SECTION 8 - PLOTS -------------------------------------
      Lines only while the pattern can still act.  A dead pattern plots
      nothing, so the chart shows exactly what the state machine holds. }

if Show_Lines <> 0 and ( v_State = 1 or v_State = 2 ) then begin
    Plot1( v_UpLine, "UpperLine" );
    Plot2( v_DnLine, "LowerLine" );
end
else begin
    NoPlot( 1 );
    NoPlot( 2 );
end;

if v_IsPvH then Plot3( High[1], "PivotHigh" ) else NoPlot( 3 );
if v_IsPvL then Plot4( Low[1],  "PivotLow"  ) else NoPlot( 4 );

{ State is 0-3 and would drag the price axis down to zero if it shared the
  scale.  Set this plot to its own subgraph in Format Indicator, or leave
  Show_State at 0 -- it is a diagnostic, not part of the picture. }
if Show_State <> 0 then Plot5( v_State, "State" ) else NoPlot( 5 );

if CurrentBar = 1 then Print( "IND_S16S_P29 build ", Build_ID:6:0 );
