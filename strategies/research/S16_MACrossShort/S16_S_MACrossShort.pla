{ ================================================================================
  S16_S - MOVING AVERAGE CROSS SHORT STRATEGY
  Signal Name : S16_S_MACrossShort
  MC Load Name: STRATEGY_GEN_S16_S_MACrossShort
  Version     : v0.2-GA-OPT (2026-07-08 - W4 GA optimized, Candidate E)

  DESIGN PHILOSOPHY:
    Entry wide open, exit knife sharp.
    Whipsaw acceptable if each loss strictly controlled.
    5M timeframe, ZLEMA (Zero-Lag EMA) death cross short entry.
    Golden cross main exit + 4-layer protection (Quick / Multi-Layer / BE / Time).
    NO Regime Filter (user 2026-07-08 ruling Option A: pure simple).
    NO TP (feedback_trend_let_profits_run).

  ARCHITECTURE:
    Data1 = TXF1 5M (execution + signal)

  W0 EVIDENCE (2026-07-08 daily proxy STRONG PASS):
    - 40/216 combos 4/4 institutional gates
    - Best: Fast=12, Slow=30, Fwd_N=3 -> WR 45.8% / RR 1.29 / Stability 57.1%
    - 5M projected default: Fast=8, Slow=25

  EXIT PRIORITY CHAIN (P0 to P7):
    P0 : Rule #11/#12 compliance (Kill / Registry / Holiday / Settlement)
    P1 : M5 Quick Stop (time-based OR loss-based)
    P2 : M6 Multi-Layer 1M monitor (Rule #17, 5 categories 5 factors)
    P3 : M7 Breakeven Trailing (2-tier ATR triggers)
    P4 : Golden Cross (main exit)
    P5 : M8 Time Stop (max holding bars)
    P6 : ATR-based Frozen SL
    P7 : SetStopLoss engine guard (Rule #12 backup)

  RULE COMPLIANCE:
    Rule #11 Settlement_Flat - YES (Priority 0 order)
    Rule #12 SetStopLoss guard - YES (short variant MP >= 0)
    Rule #13 10-dim eval - to run at W5
    Rule #14 OFFICIAL_ROADMAP - YES (S16_S is in Batch 04)
    Rule #15 ASCII 100% - YES (verified via scripts/verify_pla_ascii.py)
    Rule #16 5-pillar - YES (context/rules/verification/memory/format all met)
    Rule #17 Multi-Layer SL - YES (implemented as M6)
    Rule #18 Non-WFA 5 pack - to run at W5

  LABEL CONVENTIONS:
    SE_MA_DeathCross         : Entry (short on death cross)
    SX_MA_GoldenCross        : Main exit (golden cross)
    SX_MA_QuickStop_Time     : P1 M5 time-based quick stop
    SX_MA_QuickStop_Loss     : P1 M5 loss-based quick stop
    SX_MA_ML_Exit            : P2 M6 Multi-Layer trigger
    SX_MA_BE_Trail1          : P3 M7 breakeven tier 1
    SX_MA_BE_Trail2          : P3 M7 breakeven tier 2
    SX_MA_TimeStop           : P5 M8 max holding time
    SX_MA_SL                 : P6 frozen ATR SL
    SX_MA_Kill               : P0 manual kill
    SX_MA_Registry           : P0 registry expired
    SX_MA_Holiday            : P0 holiday block
    SX_MA_Settlement         : P0 settlement flat

  CHART SETUP REQUIRED:
    Data1 = TXF1 5M
    IntrabarOrderGeneration = FALSE
    MaxBarsBack >= 200 (covers all indicator warm-up)
================================================================================ }

[IntrabarOrderGeneration = False]


{ ============================================================
  SECTION 1 - INPUTS
  ============================================================ }
inputs:
    { ===== Group A: Entry (ZLEMA) ===== }
    ZLEMA_Fast              ( 15    ),
    ZLEMA_Slow              ( 50    ),
    MinSlope                ( 16    ),

    { ===== Group B: M5 Quick Stop ===== }
    QuickStop_On            ( True  ),
    QuickStop_MaxBars       ( 4     ),
    QuickStop_MaxLoss_Pts   ( 50    ),

    { ===== Group C: M6 Rule #17 Multi-Layer Monitor ===== }
    ML_On                   ( True  ),
    ML_ActivationPct        ( 20    ),
    ML_ScoreTrigger         ( 65    ),
    ML_MinCategories        ( 3     ),
    ML_VolAvgLen            ( 15    ),
    ML_VolSpikeMult         ( 2.0   ),
    ML_MA_ShortLen          ( 10    ),
    ML_ATR_ShortLen         ( 3     ),
    ML_ATR_LongLen          ( 90    ),
    ML_ATR_Ratio            ( 2.5   ),

    { ===== Group D: M7 Breakeven Trailing ===== }
    BE_On                   ( True  ),
    BE_Trigger_ATR          ( 1.0   ),
    BE_Buffer_Pts           ( 5     ),
    BE_Tier2_ATR            ( 1.5   ),
    BE_Tier2_Buffer_Pts     ( 10    ),

    { ===== Group E: M8 Time Stop ===== }
    M8_On                   ( True  ),
    MaxHoldingBars          ( 144   ),

    { ===== Group F: ATR SL (Frozen) ===== }
    ATR_Len                 ( 14    ),
    StopATRMult             ( 3.5   ),

    { ===== Group H: Rule #11 Compliance ===== }
    Holiday_Flat_Time       ( 415   ),
    Registry_Valid_Until    ( 1280101 ),
    Manual_Kill_Switch      ( False ),
    Settlement_Flat_Time    ( 1230  );


{ ============================================================
  SECTION 2 - VARIABLES
  ============================================================ }
variables:
    { ===== ZLEMA state ===== }
    v_Fast_Lag              ( 0     ),
    v_Slow_Lag              ( 0     ),
    v_ZLEMA_Fast            ( 0     ),
    v_ZLEMA_Slow            ( 0     ),
    v_Slope                 ( 0     ),

    { ===== Signal detection ===== }
    v_Death_Cross           ( False ),
    v_Golden_Cross          ( False ),

    { ===== ATR ===== }
    v_ATR                   ( 0     ),
    v_StopDist              ( 0     ),

    { ===== Trade state ===== }
    v_EntryBar              ( 0     ),
    v_BarsSince             ( 0     ),
    v_Prev_MP               ( 0     ),
    v_Loss                  ( 0     ),
    v_Profit                ( 0     ),

    { ===== Frozen SL (Rule #12) ===== }
    v_SL_Locked             ( False ),
    v_Frozen_ATR            ( 0     ),
    v_Frozen_SL_Dist        ( 0     ),
    v_SL_Level              ( 0     ),

    { ===== M5 Quick Stop state ===== }
    v_QuickStop_Fired       ( False ),

    { ===== M6 Multi-Layer state ===== }
    v_ML_Loss               ( 0     ),
    v_ML_Activation_Level   ( 0     ),
    v_ML_Score              ( 0     ),
    v_ML_Score_Pct          ( 0     ),
    v_ML_CatCount           ( 0     ),
    v_ML_Trigger            ( False ),
    v_ML_Cat_1F             ( 0     ),
    v_ML_Cat_2F             ( 0     ),
    v_ML_Cat_3F             ( 0     ),
    v_ML_Cat_4F             ( 0     ),
    v_ML_Cat_5F             ( 0     ),
    v_ML_AvgVol             ( 0     ),
    v_ML_ATR_Short          ( 0     ),
    v_ML_ATR_Long           ( 0     ),
    v_ML_RSI                ( 0     ),
    v_ML_RSI_Prior          ( 0     ),
    v_ML_MA_Short           ( 0     ),

    { ===== M7 Breakeven state ===== }
    v_BE_Stop_Tier1         ( 0     ),
    v_BE_Stop_Tier2         ( 0     ),

    { ===== Priority 0 protection state ===== }
    v_Holiday_Block         ( False ),
    v_Registry_Expired      ( False ),
    v_Settlement_Day        ( False ),
    ExitFired               ( 0     );


{ ============================================================
  SECTION 3 - PRIORITY 0 COMPLIANCE CHECKS
  (Rule #11 registry + kill + holiday + settlement)
  Simplified stub - full 63-holiday table can be plugged from
  HolidayFlat_v3 pattern used by L1-L5 / S1 / S3_S.
  For W2 draft: hardcode Registry expiry only.
  ============================================================ }

{ Registry expired check (year * 10000 + month * 100 + day format) }
v_Registry_Expired = ( Year(Date) - 1911 ) * 10000
                     + Month(Date) * 100 + DayOfMonth(Date)
                   > Registry_Valid_Until;

{ Settlement day: 3rd Wednesday of month (simplified) }
v_Settlement_Day = ( DayOfWeek(Date) = 3 ) and
                   ( DayOfMonth(Date) >= 15 ) and
                   ( DayOfMonth(Date) <= 21 );

{ Holiday block: placeholder, expand with HolidayFlat_v3 registry }
v_Holiday_Block = False;


{ ============================================================
  SECTION 4 - INDICATORS (ZLEMA)
  ZLEMA formula: EMA(2*Price - Price[lag], N)
  lag = int((N-1) / 2)
  ============================================================ }

v_Fast_Lag = IntPortion( ( ZLEMA_Fast - 1 ) / 2 );
v_Slow_Lag = IntPortion( ( ZLEMA_Slow - 1 ) / 2 );

v_ZLEMA_Fast = XAverage( 2 * Close - Close[v_Fast_Lag], ZLEMA_Fast );
v_ZLEMA_Slow = XAverage( 2 * Close - Close[v_Slow_Lag], ZLEMA_Slow );

v_Slope = AbsValue( v_ZLEMA_Slow - v_ZLEMA_Slow[1] );


{ ============================================================
  SECTION 5 - CROSS DETECTION
  Death cross: Fast crosses BELOW Slow (short entry signal).
  Golden cross: Fast crosses ABOVE Slow (main exit signal).
  ============================================================ }

v_Death_Cross  = v_ZLEMA_Fast[1] >= v_ZLEMA_Slow[1] and
                 v_ZLEMA_Fast    <  v_ZLEMA_Slow;

v_Golden_Cross = v_ZLEMA_Fast[1] <= v_ZLEMA_Slow[1] and
                 v_ZLEMA_Fast    >  v_ZLEMA_Slow;


{ ============================================================
  SECTION 6 - ATR + STOP DISTANCE
  ============================================================ }

v_ATR      = AvgTrueRange( ATR_Len );
v_StopDist = v_ATR * StopATRMult;


{ ============================================================
  SECTION 7 - FROZEN SL SETUP + SetStopLoss (Rule #12)
  Lock SL distance on entry bar. Reset when flat.
  ============================================================ }

if MarketPosition = -1 then begin
    if v_SL_Locked = False then begin
        v_Frozen_ATR     = v_ATR;
        v_Frozen_SL_Dist = v_Frozen_ATR * StopATRMult;
        v_SL_Level       = EntryPrice + v_Frozen_SL_Dist;
        v_SL_Locked      = True;
        v_EntryBar       = CurrentBar;
        v_QuickStop_Fired = False;
    end;
end
else begin
    v_SL_Locked          = False;
    v_Frozen_ATR         = 0;
    v_Frozen_SL_Dist     = 0;
    v_SL_Level           = 0;
    v_EntryBar           = 0;
    v_QuickStop_Fired    = False;
end;

{ Rule #12 SetStopLoss (short variant: MP >= 0 guard) }
if v_SL_Locked = True then
    v_StopDist = v_Frozen_SL_Dist;

if MarketPosition >= 0 then
    SetStopLoss( v_StopDist * BigPointValue );


{ ============================================================
  SECTION 8 - M6 MULTI-LAYER INDICATOR PRECOMPUTE
  5 categories, 1 factor each. Kept lightweight for W2 draft.
  ============================================================ }

v_ML_AvgVol    = Average( Volume, ML_VolAvgLen );
v_ML_ATR_Short = AvgTrueRange( ML_ATR_ShortLen );
v_ML_ATR_Long  = AvgTrueRange( ML_ATR_LongLen );
v_ML_RSI       = RSI( Close, 14 );
v_ML_MA_Short  = Average( Close, ML_MA_ShortLen );


{ ============================================================
  SECTION 9 - ENTRY (Death Cross + M1 Slope + Rule #11 gates)
  ============================================================ }

if MarketPosition = 0 and
   v_Death_Cross         = True and
   v_Slope               > MinSlope and
   v_Settlement_Day      = False and
   v_Holiday_Block       = False and
   v_Registry_Expired    = False and
   Manual_Kill_Switch    = False then begin
    sell short ( "SE_MA_DeathCross" ) next bar at market;
end;


{ ============================================================
  SECTION 10 - EXIT PRIORITY CHAIN (P0 to P7)
  Fires in order. First hit wins per bar (ExitFired flag).
  ============================================================ }

if MarketPosition = -1 then begin

    ExitFired = 0;
    v_BarsSince = CurrentBar - v_EntryBar;
    v_Loss = Close - EntryPrice;       { short: positive = loss }
    v_Profit = EntryPrice - Close;     { short: positive = profit }

    { ---- P0: Priority 0 compliance ---- }
    if Manual_Kill_Switch = True then begin
        buy to cover ( "SX_MA_Kill" ) next bar at market;
        ExitFired = 1;
    end;

    if ExitFired = 0 and v_Registry_Expired = True then begin
        buy to cover ( "SX_MA_Registry" ) next bar at market;
        ExitFired = 1;
    end;

    if ExitFired = 0 and v_Holiday_Block = True and
       Time >= Holiday_Flat_Time then begin
        buy to cover ( "SX_MA_Holiday" ) next bar at market;
        ExitFired = 1;
    end;

    if ExitFired = 0 and v_Settlement_Day = True and
       Time >= Settlement_Flat_Time then begin
        buy to cover ( "SX_MA_Settlement" ) next bar at market;
        ExitFired = 1;
    end;

    { ---- P1: M5 Quick Stop ---- }
    if ExitFired = 0 and QuickStop_On = True and
       v_QuickStop_Fired = False then begin

        { P1a Loss-based (fires first if loss > threshold) }
        if v_Loss > QuickStop_MaxLoss_Pts then begin
            buy to cover ( "SX_MA_QuickStop_Loss" ) next bar at market;
            v_QuickStop_Fired = True;
            ExitFired = 1;
        end;

        { P1b Time-based (N bars with no profit) }
        if ExitFired = 0 and
           v_BarsSince >= QuickStop_MaxBars and
           Close >= EntryPrice then begin
            buy to cover ( "SX_MA_QuickStop_Time" ) next bar at market;
            v_QuickStop_Fired = True;
            ExitFired = 1;
        end;
    end;

    { ---- P2: M6 Rule #17 Multi-Layer 1M Monitor ---- }
    if ExitFired = 0 and ML_On = True then begin

        v_ML_Activation_Level = v_StopDist * ML_ActivationPct / 100;

        if v_Loss > v_ML_Activation_Level then begin

            { Reset all category scores }
            v_ML_Cat_1F = 0;
            v_ML_Cat_2F = 0;
            v_ML_Cat_3F = 0;
            v_ML_Cat_4F = 0;
            v_ML_Cat_5F = 0;

            { 1F K-bar layer: bullish engulfing (adverse for short) }
            if Close > High[1] and Close > Open then
                v_ML_Cat_1F = 1;

            { 2F Vol-price layer: volume spike }
            if Volume > v_ML_AvgVol * ML_VolSpikeMult then
                v_ML_Cat_2F = 1;

            { 3F Momentum layer: RSI reversal from oversold }
            v_ML_RSI_Prior = Lowest( RSI( Close, 14 ), 5 );
            if v_ML_RSI_Prior < 30 and v_ML_RSI > 40 then
                v_ML_Cat_3F = 1;

            { 4F Structure layer: higher low + close above short MA }
            if Low > Low[1] and Close > v_ML_MA_Short then
                v_ML_Cat_4F = 1;

            { 5F Volatility layer: ATR expansion }
            if v_ML_ATR_Long > 0 and
               v_ML_ATR_Short / v_ML_ATR_Long > ML_ATR_Ratio then
                v_ML_Cat_5F = 1;

            { Compute score }
            v_ML_Score    = v_ML_Cat_1F + v_ML_Cat_2F + v_ML_Cat_3F +
                            v_ML_Cat_4F + v_ML_Cat_5F;
            v_ML_Score_Pct = v_ML_Score / 5 * 100;
            v_ML_CatCount = v_ML_Score;   { 1 factor per category = same }

            v_ML_Trigger = v_ML_Score_Pct >= ML_ScoreTrigger and
                           v_ML_CatCount >= ML_MinCategories;

            if v_ML_Trigger = True then begin
                buy to cover ( "SX_MA_ML_Exit" ) next bar at market;
                ExitFired = 1;
            end;
        end;
    end;

    { ---- P3: M7 Breakeven Trailing ---- }
    if ExitFired = 0 and BE_On = True then begin

        { Tier 1: Profit >= 1 ATR -> lock stop at Entry - Buffer_Pts }
        if v_Profit >= BE_Trigger_ATR * v_ATR then begin
            v_BE_Stop_Tier1 = EntryPrice - BE_Buffer_Pts;
            if Close >= v_BE_Stop_Tier1 then begin
                buy to cover ( "SX_MA_BE_Trail1" ) next bar at market;
                ExitFired = 1;
            end;
        end;

        { Tier 2: Profit >= 1.5 ATR -> tighter lock }
        if ExitFired = 0 and v_Profit >= BE_Tier2_ATR * v_ATR then begin
            v_BE_Stop_Tier2 = EntryPrice - BE_Tier2_Buffer_Pts;
            if Close >= v_BE_Stop_Tier2 then begin
                buy to cover ( "SX_MA_BE_Trail2" ) next bar at market;
                ExitFired = 1;
            end;
        end;
    end;

    { ---- P4: Golden Cross main exit ---- }
    if ExitFired = 0 and v_Golden_Cross = True then begin
        buy to cover ( "SX_MA_GoldenCross" ) next bar at market;
        ExitFired = 1;
    end;

    { ---- P5: M8 Time Stop ---- }
    if ExitFired = 0 and M8_On = True and
       v_BarsSince >= MaxHoldingBars then begin
        buy to cover ( "SX_MA_TimeStop" ) next bar at market;
        ExitFired = 1;
    end;

    { ---- P6: ATR-based Frozen SL (last resort) ---- }
    if ExitFired = 0 and v_SL_Locked = True then begin
        buy to cover ( "SX_MA_SL" ) next bar at v_SL_Level Stop;
    end;

    { P7 handled by SetStopLoss in Section 7 }

end;


{ ============================================================
  SECTION 11 - PREV_MP TRACKING (last line, per PL Rule 8)
  ============================================================ }
v_Prev_MP = MarketPosition;
