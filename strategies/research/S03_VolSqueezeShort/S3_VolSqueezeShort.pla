{ ============================================================
  SECTION 5 - HOLIDAY / REGISTRY / SETTLEMENT DETECTION
  Byte-identical to S3_VolSqueezeLong.
  Closed time interval: tail-bar scan bounded by Time < 500 (strict <).
  ============================================================ }

v_Holiday_Block = False;

if Time < 500 then begin
    for hidx = 1 to 80 begin
        if Date = Holiday_Tail[hidx] then
            v_Holiday_Block = True;
    end;
end;

v_Registry_Expired = False;

if Date > Registry_Valid_Until then begin
    v_Registry_Expired = True;
    v_Holiday_Block    = True;
end;

{ Monthly Settlement detection (3rd Wed of month) }
v_Settlement_Day = ( DayOfWeek( Date ) = 3 ) and
                   ( DayOfMonth( Date ) >= 15 ) and
                   ( DayOfMonth( Date ) <= 21 );

{ Registry-expiry red warning, 30 days out }
if LastBarOnChart and
   DateToJulian( Date ) >= DateToJulian( Registry_Valid_Until ) - 30 then begin
    if Registry_Warn_ID < 0 then begin
        Registry_Warn_ID = Text_New( Date, Time, High + 400,
            "HOLIDAY REGISTRY EXPIRES " +
            NumToStr( Registry_Valid_Until, 0 ) +
            " - REBUILD FROM TAIFEX CALENDAR" );
        Text_SetColor( Registry_Warn_ID, Red );
        Text_SetSize( Registry_Warn_ID, 14 );
        Text_SetAttribute( Registry_Warn_ID, 1, True );
    end;
end;


{ ============================================================
  SECTION 6 - BOLLINGER BANDS + SQUEEZE DETECTION
  Byte-identical to S3_VolSqueezeLong - squeeze detection is symmetric.

  BBW = (Upper - Lower) / Mid * 100 (percent of price level)
  BWRank = % of past BWLookback bars where BBW > current BBW
         (low rank = current BBW is historically low = squeeze)
  Squeeze = BWRank <= BWPctile
  ============================================================ }

v_MidBand   = Average( Close, BBLen );
v_UpperBand = v_MidBand + BBStd * StandardDev( Close, BBLen, 1 );
v_LowerBand = v_MidBand - BBStd * StandardDev( Close, BBLen, 1 );

if v_MidBand > 0 then
    v_BandWidth = ( v_UpperBand - v_LowerBand ) / v_MidBand * 100
else
    v_BandWidth = 0;

{ Compute BWRank: count how many past BWLookback bars had wider BBW }
v_BWCount = 0;
for v_i = 1 to BWLookback begin
    if v_BandWidth[v_i] > v_BandWidth then
        v_BWCount = v_BWCount + 1;
end;
if BWLookback > 0 then
    v_BWRank = v_BWCount / BWLookback * 100
else
    v_BWRank = 100;

v_Squeeze = ( v_BWRank <= BWPctile );


{ ============================================================
  SECTION 7 - ATR + STOP / TARGET DISTANCES
  Byte-identical formula to S3_L (multipliers differ per inputs).
  ============================================================ }

v_ATR        = AvgTrueRange( ATR_Len );
v_StopDist   = v_ATR * StopATRMult;
v_TargetDist = v_ATR * TargetATRMult;


{ ============================================================
  SECTION 8 - SAME-DAY COOLDOWN RESET
  v1.0: Cooldown_Days default = 0 (no daily limit per user ruling).
  v1.2 (2026-06-24 BUGFIX): removed redundant "Date <> v_LastExit_Date" predicate.
    Previous version had: Date <> LastExit AND LastExit > 0 AND DateDiff >= Cooldown.
    The Date<>LastExit clause caused contradiction with DateDiff>=0 logic:
      - Cool=0 same day: diff=0 satisfies >=0, but Date==LastExit fails first clause
        => cooldown stuck True, no same-day re-entry possible (contrary to design)
      - Cool=1 same day: diff=0 fails >=1 anyway (correct block)
      - A/B test 2026-06-24 showed Cool=0 == Cool=1 100% identical (185 trades both)
        because the contradiction made cooldown effectively non-functional.
    Fix: pure DateDiff check; Cool=0 -> diff>=0 always True -> reset every bar
         -> same-day re-entry allowed; Cool=1 -> diff>=1 -> only next-day reset.
  Section retained for W3 A/B test (Cooldown_Days = 1 reference variant).
  ============================================================ }

if v_LastExit_Date > 0 and
   DateToJulian( Date ) - DateToJulian( v_LastExit_Date ) >= Cooldown_Days then
    v_Cooldown_Active = False;


{ ============================================================
  SECTION 9 - FROZEN SL SETUP + SetStopLoss (Rule #12, SHORT variant)

  R-6 mirror differences vs S3_L:
    - MarketPosition = -1 (was 1)
    - v_SL_Level = EntryPrice + v_Frozen_SL_Dist (was -)
    - SetStopLoss guard: MP >= 0 (was <= 0)

  Frozen SL: lock ATR + SL level on entry bar (belt-and-suspenders).
  SetStopLoss: MC engine guard, fires on entry bar without IOG dependency.
  Both use same ATR anchor (frozen on entry).
  ============================================================ }

{ Frozen SL setup (locks once per trade on entry bar) }
if MarketPosition = -1 then begin
    if v_SL_Locked = False then begin
        v_Frozen_ATR     = v_ATR;
        v_Frozen_SL_Dist = v_Frozen_ATR * StopATRMult;
        v_SL_Level       = EntryPrice + v_Frozen_SL_Dist;
        v_SL_Locked      = True;
    end;
end
else begin
    v_SL_Locked       = False;
    v_Frozen_ATR      = 0;
    v_Frozen_SL_Dist  = 0;
    v_SL_Level        = 0;
    v_SP_Armed        = False;
    v_Peak_Profit_Pts = 0;
    v_SP_Floor_Price  = 0;
end;

{ SetStopLoss engine guard (shares frozen ATR once locked) }
if v_SL_Locked = True then
    v_StopDist = v_Frozen_SL_Dist;

if MarketPosition >= 0 then
    SetStopLoss( v_StopDist * BigPointValue );


{ ============================================================
  SECTION 10 - ENTRY LOGIC (Short-only per R-6 split)

  R-6 mirror difference vs S3_L:
    - Close < v_LowerBand (was > UpperBand)
    - sell short (was buy)
    - SE_VS_Entry label (was LE_VS_Entry)

  Gates (all must be true):
    - Flat (MP = 0)
    - v_Squeeze = True              (BBW historically compressed)
    - Close < v_LowerBand           (downward breakout confirmation)
    - Not on cooldown
    - Not on a holiday tail bar
    - Not on a settlement day
    - Not registry expired
  ============================================================ }

if ( MarketPosition = 0 ) and
   ( v_Squeeze = True ) and
   ( Close < v_LowerBand ) and
   ( v_Cooldown_Active = False ) and
   ( v_Holiday_Block = False ) and
   ( v_Settlement_Day = False ) and
   ( v_Registry_Expired = False ) then begin
    sell short ( "SE_VS_Entry" ) next bar at Market;
    v_EntryBar = BarNumber;
end;


{ ============================================================
  SECTION 11 - EXIT CHAIN (5-layer architecture v1.1, SHORT variant)

  R-6 mirror differences vs S3_L:
    - MarketPosition = -1 (was 1)
    - All "sell" -> "buy to cover"
    - SX_VS_* labels (was LX_VS_*)
    - TP price = EntryPrice - TargetDist (was +)
    - SL price = EntryPrice + StopDist (was -)
    - Mid trigger: Close > MidBand (was <)

  5-LAYER EXIT (v1.1 upgrade per 2026-06-24 user ruling):
    Layer 0 (P0)  Safety gates (Kill / Registry / Holiday / Settlement)
    Layer 1       Initial SL    SX_VS_SL  (Entry + ATR * StopATRMult, fixed)
    Layer 2       Trailing SP   SX_VS_SP  (NEW v1.1, arm at peak >= ATR * 1.5,
                                          retain 70 pct of peak, irreversible)
    Layer 3       Mid exit      SX_VS_Mid (thesis fail: Close > MidBand after N bars)
    Layer 4       Target TP     SX_VS_TP  (Entry - ATR * TargetATRMult, limit)
    Layer 5       Time stop     SX_VS_TimeStop (BarsHeld >= MaxBars)

  PRIORITY ORDER (per CLAUDE.md Rule #11):
    P0-1  SX_VS_Kill          (Manual_Kill_Switch)
    P0-2  SX_VS_RegistryEnd   (registry expired)
    P0-3  SX_VS_HolFlat       (holiday tail + Holiday_Flat_Time)
    P0-4  SX_VS_Settlement    (settlement day + Settlement_Flat_Time)
    S-1   SX_VS_TP            (limit, always set)
    S-2   SX_VS_Mid           (market, thesis fail)
    S-3   SX_VS_TimeStop      (market, time exit)
    S-4   SX_VS_SP / SX_VS_SL (stop, mutually exclusive - SP when armed, SL otherwise)
  ============================================================ }

ExitFired = 0;

if MarketPosition = -1 then begin

    { ---- P0-1 Manual kill switch ---- }
    if ( ExitFired = 0 ) and ( Manual_Kill_Switch = True ) then begin
        buy to cover ( "SX_VS_Kill" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- P0-2 Registry fail-safe ---- }
    if ( ExitFired = 0 ) and ( v_Registry_Expired = True ) then begin
        buy to cover ( "SX_VS_RegistryEnd" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- P0-3 Holiday iron rule (state-guarded + closed interval) ---- }
    if ( ExitFired = 0 ) and
       ( v_Holiday_Block = True ) and
       ( Time >= Holiday_Flat_Time ) and
       ( Time <= 455 ) then begin
        buy to cover ( "SX_VS_HolFlat" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- P0-4 Settlement flat (state-guarded) ---- }
    if ( ExitFired = 0 ) and
       ( v_Settlement_Day = True ) and
       ( Time >= Settlement_Flat_Time ) then begin
        buy to cover ( "SX_VS_Settlement" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- Layer 2 SP tracking (v1.1 NEW): peak profit + arm + floor ---- }
    { Peak profit for short = max(EntryPrice - Low) over hold }
    if EntryPrice - Low > v_Peak_Profit_Pts then
        v_Peak_Profit_Pts = EntryPrice - Low;

    { Arm SP once peak crosses threshold (irreversible per design) }
    if ( v_SP_Armed = False ) and
       ( v_Peak_Profit_Pts >= v_ATR * SP_Trigger_ATRMult ) then
        v_SP_Armed = True;

    { Compute SP floor price (retain N pct of peak profit) }
    if v_SP_Armed = True then
        v_SP_Floor_Price = EntryPrice - ( v_Peak_Profit_Pts * SP_Retain_Pct / 100 );

    { ---- Strategy exits ---- }
    if ExitFired = 0 then begin

        { S-1: TP at ATR x TargetMult (limit, favorable to short = lower price) }
        buy to cover ( "SX_VS_TP" ) next bar at EntryPrice - v_TargetDist limit;

        { S-2: Mid-band exit (thesis fail, market) }
        if UseMidExit = True and
           BarNumber - v_EntryBar >= MidExit_MinBars and
           Close > v_MidBand then begin
            buy to cover ( "SX_VS_Mid" ) next bar at Market;
            ExitFired = 1;
        end;

        { S-3: Time stop }
        if ExitFired = 0 and
           BarNumber - v_EntryBar >= MaxBars then begin
            buy to cover ( "SX_VS_TimeStop" ) next bar at Market;
            ExitFired = 1;
        end;

        { S-4: SP / SL stop (mutually exclusive per Layer 2 design)
          - SP_Armed=True  : trailing stop at v_SP_Floor_Price (label SX_VS_SP)
          - SP_Armed=False : initial stop at v_SL_Level (label SX_VS_SL, fallback)
          Belt+suspenders with Section 9 SetStopLoss engine guard. }
        if ExitFired = 0 then begin
            if v_SP_Armed = True then
                buy to cover ( "SX_VS_SP" ) next bar at v_SP_Floor_Price Stop
            else if v_SL_Locked = True then
                buy to cover ( "SX_VS_SL" ) next bar at v_SL_Level Stop;
        end;

    end;

end;


{ ============================================================
  SECTION 12 - COOLDOWN SET ON EXIT
  R-6 mirror difference: v_Prev_MP = -1 (was 1)
  ============================================================ }

if v_Prev_MP = -1 and MarketPosition <> -1 then begin
    v_Cooldown_Active = True;
    v_LastExit_Date   = Date;
end;


{ ============================================================
  SECTION 13 - PREV_MP TRACKING (last line, per Rule #8)
  ============================================================ }

v_Prev_MP = MarketPosition;
