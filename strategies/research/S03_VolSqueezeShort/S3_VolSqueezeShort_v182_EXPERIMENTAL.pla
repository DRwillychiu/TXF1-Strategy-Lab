    Holiday_Tail[55] = 1260227;
    Holiday_Tail[56] = 1260403;
    Holiday_Tail[57] = 1260501;
    Holiday_Tail[58] = 1260619;
    Holiday_Tail[59] = 1260925;
    Holiday_Tail[60] = 1261009;
    Holiday_Tail[61] = 1261024;
    Holiday_Tail[62] = 1261225;
    Holiday_Tail[63] = 1270101;

    { 2027 CNY onward: rebuild from TAIFEX 116-yr calendar in Q4 2026 }
end;


{ ============================================================
  SECTION 5 - HOLIDAY / REGISTRY / SETTLEMENT DETECTION
  Byte-identical to S3_VolSqueezeLong.
  Closed time interval: tail-bar scan bounded by Time < 500 (strict <).
  ============================================================ }

v_Holiday_Block = False;

if Time < 500 then begin
    for hidx = 1 to 80 begin
        if Date = Holiday_Tail[hidx] then
            v_Holiday_Block = True;
    end;
end;

v_Registry_Expired = False;

if Date > Registry_Valid_Until then begin
    v_Registry_Expired = True;
    v_Holiday_Block    = True;
end;

{ Monthly Settlement detection (3rd Wed of month) }
v_Settlement_Day = ( DayOfWeek( Date ) = 3 ) and
                   ( DayOfMonth( Date ) >= 15 ) and
                   ( DayOfMonth( Date ) <= 21 );

{ Registry-expiry red warning, 30 days out }
if LastBarOnChart and
   DateToJulian( Date ) >= DateToJulian( Registry_Valid_Until ) - 30 then begin
    if Registry_Warn_ID < 0 then begin
        Registry_Warn_ID = Text_New( Date, Time, High + 400,
            "HOLIDAY REGISTRY EXPIRES " +
            NumToStr( Registry_Valid_Until, 0 ) +
            " - REBUILD FROM TAIFEX CALENDAR" );
        Text_SetColor( Registry_Warn_ID, Red );
        Text_SetSize( Registry_Warn_ID, 14 );
        Text_SetAttribute( Registry_Warn_ID, 1, True );
    end;
end;


{ ============================================================
  SECTION 5.5 - REGIME FILTER (v1.7 NEW, MA reduced in v1.7.1)
  Read Daily FastMA/SlowMA ratio from Data2, classify regime.
  v1.7.1: changed from MA50/MA200 to MA20/MA50 (default).
          Reason: Daily Data2 only has ~1540 bars (6.4yr backtest),
          MA200 + 19:1 ratio = ~3800 60M MaxBarsBack req, impossible.
          MA50 = ~950 60M req, MaxBarsBack=1000 fits comfortably.
  Band-reject filter (v1.7.3): start allow-all, then block specific zones.
    1. If Regime_BlockRange = True, block 0.98 <= ratio <= 1.02 (PF 0.73, -259K)
    2. If Regime_BlockWeakBull = True, block 1.02 < ratio < 1.05 (PF 1.61)
  Effective: allow Bear (<0.98, PF 11.0) + Strong Bull (>1.05, PF 4.49)

  IMPORTANT: REQUIRES Data2 = TXF1 Daily on chart.
             MaxBarsBack should be set to 1000 (cover Daily MA50 * 19 ratio).
             [1] index = last closed daily bar (avoid look-ahead).
  ============================================================ }

if Use_Regime_Filter = True then begin
    v_MA_Fast_D = ( Average( Close, Regime_FastMA ) of Data2 )[1];
    v_MA_Slow_D = ( Average( Close, Regime_SlowMA ) of Data2 )[1];

    if v_MA_Slow_D > 0 then
        v_Regime_Ratio = v_MA_Fast_D / v_MA_Slow_D
    else
        v_Regime_Ratio = 1;

    v_In_WeakBull_Zone = ( v_Regime_Ratio > 1.02 ) and ( v_Regime_Ratio < 1.05 );
    v_In_Range_Zone = ( v_Regime_Ratio >= 0.98 ) and ( v_Regime_Ratio <= 1.02 );

    v_Regime_OK = True;

    if Regime_BlockRange = True and v_In_Range_Zone = True then
        v_Regime_OK = False;

    if Regime_BlockWeakBull = True and v_In_WeakBull_Zone = True then
        v_Regime_OK = False;
end
else
    v_Regime_OK = True;


{ ============================================================
  SECTION 6 - BOLLINGER BANDS + SQUEEZE DETECTION
  Byte-identical to S3_VolSqueezeLong - squeeze detection is symmetric.

  BBW = (Upper - Lower) / Mid * 100 (percent of price level)
  BWRank = % of past BWLookback bars where BBW > current BBW
         (low rank = current BBW is historically low = squeeze)
  Squeeze = BWRank <= BWPctile
  ============================================================ }

v_MidBand   = Average( Close, BBLen );
v_UpperBand = v_MidBand + BBStd * StandardDev( Close, BBLen, 1 );
v_LowerBand = v_MidBand - BBStd * StandardDev( Close, BBLen, 1 );

if v_MidBand > 0 then
    v_BandWidth = ( v_UpperBand - v_LowerBand ) / v_MidBand * 100
else
    v_BandWidth = 0;

{ Compute BWRank: count how many past BWLookback bars had wider BBW }
v_BWCount = 0;
for v_i = 1 to BWLookback begin
    if v_BandWidth[v_i] > v_BandWidth then
        v_BWCount = v_BWCount + 1;
end;
if BWLookback > 0 then
    v_BWRank = v_BWCount / BWLookback * 100
else
    v_BWRank = 100;

v_Squeeze = ( v_BWRank <= BWPctile );


{ ============================================================
  SECTION 7 - ATR + STOP / TARGET DISTANCES
  Byte-identical formula to S3_L (multipliers differ per inputs).
  ============================================================ }

v_ATR        = AvgTrueRange( ATR_Len );
v_StopDist   = v_ATR * StopATRMult;
v_TargetDist = v_ATR * TargetATRMult;


{ ============================================================
  SECTION 8 - SAME-DAY COOLDOWN RESET
  v1.0: Cooldown_Days default = 0 (no daily limit per user ruling).
  v1.2 (2026-06-24 BUGFIX): removed redundant "Date <> v_LastExit_Date" predicate.
    Previous version had: Date <> LastExit AND LastExit > 0 AND DateDiff >= Cooldown.
    The Date<>LastExit clause caused contradiction with DateDiff>=0 logic:
      - Cool=0 same day: diff=0 satisfies >=0, but Date==LastExit fails first clause
        => cooldown stuck True, no same-day re-entry possible (contrary to design)
      - Cool=1 same day: diff=0 fails >=1 anyway (correct block)
      - A/B test 2026-06-24 showed Cool=0 == Cool=1 100% identical (185 trades both)
        because the contradiction made cooldown effectively non-functional.
    Fix: pure DateDiff check; Cool=0 -> diff>=0 always True -> reset every bar
         -> same-day re-entry allowed; Cool=1 -> diff>=1 -> only next-day reset.
  Section retained for W3 A/B test (Cooldown_Days = 1 reference variant).
  ============================================================ }

if v_LastExit_Date > 0 and
   DateToJulian( Date ) - DateToJulian( v_LastExit_Date ) >= Cooldown_Days then
    v_Cooldown_Active = False;


{ ============================================================
  SECTION 9 - FROZEN SL SETUP + SetStopLoss (Rule #12, SHORT variant)

  R-6 mirror differences vs S3_L:
    - MarketPosition = -1 (was 1)
    - v_SL_Level = EntryPrice + v_Frozen_SL_Dist (was -)
    - SetStopLoss guard: MP >= 0 (was <= 0)

  Frozen SL: lock ATR + SL level on entry bar (belt-and-suspenders).
  SetStopLoss: MC engine guard, fires on entry bar without IOG dependency.
  Both use same ATR anchor (frozen on entry).
  ============================================================ }

{ Frozen SL setup (locks once per trade on entry bar) }
if MarketPosition = -1 then begin
    if v_SL_Locked = False then begin
        v_Frozen_ATR     = v_ATR;
        v_Frozen_SL_Dist = v_Frozen_ATR * StopATRMult;
        v_SL_Level       = EntryPrice + v_Frozen_SL_Dist;
        v_SL_Locked      = True;
    end;
end
else begin
    v_SL_Locked       = False;
    v_Frozen_ATR      = 0;
    v_Frozen_SL_Dist  = 0;
    v_SL_Level        = 0;
    v_SP_Armed        = False;
    v_Peak_Profit_Pts = 0;
    v_SP_Floor_Price  = 0;
end;

{ SetStopLoss engine guard (shares frozen ATR once locked) }
if v_SL_Locked = True then
    v_StopDist = v_Frozen_SL_Dist;

if MarketPosition >= 0 then
    SetStopLoss( v_StopDist * BigPointValue );


{ ============================================================
  SECTION 9.5 - 1M MULTI-LAYER EXIT MONITORING (v1.8.0 NEW)

  Multi-TF preemptive exit: monitors Data3 (1M) for adverse
  upward momentum signals while in short position.

  Architecture per SOP extreme_sl_multilayer_sop_20260629.md:
    Foundation = 60M ATR SL (Section 9, unchanged)
    1F = K-bar patterns  (A1 vol+shadow, A2 engulfing, A4 consec, A6 expanding)
    2F = Volume-price     (B1 spike+up, B2 rising vol+price)
    3F = Momentum speed   (C1 acceleration, C2 speed threshold)
    4F = Structure break   (D2 gap up, D3 break entry)
    5F = Vol environment   (E3 regime shift)

  3-Gate trigger:
    Gate 1: Unrealized loss > ML_ActivationPct % of frozen SL dist
    Gate 2: Score >= ML_ScoreTrigger % (of max 30 pts)
    Gate 3: Categories >= ML_MinCategories (of 5 categories)

  IOG evaluates this section every Data3 (1M) bar close.
  Preemptive market exit fires BEFORE ATR SL level to avoid cascade.
  ============================================================ }

if MarketPosition = -1 and v_1M_ExitFired = False then begin

    { --- Reset all factor scores --- }
    v_Score_A1 = 0;
    v_Score_A2 = 0;
    v_Score_A4 = 0;
    v_Score_A6 = 0;
    v_Score_B1 = 0;
    v_Score_B2 = 0;
    v_Score_C1 = 0;
    v_Score_C2 = 0;
    v_Score_D2 = 0;
    v_Score_D3 = 0;
    v_Score_E3 = 0;
    v_1M_Trigger = False;

    { --- Gate 1: Activation threshold --- }
    v_1M_Loss = Close of Data3 - EntryPrice;
    v_1M_Gate1 = ( v_Frozen_SL_Dist > 0 ) and
                 ( v_1M_Loss > v_Frozen_SL_Dist * ML_ActivationPct / 100 );

    if v_1M_Gate1 = True then begin

        { --- 1M helper calculations --- }
        v_1M_AvgVol = Average( Volume, ML_VolAvgLen ) of Data3;
        v_1M_Body = AbsValue( Close of Data3 - Open of Data3 );
        v_1M_LowerShadow = MinList( Close of Data3, Open of Data3 )
                         - Low of Data3;

        { === 1F: K-bar Patterns === }

        { A1: Volume + Long Lower Shadow (3 pts) }
        if Close of Data3 > Open of Data3 and
           v_1M_Body > 0 and
           v_1M_LowerShadow > 2 * v_1M_Body and
           v_1M_AvgVol > 0 and
           Volume of Data3 > ML_VolSpikeMult * v_1M_AvgVol then
            v_Score_A1 = 3;

        { A2: Bullish Engulfing (3 pts) }
        if Close of Data3 > Open of Data3 and
           Close[1] of Data3 < Open[1] of Data3 and
           Close of Data3 > Open[1] of Data3 and
           Open of Data3 < Close[1] of Data3 then
            v_Score_A2 = 3;

        { A4: Consecutive Bullish Bars (2 pts) }
        v_1M_ConsecUp = 0;
        if Close of Data3 > Close[1] of Data3 then begin
            v_1M_ConsecUp = 1;
            if Close[1] of Data3 > Close[2] of Data3 then begin
                v_1M_ConsecUp = 2;
                if Close[2] of Data3 > Close[3] of Data3 then
                    v_1M_ConsecUp = 3;
            end;
        end;
        if v_1M_ConsecUp >= 2 then
            v_Score_A4 = 2;

        { A6: Expanding Bullish Bars (3 pts) }
        v_1M_Body0 = AbsValue( Close of Data3 - Open of Data3 );
        v_1M_Body1 = AbsValue( Close[1] of Data3 - Open[1] of Data3 );
        v_1M_Body2 = AbsValue( Close[2] of Data3 - Open[2] of Data3 );
        if Close of Data3 > Open of Data3 and
           Close[1] of Data3 > Open[1] of Data3 and
           Close[2] of Data3 > Open[2] of Data3 and
           v_1M_Body0 > v_1M_Body1 and
           v_1M_Body1 > v_1M_Body2 and
           v_1M_Body2 > 0 then
            v_Score_A6 = 3;

        { === 2F: Volume-Price === }

        { B1: Sudden Volume Spike + Up (3 pts) }
        if v_1M_AvgVol > 0 and
           Volume of Data3 > ML_VolSpikeMult * v_1M_AvgVol and
           Close of Data3 > Open of Data3 then
            v_Score_B1 = 3;

        { B2: Rising Volume + Rising Price, 3 bars (3 pts) }
        if Volume of Data3 > Volume[1] of Data3 and
           Close of Data3 > Close[1] of Data3 and
           Volume[1] of Data3 > Volume[2] of Data3 and
           Close[1] of Data3 > Close[2] of Data3 then
            v_Score_B2 = 3;

        { === 3F: Momentum Speed === }

        { C1: Price Acceleration (3 pts) }
        v_1M_SpeedBarsP1 = ML_SpeedBars + 1;
        v_1M_Speed_Cur = Close of Data3 - Close[ML_SpeedBars] of Data3;
        v_1M_Speed_Prev = Close[1] of Data3
                        - Close[v_1M_SpeedBarsP1] of Data3;
        if v_1M_Speed_Cur > v_1M_Speed_Prev and
           v_1M_Speed_Cur > 0 then
            v_Score_C1 = 3;

        { C2: Speed Threshold (3 pts) }
        if Close of Data3 - Close[ML_SpeedBars] of Data3
           > ML_SpeedThreshPts then
            v_Score_C2 = 3;

        { === 4F: Structure Break === }

        { D2: 1M Gap Up (2 pts) }
        if Open of Data3 > High[1] of Data3 then
            v_Score_D2 = 2;

        { D3: Break Entry Price (2 pts) }
        if Close of Data3 > EntryPrice then
            v_Score_D3 = 2;

        { === 5F: Volatility Environment === }

        { E3: Volatility Regime Shift (3 pts) }
        v_1M_ATR_S = AvgTrueRange( ML_ATR_Short_Len ) of Data3;
        v_1M_ATR_L = AvgTrueRange( ML_ATR_Long_Len ) of Data3;
        if v_1M_ATR_L > 0 and
           v_1M_ATR_S > ML_ATR_Ratio * v_1M_ATR_L then
            v_Score_E3 = 3;

        { --- Score summation (max 30 pts) --- }
        v_1M_Score = v_Score_A1 + v_Score_A2 + v_Score_A4 + v_Score_A6
                   + v_Score_B1 + v_Score_B2
                   + v_Score_C1 + v_Score_C2
                   + v_Score_D2 + v_Score_D3
                   + v_Score_E3;

        v_1M_Score_Pct = v_1M_Score / 30 * 100;

        { --- Gate 2: Score threshold --- }
        v_1M_Gate2 = ( v_1M_Score_Pct >= ML_ScoreTrigger );

        { --- Gate 3: Cross-category count --- }
        v_1M_CatCount = 0;
        if v_Score_A1 + v_Score_A2 + v_Score_A4 + v_Score_A6 > 0 then
            v_1M_CatCount = v_1M_CatCount + 1;
        if v_Score_B1 + v_Score_B2 > 0 then
            v_1M_CatCount = v_1M_CatCount + 1;
        if v_Score_C1 + v_Score_C2 > 0 then
            v_1M_CatCount = v_1M_CatCount + 1;
        if v_Score_D2 + v_Score_D3 > 0 then
            v_1M_CatCount = v_1M_CatCount + 1;
        if v_Score_E3 > 0 then
            v_1M_CatCount = v_1M_CatCount + 1;

        v_1M_Gate3 = ( v_1M_CatCount >= ML_MinCategories );

        { --- TRIGGER: All 3 gates passed --- }
        v_1M_Trigger = v_1M_Gate1 and v_1M_Gate2 and v_1M_Gate3;

    end;

end;

{ Reset 1M exit flag when not in short position }
if MarketPosition <> -1 then
    v_1M_ExitFired = False;


{ ============================================================
  SECTION 10 - ENTRY LOGIC (Short-only per R-6 split)

  R-6 mirror difference vs S3_L:
    - Close < v_LowerBand (was > UpperBand)
    - sell short (was buy)
    - SE_VS_Entry label (was LE_VS_Entry)

  Gates (all must be true):
    - Flat (MP = 0)
    - v_Squeeze = True              (BBW historically compressed)
    - Close < v_LowerBand           (downward breakout confirmation)
    - Not on cooldown
    - Not on a holiday tail bar
    - Not on a settlement day
    - Not registry expired
  ============================================================ }

{ v1.8.0: gate entry to Data1 bar close only (IOG fires every 1M tick) }
if BarStatus(1) = 2 then begin
    if ( MarketPosition = 0 ) and
       ( v_Squeeze = True ) and
       ( Close < v_LowerBand ) and
       ( v_Cooldown_Active = False ) and
       ( v_Holiday_Block = False ) and
       ( v_Settlement_Day = False ) and
       ( v_Registry_Expired = False ) and
       ( v_Regime_OK = True ) then begin       { v1.7 regime gate }
        sell short ( "SE_VS_Entry" ) next bar at Market;
        v_EntryBar = BarNumber;
    end;
end;


{ ============================================================
  SECTION 11 - EXIT CHAIN (5-layer architecture v1.1, SHORT variant)

  R-6 mirror differences vs S3_L:
    - MarketPosition = -1 (was 1)
    - All "sell" -> "buy to cover"
    - SX_VS_* labels (was LX_VS_*)
    - TP price = EntryPrice - TargetDist (was +)
    - SL price = EntryPrice + StopDist (was -)
    - Mid trigger: Close > MidBand (was <)

  6-LAYER EXIT (v1.8.0 upgrade: +1M preemptive layer):
    Layer 0 (P0)  Safety gates (Kill / Registry / Holiday / Settlement)
    Layer 0.5     1M Preemptive SX_VS_1M_Exit (v1.8.0 NEW, before ATR SL cascade)
    Layer 1       Initial SL    SX_VS_SL  (Entry + ATR * StopATRMult, fixed)
    Layer 2       Trailing SP   SX_VS_SP  (v1.1, arm at peak >= ATR * 1.5,
                                          retain 70 pct of peak, irreversible)
    Layer 3       Mid exit      SX_VS_Mid (thesis fail: Close > MidBand after N bars)
    Layer 4       Target TP     SX_VS_TP  (Entry - ATR * TargetATRMult, limit)
    Layer 5       Time stop     SX_VS_TimeStop (BarsHeld >= MaxBars)

  PRIORITY ORDER (per CLAUDE.md Rule #11 + Rule #17):
    P0-1  SX_VS_Kill          (Manual_Kill_Switch)
    P0-2  SX_VS_RegistryEnd   (registry expired)
    P0-3  SX_VS_HolFlat       (holiday tail + Holiday_Flat_Time)
    P0-4  SX_VS_Settlement    (settlement day + Settlement_Flat_Time)
    S-0   SX_VS_1M_Exit       (market, 1M multi-layer preemptive, v1.8.0 NEW)
    S-1   SX_VS_TP            (limit, always set)
    S-2   SX_VS_Mid           (market, thesis fail, gated to bar close)
    S-3   SX_VS_TimeStop      (market, time exit, gated to bar close)
    S-4   SX_VS_SP / SX_VS_SL (stop, mutually exclusive - SP when armed, SL otherwise)
  ============================================================ }

ExitFired = 0;

if MarketPosition = -1 then begin

    { ---- P0-1 Manual kill switch ---- }
    if ( ExitFired = 0 ) and ( Manual_Kill_Switch = True ) then begin
        buy to cover ( "SX_VS_Kill" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- P0-2 Registry fail-safe ---- }
    if ( ExitFired = 0 ) and ( v_Registry_Expired = True ) then begin
        buy to cover ( "SX_VS_RegistryEnd" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- P0-3 Holiday iron rule (state-guarded + closed interval) ---- }
    if ( ExitFired = 0 ) and
       ( v_Holiday_Block = True ) and
       ( Time >= Holiday_Flat_Time ) and
       ( Time <= 455 ) then begin
        buy to cover ( "SX_VS_HolFlat" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- P0-4 Settlement flat (state-guarded) ---- }
    if ( ExitFired = 0 ) and
       ( v_Settlement_Day = True ) and
       ( Time >= Settlement_Flat_Time ) then begin
        buy to cover ( "SX_VS_Settlement" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- Layer 2 SP tracking (v1.1 NEW): peak profit + arm + floor ---- }
    { Peak profit for short = max(EntryPrice - Low) over hold }
    if EntryPrice - Low > v_Peak_Profit_Pts then
        v_Peak_Profit_Pts = EntryPrice - Low;

    { Arm SP once peak crosses threshold (irreversible per design) }
    if ( v_SP_Armed = False ) and
       ( v_Peak_Profit_Pts >= v_ATR * SP_Trigger_ATRMult ) then
        v_SP_Armed = True;

    { Compute SP floor price (retain N pct of peak profit) }
    if v_SP_Armed = True then
        v_SP_Floor_Price = EntryPrice - ( v_Peak_Profit_Pts * SP_Retain_Pct / 100 );

    { ---- S-0: Preemptive 1M exit (v1.8.0 NEW, before ATR SL cascade) ---- }
    if ( ExitFired = 0 ) and ( v_1M_Trigger = True ) then begin
        buy to cover ( "SX_VS_1M_Exit" ) next bar at Market;
        v_1M_ExitFired = True;
        ExitFired = 1;
    end;

    { ---- Strategy exits ---- }
    if ExitFired = 0 then begin

        { S-1: TP at ATR x TargetMult (limit, favorable to short = lower price) }
        buy to cover ( "SX_VS_TP" ) next bar at EntryPrice - v_TargetDist limit;

        { S-2: Mid-band exit (thesis fail, market) - gated to bar close for IOG }
        if BarStatus(1) = 2 then begin
            if UseMidExit = True and
               BarNumber - v_EntryBar >= MidExit_MinBars and
               Close > v_MidBand then begin
                buy to cover ( "SX_VS_Mid" ) next bar at Market;
                ExitFired = 1;
            end;
        end;

        { S-3: Time stop - gated to bar close for IOG }
        if BarStatus(1) = 2 then begin
            if ExitFired = 0 and
               BarNumber - v_EntryBar >= MaxBars then begin
                buy to cover ( "SX_VS_TimeStop" ) next bar at Market;
                ExitFired = 1;
            end;
        end;

        { S-4 v1.8.2: 1M Market exit (replaces Stop order, fixes Bug 2 SP IOG)
          v1.8.0 used: next bar at X Stop - IOG=true intrabar worst tick fill
          v1.8.2 uses: 1M K close evaluation + next bar Market - controlled fill
          SetStopLoss engine guard (Section 9) retained as absolute backup floor }
        if ExitFired = 0 then begin
            { SP armed: 1M K close crossed floor -> market exit at next 1M open }
            if v_SP_Armed = True and Close of Data3 >= v_SP_Floor_Price then begin
                buy to cover ( "SX_VS_SP" ) next bar at Market;
                ExitFired = 1;
            end
            { SL fallback: 1M K close crossed SL level -> market exit }
            else if v_SL_Locked = True and Close of Data3 >= v_SL_Level then begin
                buy to cover ( "SX_VS_SL" ) next bar at Market;
                ExitFired = 1;
            end;
        end;

    end;

end;


{ ============================================================
  SECTION 12 - COOLDOWN SET ON EXIT
  v1.2 ORIGINAL (FROZEN) - reverted from v1.3 attempt
  Cooldown semantics (accepted limitation):
    - Multi-bar exit (TP via limit reached later bar, Mid/TimeStop/SL): cool set OK
    - Same-bar entry+exit (entry fill bar TP also hits same bar): cool NOT set
      (v_Prev_MP from prior bar end = 0, condition v_Prev_MP=-1 fails)
      Effect: rare same-day 2nd entry can pass cooldown (e.g., 2025-04-07 case
              TP +278K + SL -206K, net +72K - disclosed edge, not fixed in v1.2)
  v1.3 attempted EntriesToday(Date) fix but failed due to:
    - MC section execution order (Sec 10 entry signal can fire before Sec 12 set)
    - EntriesToday TXF1 cross-midnight calendar/session quirk
    Result: v1.3 Cool=1 worse than v1.2 (Net -181K, MDD -7pct, +10 trades)
  Decision (2026-06-24 user ruling): v1.2 frozen as final, v1.4 in backlog.
  ============================================================ }

if v_Prev_MP = -1 and MarketPosition <> -1 then begin
    v_Cooldown_Active = True;
    v_LastExit_Date   = Date;
end;


{ ============================================================
  SECTION 13 - PREV_MP TRACKING (last line, per Rule #8)
  ============================================================ }

v_Prev_MP = MarketPosition;
