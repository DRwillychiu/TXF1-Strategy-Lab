  SECTION 2 - VARIABLES
  v1.9.0: all IntraBarPersist removed (IOG=false).
  Added v_BW_Ptr, v_BW_Filled for circular buffer BWRank.
  ============================================================ }

variables:
    { ===== Bollinger Bands ===== }
    v_MidBand                ( 0     ),
    v_UpperBand              ( 0     ),
    v_LowerBand              ( 0     ),
    v_BandWidth              ( 0     ),
    v_BWRank                 ( 0     ),
    v_BWCount                ( 0     ),
    v_Squeeze                ( False ),

    { ===== BWRank circular buffer state (v1.9.0 NEW) ===== }
    v_BW_Ptr                 ( 0     ),
    v_BW_Filled              ( 0     ),

    { ===== ATR ===== }
    v_ATR                    ( 0     ),
    v_StopDist               ( 0     ),
    v_TargetDist             ( 0     ),

    { ===== Trade state ===== }
    v_EntryBar               ( 0     ),
    v_Prev_MP                ( 0     ),

    { ===== Frozen SL (Rule #12 backup, Short variant) ===== }
    v_SL_Locked              ( False ),
    v_Frozen_ATR             ( 0     ),
    v_Frozen_SL_Dist         ( 0     ),
    v_SL_Level               ( 0     ),

    { ===== Layer 2 SP state (v1.9.0: no IntraBarPersist) ===== }
    v_SP_Armed               ( False ),
    v_Peak_Profit_Pts        ( 0     ),
    v_SP_Floor_Price          ( 0     ),

    { ===== Regime Filter state (Daily via Data3) ===== }
    v_MA_Fast_D              ( 0     ),
    v_MA_Slow_D              ( 0     ),
    v_Regime_Ratio           ( 1     ),
    v_In_WeakBull_Zone       ( False ),
    v_In_Range_Zone          ( False ),
    v_Regime_OK              ( True  ),

    { ===== Cooldown (v1.9.0: no IntraBarPersist) ===== }
    v_LastExit_Date          ( 0     ),
    v_Cooldown_Active        ( False ),

    { ===== Priority 0 protection state ===== }
    v_Holiday_Block          ( False ),
    v_Registry_Expired       ( False ),
    v_Settlement_Day         ( False ),
    Registry_Warn_ID         ( -1    ),
    hidx                     ( 0     ),
    v_i                      ( 0     ),
    ExitFired                ( 0     ),

    { ===== Multi-Layer 1M state (now native on Data1) ===== }
    v_1M_ExitFired           ( False ),
    v_1M_Score               ( 0     ),
    v_1M_Score_Pct           ( 0     ),
    v_1M_CatCount            ( 0     ),
    v_1M_Trigger             ( False ),
    v_1M_Loss                ( 0     ),
    v_1M_Gate1               ( False ),
    v_1M_Gate2               ( False ),
    v_1M_Gate3               ( False ),

    { 1M factor scores }
    v_Score_A1               ( 0     ),
    v_Score_A2               ( 0     ),
    v_Score_A4               ( 0     ),
    v_Score_A6               ( 0     ),
    v_Score_B1               ( 0     ),
    v_Score_B2               ( 0     ),
    v_Score_C1               ( 0     ),
    v_Score_C2               ( 0     ),
    v_Score_D2               ( 0     ),
    v_Score_D3               ( 0     ),
    v_Score_E3               ( 0     ),

    { 1M helper variables }
    v_1M_Body                ( 0     ),
    v_1M_LowerShadow         ( 0     ),
    v_1M_AvgVol              ( 0     ),
    v_1M_Body0               ( 0     ),
    v_1M_Body1               ( 0     ),
    v_1M_Body2               ( 0     ),
    v_1M_ConsecUp            ( 0     ),
    v_1M_Speed_Cur           ( 0     ),
    v_1M_Speed_Prev          ( 0     ),
    v_1M_SpeedBarsP1         ( 0     ),
    v_1M_ATR_S               ( 0     ),
    v_1M_ATR_L               ( 0     );


{ ============================================================
  SECTION 3 - ARRAYS
  v1.9.0: added BW_History[150] for 60M-resolution BWRank circular buffer.
  Buffer size 150 > BWLookback(120) to accommodate future parameter tuning.
  ============================================================ }

arrays:
    Holiday_Tail[80]( 0 ),
    BW_History[150]( 0 );


{ ============================================================
  SECTION 4 - HOLIDAY TAIL REGISTRY (TAIFEX-verified)
  Byte-identical to v1.8.0-PROD.
  ============================================================ }

if CurrentBar = 1 then begin

    { --- 2019 --- }
    Holiday_Tail[1]  = 1190913;
    Holiday_Tail[2]  = 1191010;
    Holiday_Tail[3]  = 1200101;

