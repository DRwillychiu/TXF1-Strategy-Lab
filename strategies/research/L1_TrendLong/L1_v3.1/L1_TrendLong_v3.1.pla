    Holiday_Tail[35] = 1240206;  { CNY }
    Holiday_Tail[36] = 1240228;  { 228 }
    Holiday_Tail[37] = 1240404;  { Tomb Sweeping }
    Holiday_Tail[38] = 1240501;  { * Labor Day }
