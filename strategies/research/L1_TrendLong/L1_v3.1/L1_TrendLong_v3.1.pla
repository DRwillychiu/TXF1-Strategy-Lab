    Init_Done = True;

end;

{ ==========================================
  1. Core Indicators Calculation
  ========================================== }

if BarStatus(1) = 2 then begin
    maBase  = Average(Close, Length60);
    maTrail = Average(Close, Length20);

    Current_ATR = AvgTrueRange(ATR_Length) of Data1;
    Daily_ATR   = AvgTrueRange(ATR_Length)[1] of Data2;

    Breakout_Level = maBase + (Current_ATR * Entry_Multiplier);
end;

{ ==========================================
  P6: Weekly Filter Logic (Data3 - Weekly)
  OR logic: either MA condition allows long entries.
  Trend strategies need early entry at trend inception.
  AND logic would miss the early bull phase.
  ========================================== }

if BarStatus(1) = 2 then begin
    v_Weekly_MA_Fast = Average(Close, Weekly_MA_Fast) of Data3;
    v_Weekly_MA_Slow = Average(Close, Weekly_MA_Slow) of Data3;

    if (Close of Data3 > v_Weekly_MA_Fast) or
       (Close of Data3 > v_Weekly_MA_Slow) then
        v_Weekly_Filter = true
    else
        v_Weekly_Filter = false;
end;

{ ==========================================
  1b. P5 v3: Holiday Tail Detection
  Tail bars only exist in the 00:00-05:00 window
  (Time <= 0500 guard keeps the scan cheap).
  Computed BEFORE entry logic so the gate uses
  the current bar's state, not the prior bar's.
  ========================================== }

if BarStatus(1) = 2 then begin
    v_Holiday_Block = False;

    if Time <= 500 then begin
        for idx = 1 to 80 begin
            if Date = Holiday_Tail[idx] then
                v_Holiday_Block = True;
        end;
    end;

    { Fail-safe: beyond the verified registry horizon the future
      holiday schedule is UNKNOWN (next TAIFEX annual calendar not
      yet published / not yet loaded). Never trade unverified dates:
      block all entries and flatten any position. }

    v_Registry_Expired = False;

    if Date > Registry_Valid_Until then begin
        v_Registry_Expired = True;
        v_Holiday_Block    = True;
    end;
end;

{ ==========================================
  P6 Settlement-Day Detection (2026-06-17 added)
  TXF1 monthly settlement = 3rd Wednesday of each month.
  Logic: DayOfWeek=3 (Wed in MC) AND DayOfMonth in [15,21].
  Dynamic detection - no registry needed (TAIFEX rule is stable).
  ========================================== }

v_Settlement_Day = (DayOfWeek(Date) = 3) and
                   (DayOfMonth(Date) >= 15) and
                   (DayOfMonth(Date) <= 21);

{ Live-chart warning: registry horizon within ~30 days }

if LastBarOnChart and
   DateToJulian(Date) >= DateToJulian(Registry_Valid_Until) - 30 then begin
    if Registry_Warn_ID < 0 then begin
        Registry_Warn_ID = Text_New(Date, Time, High + 400,
            "P5 HOLIDAY REGISTRY EXPIRES " +
            NumToStr(Registry_Valid_Until, 0) +
            " - REBUILD FROM TAIFEX CALENDAR");
        Text_SetColor(Registry_Warn_ID, Red);
        Text_SetSize(Registry_Warn_ID, 14);
        Text_SetAttribute(Registry_Warn_ID, 1, true);
    end;
end;

{ ==========================================
  2. Entry Logic (gated by Holiday Tail)
  ========================================== }

MP = MarketPosition;

{ P3b: Immediate Stop Guard -- entry-bar protection (2026-06-18)
  SetStopLoss is MC engine-level: active on entry bar, no IOG dependency.
  Only called when flat -> freezes at signal-bar ATR once position opens.
  V2.9 (2026-07-22): MaxList -> MinList. MinList of DISTANCES is the
  TIGHTER leg = exactly what P3 freezes below (MaxList of PRICES).
  The old MaxList picked the LOOSER leg: entry-bar risk ran 1.6-2.8x
  wider than the frozen SL for the whole V2.6+ era.
  SetStopContract makes the amount per-CONTRACT (lot-count invariant);
  per-position default would halve the distance at 2 lots. }
SetStopContract;
if MP <= 0 then begin
    if SL_Pct > 0 then
        SetStopLoss(MinList(Current_ATR * SL_Multiplier,
                            MinList(Daily_ATR * Daily_Cap_Multiplier,
                                    Close * SL_Pct / 100)) * BigPointValue)
    else
        SetStopLoss(MinList(Current_ATR * SL_Multiplier,
                            Daily_ATR * Daily_Cap_Multiplier) * BigPointValue);
end;

if BarStatus(1) = 2 then begin
    Cond_Breakout = (Close Crosses Over Breakout_Level);

    if MP = 0 and
       Cond_Breakout and
       (v_Weekly_Filter = true) and
       (v_Holiday_Block = false) and
       (v_Settlement_Day = false) then begin
        Buy ("TL_Entry") next bar at Market;
    end;
end;

{ ==========================================
  3. Exit Management (P3 and P4 Integrated)
  ========================================== }

if MP > 0 then begin

    Entry_P = EntryPrice;

    { P3 V3.1: Triple-Layered Initial Stop, FROZEN at entry.
      Leg 1: 45M ATR * multiplier (intraday vol).
      Leg 2: Daily ATR * cap multiplier (daily vol ceiling).
      Leg 3: Entry * SL_Pct / 100 (percentage cap, V3.1 new).
      MaxList picks the TIGHTEST (highest price for long).
      SL_Pct = 0 disables Leg 3 (V3.0 compatible mode). }
    if BarStatus(1) = 2 and v_SL_Locked = False then begin
        Exit_Price_ATR = Entry_P - (Current_ATR * SL_Multiplier);
        Exit_Price_Cap = Entry_P - (Daily_ATR   * Daily_Cap_Multiplier);
        if SL_Pct > 0 then
            Exit_Price_Pct = Entry_P - (Entry_P * SL_Pct / 100)
        else
            Exit_Price_Pct = 0;
        v_Frozen_SL    = MaxList(Exit_Price_ATR, MaxList(Exit_Price_Cap, Exit_Price_Pct));
        v_SL_Locked    = True;
    end;

    Exit_Price_SL = v_Frozen_SL;

    { P7 V2.6: Stop Profit Guard (L2 SECTION 12 ported to long).
      Close-based peak profit ratchets up only; once armed the
      lock floor never disarms until flat. An armed runner can
      never round-trip into a loss. }
    if (Close - Entry_P) >= stopProfitPoints_Long then begin
        if (Close - Entry_P) > posbleProfit_Long then
            posbleProfit_Long = Close - Entry_P;
        stopProfitPrice_L = Entry_P +
            (posbleProfit_Long * (1.0 - profitReturnPrcnt_Long / 100.0));
    end;

    { P4 V3.0: MA55 trail with uni-directional ratchet.
      v_Trail_High only moves up (MaxList prevents descent).
      maTrail updates at bar close only (BarStatus=2 guarded). }
    v_Trail_High = MaxList(v_Trail_High, maTrail - TrailOffset);
    Exit_Price_Trail = v_Trail_High;
    Final_Exit_Price = MaxList(Exit_Price_Trail,
                       MaxList(Exit_Price_SL, stopProfitPrice_L));

    { Execution with unified TL_ labels.
      V2.9.1: loss side and profit side never share a label; the
      side is judged at order placement by exit level vs entry. }
    if BarStatus(1) = 2 and Close < Final_Exit_Price then begin
        if Final_Exit_Price >= Entry_P then
            Sell ("TL_SP_Gap") next bar at Market
        else
            Sell ("TL_SL_Gap") next bar at Market;
    end else begin
        if AbsValue(Final_Exit_Price - Exit_Price_SL) < 0.001 then
            Sell ("TL_SL") next bar at Final_Exit_Price Stop
        else if stopProfitPrice_L > 0 and
                AbsValue(Final_Exit_Price - stopProfitPrice_L) < 0.001 then
            Sell ("TL_SP") next bar at Final_Exit_Price Stop
        else if Exit_Price_Trail >= Entry_P then
            Sell ("TL_TP") next bar at Final_Exit_Price Stop
        else
            Sell ("TL_TSL") next bar at Final_Exit_Price Stop;
    end;

end else begin
    { Flat: release locks for the next trade }
    v_SL_Locked       = False;
    v_Frozen_SL       = 0;
    posbleProfit_Long = 0;
    stopProfitPrice_L = 0;
    v_Trail_High      = 0;
end;

{ ==========================================
  4. P5 v3: Pre-Holiday Forced Flat (Iron Rule)
  On tail bars, force a market exit from
  Holiday_Flat_Time (03:45) onward:
    45M grid -> trigger on the 03:45 bar, fill at
    03:45; retry on the 04:30 bar, fill at 04:30.
    Always flat before the 05:00 session close.
  Typhoon / unscheduled closures cannot be
  pre-coded: use Manual_Kill_Switch + the
  pre-holiday manual check (SOP sec 3-1).
  ========================================== }

if MP > 0 then begin

    if v_Registry_Expired then begin
        Sell ("TL_RegistryEnd") next bar at Market;
    end
    else if v_Holiday_Block and Time >= Holiday_Flat_Time then begin
        Sell ("TL_Holiday") next bar at Market;
    end
    else if v_Settlement_Day and Time >= Settlement_Flat_Time then begin
        Sell ("TL_Settlement") next bar at Market;
    end;

    if Manual_Kill_Switch = True then begin
        Sell ("TL_Kill") next bar at Market;
    end;

end;

{ ==========================================
  5. Annual MDD Visualizer Module
  No label changes needed in this section.
  ========================================== }

if BarStatus(1) = 2 then begin

if CurrentBar = 1 then begin
    Current_Year_Log  = Year(Date);
    Year_Start_Equity = InitialCapital;
    Year_High_Equity  = InitialCapital;
    Year_Max_DD       = 0;
end;

MyEquity = InitialCapital + NetProfit + OpenPositionProfit;

if Year(Date) <> Current_Year_Log or LastBarOnChart then begin

    if LastBarOnChart and Year(Date) = Current_Year_Log then
        Year_Net_Profit = MyEquity - Year_Start_Equity
    else
        Year_Net_Profit = MyEquity[1] - Year_Start_Equity;

    if Current_Year_Log >= 2024 then begin
        strMsg = "Year: " + NumToStr(Current_Year_Log, 0) + NewLine +
                 "MDD: $" + NumToStr(Year_Max_DD, 0);
        if LastBarOnChart then
            txtID = Text_New(Date,    Time,    High    + 200, strMsg)
        else
            txtID = Text_New(Date[1], Time[1], High[1] + 200, strMsg);
        Text_SetStyle(txtID,     2, 1);
        Text_SetColor(txtID,     Green);
        Text_SetSize(txtID,      12);
        Text_SetAttribute(txtID, 1, true);
    end;

    Current_Year_Log = Year(Date);

    if LastBarOnChart = False then begin
        Year_Start_Equity = MyEquity[1];
        Year_High_Equity  = MyEquity[1];
        Year_Max_DD       = 0;
    end;

end;

if Year(Date) = Current_Year_Log then begin
    if MyEquity > Year_High_Equity then
        Year_High_Equity = MyEquity;
    Year_DD = Year_High_Equity - MyEquity;
    if Year_DD > Year_Max_DD then
        Year_Max_DD = Year_DD;
end;

end;
