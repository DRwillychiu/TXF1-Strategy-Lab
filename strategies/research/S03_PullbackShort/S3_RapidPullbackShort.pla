{ ================================================================================
  S3 - RAPID PULLBACK SHORT STRATEGY
  Signal Name : S3_RapidPullbackShort
  MC Load Name: STRATEGY_GEN_RapidPullbackShort
  Version     : v1.0  (2026-06-20)
  Symbol      : TXF1 (Taiwan Stock Index Futures Front Month)
  Platform    : MultiCharts 9.0 PowerLanguage x64
  Timeframe   : Data1 = 5M  (entry trigger / exit chain)
                Data2 = 60M (reserved for higher-TF context, used
                             by future MFE / runner layer; v1.0
                             does not call Data2 inside logic but
                             the symbol is wired so MC chart load
                             expects 3 data series)
                Data3 = Daily (regime gate: MA20/MA60/RSI14/dist%)
  Class       : Counter-trend short with momentum confirmation
                (sells overheated bull pullbacks intraday)

  CREATED 2026-06-20
    From design_spec_v2.md (Agent D synthesis of 5 deep-research
    agents). User confirmed all 8 decisions on 2026-06-20.
    See: S3_PullbackShort_design_spec_v2.md
         S3_RapidPullbackShort_strategy.md

  DESIGN DECISIONS (all RECOMMENDED versions accepted by user):
    D1  Regime Gate     : Moderate  A AND (B OR C)
                          A = Daily MA20 > MA60
                          B = Daily RSI(14) > 70 sustained 2 bars
                          C = Daily distance from MA20 > +3%
    D2  Momentum Trigger: Balanced 4-AND
                          M1 = 3 consecutive 5M red candles
                          M2 = Close < EMA5 AND EMA5 slope < 0
                          M3 = ATR(5) > ATR(20) * 1.3
                          M4 = Distance from intraday high in
                               [0.5%, 1.5%]
                          (Volume DROPPED - S2 v0.4 lesson)
    D3  Exit Tier       : Balanced
                          TP = 0.7% from entry
                          SL = ATR(14) * 4 ( ~ 0.58% )
                          Time = 24 x 5M bars (120 min)
                          R:R 1.21, target WR 52-58%
    D4  TP Backup       : EMA20 touch (whichever fires first)
    D5  Entry Window    : 08:45 - 12:30 (wider)
    D6  L4 Disposition  : Retire L4 (3%) - S3 gets the slot
    D7  Volume Verify   : YES (5-line MC ShowMe before .pla)
                          [done outside this file, procedural]
    D8  HighConviction  : Logging-only in v1.0 (defer to v1.1)

  PARAMETERIZATION (user override 2026-06-20):
    ALL numeric thresholds are PowerLanguage inputs - none hardcoded.
    MC12 optimization will sweep these in v1.1.
    Defaults match design_spec_v2.md; suggested optimization ranges
    documented inline beside each input.

  LESSON CHECK (mandatory header reminders):
    1. CLOSED TIME INTERVALS (Rule MC_Time_24hr):
       Every Time>=X must either be paired with explicit Time<=Y
       in the same condition OR be guarded by a state flag
       (v_Holiday_Block / v_Settlement_Day) that already encodes
       the day-context. Audit at bottom of file.
    2. FILTER REDUNDANCY CHECK (Rule Filter_Redundancy):
       Every input justified vs existing logic. M1..M4 are
       orthogonal (consecutive bars vs MA break vs vol spike vs
       price geometry). No redundant filter.
    3. VOLUME SIGNAL DROPPED (S2 v0.4 lesson):
       TXF1 5M volume series unverified - dropped from v1.0.
       Re-evaluate after MC ShowMe verification stage.

  CONSTITUTION COMPLIANCE (mandatory per CLAUDE.md):
    Rule #11 Settlement_Flat (7 elements): present in Priority 0.
    Rule #12 P3b SetStopLoss: single call before entry block,
             guarded by MarketPosition >= 0 (short variant).
    Rule #13 10-dim eval before live_simulation: deferred to
             post-backtest gate; not enforced in source.

  LABEL CONVENTIONS:
    SE_RPS_*  short entry labels
    SX_RPS_*  short exit labels (one per exit reason)

  PERFORMANCE: NO BACKTEST YET. v1.0 is research-tier only.
================================================================================ }

[IntrabarOrderGeneration = false]


{ ============================================================
  SECTION 1 - INPUTS
  All numeric thresholds parameterized for MC12 optimization.
  Suggested optimization ranges in inline comments.
  ============================================================ }

inputs:
    { ===== Tier 1 : Regime Gate Parameters (Daily, Data3) ===== }
    Daily_FastMA_Len          ( 20    ),   { opt 10..30 step 5 }
    Daily_SlowMA_Len          ( 60    ),   { opt 40..120 step 10 }
    Daily_RSI_Len             ( 14    ),   { opt 7..21 step 7 }
    Daily_RSI_Threshold       ( 70    ),   { opt 60..80 step 5 }
    Daily_RSI_Sustained_Bars  ( 2     ),   { opt 1..3 step 1 }
    Daily_Dist_MA20_Pct       ( 3.0   ),   { opt 2..5 step 0.5 }

    { ===== Tier 2 : Momentum Trigger Parameters (5M, Data1) ===== }
    Consec_Red_Bars           ( 3     ),   { opt 2..5 step 1 }
    EMA_Fast_Len              ( 5     ),   { opt 5..10 step 1 }
    ATR_Short_Len             ( 5     ),   { opt 3..7 step 1 }
    ATR_Long_Len              ( 20    ),   { opt 15..30 step 5 }
    ATR_Spike_Mult            ( 1.3   ),   { opt 1.1..1.6 step 0.1 }
    Pullback_Min_Pct          ( 0.5   ),   { opt 0.3..0.7 step 0.1 }
    Pullback_Max_Pct          ( 1.5   ),   { opt 1.0..2.0 step 0.25 }

    { ===== Exit Parameters ===== }
    TP_Pct                    ( 0.7   ),   { opt 0.5..1.0 step 0.1 }
    TP_Use_EMA20_Backup       ( True  ),   { D4: structural backup }
    TP_MA_Len                 ( 20    ),   { opt 15..30 step 5 }
    SL_ATR_Len                ( 14    ),   { opt 10..21 step 1 }
    SL_ATR_Mult               ( 4     ),   { opt 3..6 step 0.5 }
    Max_Bars_TimeStop         ( 24    ),   { 24 * 5M = 120 min; opt 18..36 }
    Entry_Open_Time           ( 845   ),   { D5: 08:45 window open }
    Entry_Cutoff_Time         ( 1230  ),   { D5: 12:30 window close }
    Daily_Flat_Time           ( 1325  ),   { force flat by 13:25 }

    { ===== Priority 0 Protection (Rule #11 / #12) ===== }
    Holiday_Flat_Time         ( 415   ),   { 5M grid -> fill 04:15, retry through 04:55 }
    Registry_Valid_Until      ( 1270101 ), { TAIFEX-verified horizon; bump each Q4 }
    Manual_Kill_Switch        ( False ),
    Settlement_Flat_Time      ( 1230  ),   { 1hr buffer before 13:30 settlement }

    { ===== Diagnostic (D8 logging-only in v1.0) ===== }
    Log_HighConviction        ( True  ),
    HighConv_Threshold_Pct    ( 5.0   ); { opt 4..7 step 0.5 (v1.1) }


{ ============================================================
  SECTION 2 - VARIABLES
  ============================================================ }

variables:
    { ===== Daily Tier 1 (Data3) ===== }
    v_Daily_FastMA           ( 0     ),
    v_Daily_SlowMA           ( 0     ),
    v_Daily_RSI              ( 0     ),
    v_Daily_RSI_Sustained    ( False ),
    v_Daily_Dist_Pct         ( 0     ),
    v_Trend_OK               ( False ),
    v_RSI_OK                 ( False ),
    v_Dist_OK                ( False ),
    v_Regime_Watch           ( False ),

    { ===== 5M Tier 2 (Data1) ===== }
    v_M1_Consec              ( False ),
    v_M2_BelowEMA            ( False ),
    v_M3_ATR_Spike           ( False ),
    v_M4_Pullback            ( False ),
    v_5M_EMA                 ( 0     ),
    v_5M_EMA_Prev            ( 0     ),
    v_5M_ATR_Short           ( 0     ),
    v_5M_ATR_Long            ( 0     ),
    v_Pullback_Pct           ( 0     ),
    v_Trigger_Fired          ( False ),
    v_Red_Loop_OK            ( True  ),
    v_red_idx                ( 0     ),

    { ===== Exit state ===== }
    v_TP_Pct_Level           ( 0     ),
    v_TP_EMA20               ( 0     ),
    v_5M_EMA20               ( 0     ),
    v_SL_ATR                 ( 0     ),
    v_Bars_Held              ( 0     ),
    v_Entry_Bar              ( 0     ),

    { ===== Cooldown (one trade per day) ===== }
    v_S3_LastExitDate        ( 0     ),
    v_DailyCooldown_Active   ( False ),
    v_LastSeenDate           ( 0     ),

    { ===== Priority 0 protection state ===== }
    v_Holiday_Block          ( False ),
    v_Registry_Expired       ( False ),
    v_Settlement_Day         ( False ),
    Registry_Warn_ID         ( -1    ),
    hidx                     ( 0     ),
    ExitFired                ( 0     ),

    { ===== Diagnostic ===== }
    v_HighConv_Active        ( False );


{ ============================================================
  SECTION 3 - ARRAYS
  Holiday_Tail: shared 63-entry TAIFEX registry (byte-identical
  to L1/L2/L3/L5).
  ============================================================ }

arrays:
    Holiday_Tail[80]( 0 );


{ ============================================================
  SECTION 0 - HOLIDAY TAIL REGISTRY (TAIFEX-verified)
  Copied verbatim from L2_TrendShort.pla (63 entries). Holiday_Tail
  = last trading day + 1 calendar day = the date stamped on the
  00:00-05:00 tail bars of the final night session before each
  closure. Tail bars on these dates block new entries and force
  flat from Holiday_Flat_Time.
  ============================================================ }

if CurrentBar = 1 then begin

    { --- 2019 --- }
    Holiday_Tail[1]  = 1190913;
    Holiday_Tail[2]  = 1191010;
    Holiday_Tail[3]  = 1200101;

    { --- 2020 --- }
    Holiday_Tail[4]  = 1200121;  { CNY }
    Holiday_Tail[5]  = 1200228;  { 228 }
