    v_ReEntry_BoxTop(0),           { original box frozen at ARM, for DISARM }
    v_ReEntry_BoxBtm(0),
    v_Frozen_SL_Orig(0),           { the stop the interrupted trade was carrying }
    v_IsReEntry(false),            { is the CURRENT position a re-entry }
    v_ReEntry_Chain(0),            { re-entries so far in this cycle }

    { Exit chain }
    ExitFired(0);

arrays:
    Holiday_Tail[80](0);

{ ==========================================
  Phase -1: Holiday Tail Registry (TAIFEX-verified, shared
  with L1/L2/L3). Holiday_Tail = last trading day + 1 calendar
  day = the date stamped on the 00:00-05:00 tail bars of the
  final night session before each closure. * = reconstructed.
  ========================================== }

if CurrentBar = 1 then begin
    Holiday_Tail[1]  = 1190913;  Holiday_Tail[2]  = 1191010;
    Holiday_Tail[3]  = 1200101;
    { 2020 } Holiday_Tail[4]  = 1200121;  Holiday_Tail[5]  = 1200228;
    Holiday_Tail[6]  = 1200402;  Holiday_Tail[7]  = 1200501;
    Holiday_Tail[8]  = 1200625;  Holiday_Tail[9]  = 1201001;
    Holiday_Tail[10] = 1201009;  Holiday_Tail[11] = 1210101;
    { 2021 } Holiday_Tail[12] = 1210206;  Holiday_Tail[13] = 1210227;
    Holiday_Tail[14] = 1210402;  Holiday_Tail[15] = 1210612;
    Holiday_Tail[16] = 1210918;  Holiday_Tail[17] = 1211009;
    Holiday_Tail[18] = 1211231;
    { 2022 } Holiday_Tail[19] = 1220127;  Holiday_Tail[20] = 1220226;
    Holiday_Tail[21] = 1220402;  Holiday_Tail[22] = 1220430;
    Holiday_Tail[23] = 1220603;  Holiday_Tail[24] = 1220909;
    Holiday_Tail[25] = 1221008;  Holiday_Tail[26] = 1221231;
    { 2023 } Holiday_Tail[27] = 1230118;  Holiday_Tail[28] = 1230225;
    Holiday_Tail[29] = 1230401;  Holiday_Tail[30] = 1230429;
    Holiday_Tail[31] = 1230622;  Holiday_Tail[32] = 1230929;
    Holiday_Tail[33] = 1231007;  Holiday_Tail[34] = 1231230;
    { 2024 } Holiday_Tail[35] = 1240206;  Holiday_Tail[36] = 1240228;
    Holiday_Tail[37] = 1240404;  Holiday_Tail[38] = 1240501;
    Holiday_Tail[39] = 1240608;  Holiday_Tail[40] = 1240917;
    Holiday_Tail[41] = 1241010;  Holiday_Tail[42] = 1250101;
    { 2025 (* pending vs 114-yr PDF) }
    Holiday_Tail[43] = 1250123;  Holiday_Tail[44] = 1250228;
    Holiday_Tail[45] = 1250403;  Holiday_Tail[46] = 1250501;
    Holiday_Tail[47] = 1250530;  Holiday_Tail[48] = 1250927;
    Holiday_Tail[49] = 1251004;  Holiday_Tail[50] = 1251010;
    Holiday_Tail[51] = 1251024;  Holiday_Tail[52] = 1251225;
    Holiday_Tail[53] = 1260101;
    { 2026 (verified: TAIFEX official 115-yr calendar) }
    Holiday_Tail[54] = 1260212;  Holiday_Tail[55] = 1260227;
    Holiday_Tail[56] = 1260403;  Holiday_Tail[57] = 1260501;
    Holiday_Tail[58] = 1260619;  Holiday_Tail[59] = 1260925;
    Holiday_Tail[60] = 1261009;  Holiday_Tail[61] = 1261024;
    Holiday_Tail[62] = 1261225;  Holiday_Tail[63] = 1270101;
    { 2027 CNY onward: rebuild from TAIFEX 116-yr calendar in Q4 2026 }
end;

v_Holiday_Block = false;

if Time <= 500 then begin
    for hidx = 1 to 80 begin
        if Date = Holiday_Tail[hidx] then
            v_Holiday_Block = true;
    end;
end;

v_Registry_Expired = false;

if Date > Registry_Valid_Until then begin
    v_Registry_Expired = true;
    v_Holiday_Block    = true;
end;

{ Monthly Settlement Day detection (3rd Wed of month) }
v_Settlement_Day = (DayOfWeek(Date) = 3) and
                   (DayOfMonth(Date) >= 15) and
                   (DayOfMonth(Date) <= 21);

if LastBarOnChart and
   DateToJulian(Date) >= DateToJulian(Registry_Valid_Until) - 30 then begin
    if Registry_Warn_ID < 0 then begin
        Registry_Warn_ID = Text_New(Date, Time, High + 400,
            "HOLIDAY REGISTRY EXPIRES " +
            NumToStr(Registry_Valid_Until, 0) +
            " - REBUILD FROM TAIFEX CALENDAR");
        Text_SetColor(Registry_Warn_ID, Red);
        Text_SetSize(Registry_Warn_ID, 14);
        Text_SetAttribute(Registry_Warn_ID, 1, true);
    end;
end;

{ ==========================================
  v14.2 Path A: Night entry block (02:00-04:59)
  TXF1 dead-of-night session has thin liquidity. Diagnostic
  found 9 entries at this window, all losers (net -120,800),
  ZERO of them being CS_BreakExit cases. Pure noise.
  ========================================== }

v_Night_Block = false;
if Night_Block_On = true and Time >= 200 and Time < 500 then
    v_Night_Block = true;

{ ==========================================
  Phase 0: Master Environment Filter (Data3 - Daily)
  Condition A: Close > SlowMA AND SlowMA sloping up (strong bull)
  Condition B: FastMA > SlowMA (golden cross, bull alignment)
  Either condition true = block all short entries
  ========================================== }

v_Daily_FastMA = Average(Close, Daily_FastMA_Len) of Data3;
v_Daily_SlowMA = Average(Close, Daily_SlowMA_Len) of Data3;

if ((Close of Data3 > v_Daily_SlowMA) and
    (v_Daily_SlowMA >= v_Daily_SlowMA[1]))
   or (v_Daily_FastMA > v_Daily_SlowMA) then begin
    v_Macro_Block = true;
end else begin
    v_Macro_Block = false;
end;

{ ==========================================
  Phase 1: Macro Commander Logic (Data2 - 60M)
  ========================================== }

v_Ref_High   = Highest(High, Lookback_Bars)[1] of Data2;
v_Ref_Low    = Lowest(Low,   Lookback_Bars)[1] of Data2;
v_Curr_Range = (High of Data2) - (Low of Data2);
v_Ref_Range  = v_Ref_High - v_Ref_Low;

v_Weekly_MA = Average(Close, Weekly_MA_Len) of Data2;

if Close of Data2 < v_Weekly_MA then
    v_Trend_Dir = -1
else
    v_Trend_Dir = 1;

if (High of Data2 <= v_Ref_High) and (Low of Data2 >= v_Ref_Low) then begin
    if v_Ref_Range > 0 and
       (v_Curr_Range / v_Ref_Range <= Range_Shrink_Rate) then begin
        v_is_in_consolidation = true;
        v_Box_Top = v_Ref_High;
        v_Box_Btm = v_Ref_Low;
    end;
end;

if v_is_in_consolidation then begin
    if (Close of Data2 > v_Box_Top) or
       (Close of Data2 < v_Box_Btm) then
        v_is_in_consolidation = false;
end;

{ ==========================================
  Phase 2: Tactical Execution Engine (Data1 - 15M)
  ========================================== }

v_Current_ATR = AvgTrueRange(ATR_Length);

{ v17: numeric switches mirrored into booleans. }
v_Buffer_Form_Pct = ( Buffer_Form = 2 );
v_Stop_Form_Pct   = ( Stop_Form   = 2 );
v_Trail_Form_Pct  = ( Trail_Form  = 2 );

{ v14.6: SetStopContract makes SetStopLoss amount PER-CONTRACT (lot-invariant).
  Without this, SetStopLoss dollar amount is for the TOTAL position,
  causing engine stop to be Nx tighter than designed for N-contract entries. }
SetStopContract;

{ Cooldown Counter Management }
if MarketPosition <> 0 then
    v_BarsSinceExit = 0
else if MarketPosition = 0 and MarketPosition[1] <> 0 then
    v_BarsSinceExit = 1
else if MarketPosition = 0 then
    v_BarsSinceExit = v_BarsSinceExit + 1;

if v_is_in_consolidation and v_Box_Top > v_Box_Btm then begin

    { Sub-Phase A: False Breakout (Trap) Detection }
    if High > v_Box_Top then begin
        v_In_Trap_Zone = true;
        v_Trap_Counter = 0;
    end;

    { Time decay: trap zone expires after Time_Limit_Bars }
    if v_In_Trap_Zone then begin
        v_Trap_Counter = v_Trap_Counter + 1;
        if v_Trap_Counter > Time_Limit_Bars then
            v_In_Trap_Zone = false;
    end;

    { P3b: Immediate Stop Guard -- entry-bar protection (2026-06-18)
      SetStopLoss is MC engine-level: active on entry bar, no IOG dependency.
      Only called when not short -> freezes at signal-bar box snapshot.
      v14.6: SL_Pct caps engine stop distance as pct of Close. }
    if MarketPosition >= 0 then begin
        { v17: the guard distance follows whichever stop form is active, so
          the engine stop and the custom stop cannot drift apart. }
        if v_Stop_Form_Pct then
            v_Guard_Distance = Close * Stop_Pct / 100
        else
            v_Guard_Distance = AbsValue((v_Box_Top + v_Current_ATR * ATR_Stop_Mult) - Close);
        if SL_Pct > 0 then
            v_Guard_Distance = MinList(v_Guard_Distance, Close * SL_Pct / 100);
        SetStopLoss(v_Guard_Distance * BigPointValue);
    end;

    { Sub-Phase B: CS_Entry Execution (gated by Holiday Tail + Night Block) }
    { v17 Buffer_Form: how far below the box top the entry must sit. }
    if v_Buffer_Form_Pct then
        v_Trigger_Price = v_Box_Top * (1 - i_Buffer_Pct / 100)
    else
        v_Trigger_Price = v_Box_Top - (v_Current_ATR * i_Buffer_ATR_Mult);

    { v17 entry risk gate. Compute where the stop WOULD sit if this bar
      produced an entry, express it as a pct of price, and refuse the trade
      when it is too wide. This is what makes the worst case knowable BEFORE
      the order rather than after the fill. Max_Entry_Risk_Pct = 0 disables
      it entirely, which is the anchor setting. }
    if v_Stop_Form_Pct then
        v_Planned_Stop = Close * (1 + Stop_Pct / 100)
    else
        v_Planned_Stop = v_Box_Top + (ATR_Stop_Mult * v_Current_ATR);
    if SL_Pct > 0 then
        v_Planned_Stop = MinList(v_Planned_Stop, Close * (1 + SL_Pct / 100));
    if Close > 0 then
        v_Planned_Risk_Pct = (v_Planned_Stop - Close) / Close * 100
    else
        v_Planned_Risk_Pct = 999;
    v_Risk_OK = ( Max_Entry_Risk_Pct <= 0 or v_Planned_Risk_Pct <= Max_Entry_Risk_Pct );

    if MarketPosition    =  0             and
       v_BarsSinceExit  >= Cooldown_Bars  and
       v_Trend_Dir       = -1             and
       v_Macro_Block     = false          and
       v_In_Trap_Zone    = true           and
       Close             < v_Trigger_Price and
       v_Holiday_Block   = false          and
       v_Night_Block     = false          and
       v_Risk_OK         = true           and
       v_Settlement_Day  = false          then begin

        SellShort ("CS_Entry") next bar at Market;
        v_In_Trap_Zone = false;

        { v18 RESET: a fresh cycle. Any armed re-entry belonged to the
          previous cycle and must not survive into this one. }
        v_IsReEntry      = false;
        v_ReEntry_Chain  = 0;
        v_ReEntry_Armed  = false;
        v_ReEntry_Price  = 0;
        v_Frozen_SL_Orig = 0;

    end;

end;

{ DIAG level mirrors. Numeric input -> booleans, same idiom as Group R. }
v_Diag_NoDisarm = ( ReEntry_Diag >= 1 );
v_Diag_NoStruct = ( ReEntry_Diag >= 2 );
v_Diag_NoMacro  = ( ReEntry_Diag >= 3 );
v_Diag_AnyStop  = ( ReEntry_Diag >= 4 );
v_Diag_AnyFlat  = ( ReEntry_Diag >= 5 );

{ ==========================================
  Phase 2b: Re-entry state machine (v18)
  ==========================================
  TOP LEVEL ON PURPOSE. If this sat inside the
  "if v_is_in_consolidation and v_Box_Top > v_Box_Btm" block above, then
  the moment consolidation ended the block would stop running and
  v_ReEntry_Armed would be stuck True until the next consolidation, firing
  on a stale price. DISARM has to be reachable on every bar.

  It also has to run BEFORE the flat-reset block below, which wipes
  v_Trail_Active and v_Stop_Level state that ARM reads. }

{ (1) ARM. Only when the position just went flat on a STOP.
      ExitFired = 0 means no market exit was ordered on the last bar in
      position, so the resting stop order is what took us out.
      v_Trail_Active = false excludes trail exits: those are profit
      taking, not an interrupted trade (user ruling D-L4-1). }
if ReEntry_On = 1 and v_Prev_MP = -1 and MarketPosition = 0 and
   ( v_Diag_AnyFlat = true or ExitFired = 0 ) and
   ( v_Diag_AnyStop = true or v_Trail_Active = false ) and
   v_Last_EntryPrice > 0 and
   ( ReEntry_Max_Chain <= 0 or v_ReEntry_Chain < ReEntry_Max_Chain ) then begin
    v_ReEntry_Armed  = true;
    v_ReEntry_Price  = v_Last_EntryPrice;
    v_ReEntry_BoxTop = v_Locked_Top;
    v_ReEntry_BoxBtm = v_Locked_Btm;
    v_Frozen_SL_Orig = v_Stop_Level;
end;

{ (2) DISARM. The original box no longer contains price on the Data2
      close, either side. Upward is the CS_BreakExit condition: the
      false-breakout thesis is dead. Downward means the box is gone as a
      structure and a short there is a different trade.
      Tested BEFORE fire, so the fail-safe direction is no entry. }
if v_ReEntry_Armed = true and v_Diag_NoDisarm = false then begin
    if (Close of Data2 > v_ReEntry_BoxTop) or
       (Close of Data2 < v_ReEntry_BoxBtm) then begin
        v_ReEntry_Armed  = false;
        v_ReEntry_Price  = 0;
        v_Frozen_SL_Orig = 0;
    end;
end;

{ (3) FIRE. Price came back from the stop to the original entry price.
      The macro filter and every Rule #11 gate are re-checked, because a
      re-entry is still an entry. v_In_Trap_Zone is deliberately NOT
      required: that is the EVENT that opened the first trade, and
      requiring it would make this fire zero times -- the same result L1
      measured at ratio = 1.00.

      v_is_in_consolidation and v_Box_Top > v_Box_Btm are required for two
      reasons. Semantically they are part of "the original entry condition
      still holds". Mechanically they are the guard on the Phase 2 block,
      which is where v_Trigger_Price and v_Risk_OK are computed -- without
      them this could fire on a bar where that block never ran and both
      were stale from an earlier bar. }
if v_ReEntry_Armed = true and MarketPosition = 0 and
   Close            <= v_ReEntry_Price and
   ( v_Diag_NoStruct = true or
     ( v_is_in_consolidation = true and
       v_Box_Top > v_Box_Btm         and
       Close     < v_Trigger_Price   and
       v_Risk_OK = true ) )          and
   ( v_Diag_NoMacro = true or
     ( v_Trend_Dir = -1 and v_Macro_Block = false ) ) and
   v_Holiday_Block   = false           and
   v_Night_Block     = false           and
   v_Settlement_Day  = false           and
   ( ReEntry_Cooldown_On = 0 or v_BarsSinceExit >= Cooldown_Bars ) then begin

    SellShort ("CS_ReEntry") next bar at Market;
    v_IsReEntry     = true;
    v_ReEntry_Chain = v_ReEntry_Chain + 1;
    v_ReEntry_Armed = false;
end;

{ ==========================================
  Phase 3: Exit Logic and State Lock Defense
  ========================================== }

{ Snapshot box and reset tracking when flat }
if MarketPosition = 0 then begin
    if v_is_in_consolidation then begin
        v_Locked_Top = v_Box_Top;
        v_Locked_Btm = v_Box_Btm;
    end;
    v_Lowest_Low       = 999999;
    v_Trail_Active     = false;
    v_SL_Locked        = false;
    v_Frozen_ATR       = 0;
    v_Frozen_LockedTop = 0;
    v_Peak_Profit_Pts  = 0;
    v_BE_Armed         = false;
    v_SP_Armed         = false;
    v_BE_Floor         = 0;
    v_SP_Floor         = 0;
    v_SL_Pct_Ceil      = 0;
end;

if MarketPosition = -1 then begin

    { v18: remember what this position is, for a possible re-entry later.
      EntryPrice is not reliable once flat, and v_Stop_Level is only
      computed inside this block, so both are captured here every bar. }
    v_Last_EntryPrice = EntryPrice;

    { 1. Record Maximum Favorable Excursion }
    if Low < v_Lowest_Low then
        v_Lowest_Low = Low;

    { 2. Trailing Stop Activation }
    if v_Lowest_Low <= v_Locked_Btm then
        v_Trail_Active = true;

    { 3. v14.1 Freeze: lock ATR + LockedTop ONCE on entry bar }
    if Freeze_SL_On and v_SL_Locked = false then begin
        v_Frozen_ATR       = v_Current_ATR;
        v_Frozen_LockedTop = v_Locked_Top;
        v_SL_Locked        = true;
    end;

    { 4. Stop Level Calculation (v14.1 logic + v14.6 SL_Pct cap) }
    if v_Trail_Active then begin
        { Trail layer: by design uses CURRENT ATR to track volatility }
        if v_Trail_Form_Pct then
            v_Stop_Level = MinList(v_Stop_Level[1],
                v_Lowest_Low * (1 + Trail_Pct / 100))
        else
            v_Stop_Level = MinList(v_Stop_Level[1],
                v_Lowest_Low + (Trail_ATR_Mult * v_Current_ATR));
    end else begin
        if Freeze_SL_On then begin
            { Frozen path: ATR + Top locked at entry; no drift on reload }
            if v_Stop_Form_Pct then
                v_Stop_Level = EntryPrice * (1 + Stop_Pct / 100)
            else
                v_Stop_Level = v_Frozen_LockedTop + (ATR_Stop_Mult * v_Frozen_ATR);

            { v18 STOP INHERITANCE. Going flat cleared v_SL_Locked and
              v_Frozen_ATR, so the freeze above just re-locked on the
              CURRENT bar. Without this line a re-entry could carry a
              WIDER stop than the trade it resumes, which is the opposite
              of what the spec asks for. Lower = tighter for a short, so
              MinList keeps the tighter of the two. L1 v32 uses MaxList
              for the same rule on the long side. }
            if v_IsReEntry = true and v_Frozen_SL_Orig > 0 then
                v_Stop_Level = MinList(v_Stop_Level, v_Frozen_SL_Orig);
        end else begin
            { v14.0 dynamic path: ATR floats, Top ratchets down }
            v_Stop_Level = v_Locked_Top + (ATR_Stop_Mult * v_Current_ATR);
            if v_Box_Top < v_Locked_Top and v_Box_Top > 0 then
                v_Locked_Top = v_Box_Top;
        end;
    end;

    { v14.6: SL_Pct percentage stop cap (SHORT: ceiling above entry).
      Caps v_Stop_Level so max loss per trade never exceeds Entry x SL_Pct%.
      Applied after all stop paths (frozen/dynamic/trail) as universal safety net. }
    if SL_Pct > 0 then begin
        v_SL_Pct_Ceil = EntryPrice + (EntryPrice * SL_Pct / 100);
        v_Stop_Level = MinList(v_Stop_Level, v_SL_Pct_Ceil);
    end;

    { 5. v14.2 Path B: BE / SP arming + floor computation
         For SHORT positions:
           Profit = EntryPrice - Close (positive when price drops)
           BE floor = EntryPrice - BE_Offset_Pts (lock X pts profit)
           SP floor = EntryPrice - Peak * (1 - Retain/100)
         Both floors are LOWER than initial v_Stop_Level (which
         starts above entry). When applied via MinList, they
         tighten the buy-back price downward.

         Close-based arming (matches L1 StopProfit pattern).
         Once armed, never disarms until flat. }

    if EntryPrice - Close > v_Peak_Profit_Pts then
        v_Peak_Profit_Pts = EntryPrice - Close;

    if BE_Trigger_Pts > 0 and v_Peak_Profit_Pts >= BE_Trigger_Pts then
        v_BE_Armed = true;
    if SP_Trigger_Pts > 0 and v_Peak_Profit_Pts >= SP_Trigger_Pts then
        v_SP_Armed = true;

    if v_BE_Armed then
        v_BE_Floor = EntryPrice - BE_Offset_Pts;
    if v_SP_Armed then
        v_SP_Floor = EntryPrice -
            (v_Peak_Profit_Pts * (1 - SP_Retain_Pct / 100));

    { 6. Exit Chain with Priority Gates }
    ExitFired = 0;

    { Priority 0 - Manual Kill }
    if (ExitFired = 0) and Manual_Kill_Switch then begin
        BuyToCover ("CS_Kill") next bar at Market;
        ExitFired = 1;
    end;

    { Priority 0 - Registry Fail-Safe }
    if (ExitFired = 0) and v_Registry_Expired then begin
        BuyToCover ("CS_RegistryEnd") next bar at Market;
        ExitFired = 1;
    end;

    { Priority 0 - Holiday Iron Rule }
    if (ExitFired = 0) and v_Holiday_Block and
       (Time >= Holiday_Flat_Time) then begin
        BuyToCover ("CS_Holiday") next bar at Market;
        ExitFired = 1;
    end;

    { Priority 0 - Monthly Settlement Flat }
    if (ExitFired = 0) and v_Settlement_Day and
       (Time >= Settlement_Flat_Time) then begin
        BuyToCover ("CS_Settlement") next bar at Market;
        ExitFired = 1;
    end;

    { Priority 1 - Disaster Control: box failed + upward break }
    if (ExitFired = 0) and
       (v_is_in_consolidation = false) and
       (Close of Data2 > v_Locked_Top) then begin
        BuyToCover ("CS_BreakExit") next bar at Market;
        ExitFired = 1;
    end;

    { Priority 2 - Time stop (only if trail not yet active) }
    if (ExitFired = 0) and
       (v_Trail_Active = false) and
       (BarsSinceEntry >= Time_Stop_Bars) then begin
        BuyToCover ("CS_TimeExit") next bar at Market;
        ExitFired = 1;
    end;

    { Priority 3 - Labeled Stop order (CS_SP > CS_BE > CS_SL).
      Mutually exclusive: tightest binding floor wins the label.
      SP_Floor / BE_Floor only "bind" when they are lower than
      the original v_Stop_Level (lower = tighter for shorts). }

    v_Effective_Stop = v_Stop_Level;

    if v_SP_Armed = true and
       v_SP_Floor > 0 and v_SP_Floor < v_Effective_Stop then begin
        v_Effective_Stop = v_SP_Floor;
        BuyToCover ("CS_SP") next bar at v_Effective_Stop Stop;
    end else if v_BE_Armed = true and
                v_BE_Floor > 0 and v_BE_Floor < v_Effective_Stop then begin
        v_Effective_Stop = v_BE_Floor;
        BuyToCover ("CS_BE") next bar at v_Effective_Stop Stop;
    end else begin
        BuyToCover ("CS_SL") next bar at v_Effective_Stop Stop;
    end;

end;

{ CLAUDE.md Rule #8: v_Prev_MP is updated on the LAST line of the script,
  so every block above reads the PREVIOUS bar's position. The re-entry ARM
  test depends on it. }
v_Prev_MP = MarketPosition;
