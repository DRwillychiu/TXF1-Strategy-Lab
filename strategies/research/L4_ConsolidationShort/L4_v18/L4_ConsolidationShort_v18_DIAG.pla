    { ===== Group R: risk form switches (v17) =====
      NUMERIC on purpose. The MC12 optimizer does not list TrueFalse inputs
      at all, so anything that must be swept has to be a number.
      Every form ships at 1 = the v14.6 behaviour, so the anchor holds. }
    Buffer_Form            ( 1    ),  { 1 = Box_Top - ATR*mult ; 2 = Box_Top*(1-pct) }
    i_Buffer_Pct           ( 0.30 ),  { Form 2 only. PLACEHOLDER, sweep decides }
    Stop_Form              ( 1    ),  { 1 = LockedTop + ATR*mult ; 2 = Entry*(1+pct) }
    Stop_Pct               ( 0.60 ),  { Form 2 only. PLACEHOLDER. Measured loss
                                        distances were P50 0.41-0.53, max 1.50 }
    Trail_Form             ( 1    ),  { 1 = Low + ATR*mult ; 2 = Low*(1+pct) }
    Trail_Pct              ( 0.50 ),  { Form 2 only. PLACEHOLDER, sweep decides }
    Max_Entry_Risk_Pct     ( 0    ),  { 0 = gate off. >0 = refuse entries whose
                                        planned stop distance exceeds this pct
                                        of price. This is the leg that makes the
                                        loss knowable at entry.
