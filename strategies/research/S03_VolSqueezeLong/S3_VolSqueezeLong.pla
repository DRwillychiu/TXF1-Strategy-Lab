[IntrabarOrderGeneration = false]


{ ============================================================
  SECTION 1 - INPUTS
  v1.1 defaults = Phase 3 GA best (5 inputs locked, see CHANGELOG).
  All inputs MC12-optimizable; W4 Walk-Forward next, not parameter sweep.
  ============================================================ }

inputs:
    { ===== Bollinger Bands (核心 squeeze 偵測) ===== }
    BBLen                     ( 45    ),   { Phase 3 best; range 35..55 plateau confirmed }
    BBStd                     ( 2.0   ),   { Locked; not optimized this run }
    BWLookback                ( 120   ),   { Locked; not optimized this run }
    BWPctile                  ( 30    ),   { Phase 3 best; range 20..35 plateau confirmed }

    { ===== ATR (停損 / 停利 anchor) ===== }
    ATR_Len                   ( 14    ),   { Locked; not optimized this run }
    StopATRMult               ( 2.75  ),   { Phase 2 best plateau (P2 confirmed) }
    TargetATRMult             ( 8.0   ),   { Phase 3 best; UPPER EDGE (range 5.5..8.0), Mid exit 37% }

    { ===== Exit timing ===== }
    MaxBars                   ( 70    ),   { Phase 2 best plateau (P2 confirmed); 60M => 70hr cap }
    UseMidExit                ( True  ),   { mid-band exit on/off, A/B test }
    MidExit_MinBars           ( 3     ),   { min bars held before mid exit arms }

    { ===== Same-day cooldown ===== }
    Cooldown_Days             ( 1     ),   { cooldown days after exit, opt 0..3 }

    { ===== Priority 0 Protection (Rule #11 / #12) ===== }
    Holiday_Flat_Time         ( 415   ),   { 60M grid -> fire 04:15 holiday tail }
    Registry_Valid_Until      ( 1270101 ), { TAIFEX-verified horizon; bump each Q4 }
    Manual_Kill_Switch        ( False ),
    Settlement_Flat_Time      ( 1230  );   { 1hr buffer before 13:30 settlement }


{ ============================================================
  SECTION 2 - VARIABLES
  ============================================================ }

variables:
    { ===== Bollinger Bands ===== }
    v_MidBand                ( 0     ),
    v_UpperBand              ( 0     ),
    v_LowerBand              ( 0     ),
    v_BandWidth              ( 0     ),
    v_BWRank                 ( 0     ),
    v_BWCount                ( 0     ),
    v_Squeeze                ( False ),

    { ===== ATR ===== }
    v_ATR                    ( 0     ),
    v_StopDist               ( 0     ),
    v_TargetDist             ( 0     ),

    { ===== Trade state ===== }
    v_EntryBar               ( 0     ),
    v_Prev_MP                ( 0     ),

    { ===== Frozen SL (belt-and-suspenders Rule #12 backup) ===== }
    v_SL_Locked              ( False ),
    v_Frozen_ATR             ( 0     ),
    v_Frozen_SL_Dist         ( 0     ),
    v_SL_Level               ( 0     ),

    { ===== Cooldown ===== }
    v_LastExit_Date          ( 0     ),
    v_Cooldown_Active        ( False ),

    { ===== Priority 0 protection state ===== }
    v_Holiday_Block          ( False ),
    v_Registry_Expired       ( False ),
    v_Settlement_Day         ( False ),
    Registry_Warn_ID         ( -1    ),
    hidx                     ( 0     ),
    v_i                      ( 0     ),
    ExitFired                ( 0     );


{ ============================================================
  SECTION 3 - ARRAYS
  Holiday_Tail: shared 63-entry TAIFEX registry (byte-identical to L1-L5/S1/S3).
  ============================================================ }

arrays:
    Holiday_Tail[80]( 0 );


{ ============================================================
  SECTION 4 - HOLIDAY TAIL REGISTRY (TAIFEX-verified)
  Copied verbatim from L2_TrendShort.pla.
  Holiday_Tail = last trading day + 1 calendar day = the date stamped on
  the 00:00-05:00 tail bars of the final night session before each closure.
  ============================================================ }

if CurrentBar = 1 then begin

    { --- 2019 --- }
    Holiday_Tail[1]  = 1190913;
    Holiday_Tail[2]  = 1191010;
    Holiday_Tail[3]  = 1200101;

    { --- 2020 --- }
    Holiday_Tail[4]  = 1200121;  { CNY }
    Holiday_Tail[5]  = 1200228;  { 228 }
