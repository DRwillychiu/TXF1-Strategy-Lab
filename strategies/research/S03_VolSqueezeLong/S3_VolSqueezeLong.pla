    Holiday_Tail[54] = 1260212;  { CNY: final trading day 2/11 }
    Holiday_Tail[55] = 1260227;  { 228: 2/27 make-up, eve 2/26 }
    Holiday_Tail[56] = 1260403;  { Children/Tomb 4/3-4/6, eve 4/2 }
    Holiday_Tail[57] = 1260501;  { Labor Day 5/1-5/3, eve 4/30 }
    Holiday_Tail[58] = 1260619;  { Dragon Boat 6/19-6/21, eve 6/18 }
    Holiday_Tail[59] = 1260925;  { Mid-Autumn + Teachers 9/25-9/28, eve 9/24 }
    Holiday_Tail[60] = 1261009;  { National Day 10/9-10/11, eve 10/8 }
    Holiday_Tail[61] = 1261024;  { Retrocession 10/24-10/26, eve 10/23 }
    Holiday_Tail[62] = 1261225;  { Constitution 12/25-12/27, eve 12/24 }
    Holiday_Tail[63] = 1270101;  { 2027 New Year 1/1-1/3, eve 12/31 }

    { 2027 CNY onward: rebuild from TAIFEX 116-yr calendar in Q4 2026 }
end;


{ ============================================================
  SECTION 5 - HOLIDAY / REGISTRY / SETTLEMENT DETECTION
  Closed time interval: tail-bar scan bounded by Time < 500 (strict <
  per S1 v2.3 architectural rule, avoid Time=500 cross-holiday fill).
  Other Time>=X usages later are guarded by these state flags.
  ============================================================ }

v_Holiday_Block = False;

if Time < 500 then begin
    for hidx = 1 to 80 begin
        if Date = Holiday_Tail[hidx] then
            v_Holiday_Block = True;
    end;
end;

v_Registry_Expired = False;

if Date > Registry_Valid_Until then begin
    v_Registry_Expired = True;
    v_Holiday_Block    = True;
end;

{ Monthly Settlement detection (3rd Wed of month) }
v_Settlement_Day = ( DayOfWeek( Date ) = 3 ) and
                   ( DayOfMonth( Date ) >= 15 ) and
                   ( DayOfMonth( Date ) <= 21 );

{ Registry-expiry red warning, 30 days out }
if LastBarOnChart and
   DateToJulian( Date ) >= DateToJulian( Registry_Valid_Until ) - 30 then begin
    if Registry_Warn_ID < 0 then begin
        Registry_Warn_ID = Text_New( Date, Time, High + 400,
            "HOLIDAY REGISTRY EXPIRES " +
            NumToStr( Registry_Valid_Until, 0 ) +
            " - REBUILD FROM TAIFEX CALENDAR" );
        Text_SetColor( Registry_Warn_ID, Red );
        Text_SetSize( Registry_Warn_ID, 14 );
        Text_SetAttribute( Registry_Warn_ID, 1, True );
    end;
end;


{ ============================================================
  SECTION 6 - BOLLINGER BANDS + SQUEEZE DETECTION

  BBW = (Upper - Lower) / Mid * 100 (percent of price level)
  BWRank = % of past BWLookback bars where BBW > current BBW
         (low rank = current BBW is historically low = squeeze)
  Squeeze = BWRank <= BWPctile
  ============================================================ }

v_MidBand   = Average( Close, BBLen );
v_UpperBand = v_MidBand + BBStd * StandardDev( Close, BBLen, 1 );
v_LowerBand = v_MidBand - BBStd * StandardDev( Close, BBLen, 1 );

if v_MidBand > 0 then
    v_BandWidth = ( v_UpperBand - v_LowerBand ) / v_MidBand * 100
else
    v_BandWidth = 0;

{ Compute BWRank: count how many past BWLookback bars had wider BBW }
v_BWCount = 0;
for v_i = 1 to BWLookback begin
    if v_BandWidth[v_i] > v_BandWidth then
        v_BWCount = v_BWCount + 1;
end;
if BWLookback > 0 then
    v_BWRank = v_BWCount / BWLookback * 100
else
    v_BWRank = 100;

v_Squeeze = ( v_BWRank <= BWPctile );


{ ============================================================
  SECTION 7 - ATR + STOP / TARGET DISTANCES
  ============================================================ }

v_ATR        = AvgTrueRange( ATR_Len );
v_StopDist   = v_ATR * StopATRMult;
v_TargetDist = v_ATR * TargetATRMult;


{ ============================================================
  SECTION 8 - SAME-DAY COOLDOWN RESET
  Cooldown after exit prevents intra-day re-entry.
  Cleared when crossing a new trading day boundary.
  ============================================================ }

if Date <> v_LastExit_Date and
   v_LastExit_Date > 0 and
   DateToJulian( Date ) - DateToJulian( v_LastExit_Date ) >= Cooldown_Days then
    v_Cooldown_Active = False;


{ ============================================================
  SECTION 9 - FROZEN SL SETUP + SetStopLoss (Rule #12)

  Frozen SL: lock ATR + SL level on entry bar (belt-and-suspenders).
  SetStopLoss: MC engine guard, fires on entry bar without IOG dependency.
  Both use same ATR anchor (frozen on entry).

  Long variant: gate SetStopLoss on MP <= 0 (when flat or short).
  Freezes at signal-bar ATR once the long opens.
  ============================================================ }

{ Frozen SL setup (locks once per trade on entry bar) }
if MarketPosition = 1 then begin
    if v_SL_Locked = False then begin
        v_Frozen_ATR     = v_ATR;
        v_Frozen_SL_Dist = v_Frozen_ATR * StopATRMult;
        v_SL_Level       = EntryPrice - v_Frozen_SL_Dist;
        v_SL_Locked      = True;
    end;
end
else begin
    v_SL_Locked      = False;
    v_Frozen_ATR     = 0;
    v_Frozen_SL_Dist = 0;
    v_SL_Level       = 0;
end;

{ SetStopLoss engine guard (shares frozen ATR once locked) }
if v_SL_Locked = True then
    v_StopDist = v_Frozen_SL_Dist;

if MarketPosition <= 0 then
    SetStopLoss( v_StopDist * BigPointValue );


{ ============================================================
  SECTION 10 - ENTRY LOGIC (Long-only per R-6 split)

  Gates (all must be true):
    - Flat (MP = 0)
    - v_Squeeze = True              (BBW historically compressed)
    - Close > v_UpperBand           (upward breakout confirmation)
    - Not on cooldown
    - Not on a holiday tail bar
    - Not on a settlement day
    - Not registry expired

  Closed-interval safety: no isolated Time>=X conditions in entry block.
  All time-related gates are state-flag based (v_Holiday_Block / v_Settlement_Day).
  ============================================================ }

if ( MarketPosition = 0 ) and
   ( v_Squeeze = True ) and
   ( Close > v_UpperBand ) and
   ( v_Cooldown_Active = False ) and
   ( v_Holiday_Block = False ) and
   ( v_Settlement_Day = False ) and
   ( v_Registry_Expired = False ) then begin
    buy( "LE_VS_Entry" ) next bar at Market;
    v_EntryBar = BarNumber;
end;


{ ============================================================
  SECTION 11 - EXIT CHAIN (Priority 0 first)

  PRIORITY ORDER (per CLAUDE.md Rule #11 Settlement_Flat):
    P0-1  LX_VS_Kill          (Manual_Kill_Switch)
    P0-2  LX_VS_RegistryEnd   (registry expired)
    P0-3  LX_VS_HolFlat       (holiday tail + Holiday_Flat_Time)
    P0-4  LX_VS_Settlement    (settlement day + Settlement_Flat_Time)
    S-1   LX_VS_TP            (ATR × 3 target, limit)
    S-2   LX_VS_Mid           (mid-band exit, ≥3 bars after entry)
    S-3   LX_VS_TimeStop      (40 bars max hold)
    S-4   LX_VS_SL            (Frozen SL backup, BuyToCover at v_SL_Level Stop)
    (SL primary handled by SetStopLoss engine in Section 9)

  CLOSED-INTERVAL AUDIT:
    Holiday_Flat_Time : guarded by v_Holiday_Block + explicit Time <= 455
    Settlement_Flat_Time : guarded by v_Settlement_Day + bounded by day session
    No isolated Time>=X without pair or state-guard.
  ============================================================ }

ExitFired = 0;

if MarketPosition = 1 then begin

    { ---- P0-1 Manual kill switch ---- }
    if ( ExitFired = 0 ) and ( Manual_Kill_Switch = True ) then begin
        sell( "LX_VS_Kill" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- P0-2 Registry fail-safe ---- }
    if ( ExitFired = 0 ) and ( v_Registry_Expired = True ) then begin
        sell( "LX_VS_RegistryEnd" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- P0-3 Holiday iron rule (state-guarded + closed interval) ---- }
    if ( ExitFired = 0 ) and
       ( v_Holiday_Block = True ) and
       ( Time >= Holiday_Flat_Time ) and
       ( Time <= 455 ) then begin
        sell( "LX_VS_HolFlat" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- P0-4 Settlement flat (state-guarded) ---- }
    if ( ExitFired = 0 ) and
       ( v_Settlement_Day = True ) and
       ( Time >= Settlement_Flat_Time ) then begin
        sell( "LX_VS_Settlement" ) next bar at Market;
        ExitFired = 1;
    end;

    { ---- Strategy exits ---- }
    if ExitFired = 0 then begin

        { S-1: TP at ATR × 3 (limit, favorable to long = higher price) }
        sell( "LX_VS_TP" ) next bar at EntryPrice + v_TargetDist limit;

        { S-2: Mid-band exit (only after MidExit_MinBars bars) }
        if UseMidExit = True and
           BarNumber - v_EntryBar >= MidExit_MinBars and
           Close < v_MidBand then begin
            sell( "LX_VS_Mid" ) next bar at Market;
            ExitFired = 1;
        end;

        { S-3: Time stop }
        if ExitFired = 0 and
           BarNumber - v_EntryBar >= MaxBars then begin
            sell( "LX_VS_TimeStop" ) next bar at Market;
            ExitFired = 1;
        end;

        { S-4: Frozen SL backup (belt+suspenders with Section 9 SetStopLoss) }
        if ExitFired = 0 and v_SL_Locked = True then
            sell( "LX_VS_SL" ) next bar at v_SL_Level Stop;

    end;

end;


{ ============================================================
  SECTION 12 - COOLDOWN SET ON EXIT
  Any exit fired this bar -> cooldown until cooldown_days elapsed.
  Tracked via v_LastExit_Date and Section 8 reset logic.
  ============================================================ }

if v_Prev_MP = 1 and MarketPosition <> 1 then begin
    v_Cooldown_Active = True;
    v_LastExit_Date   = Date;
end;


{ ============================================================
  SECTION 13 - PREV_MP TRACKING (last line, per Rule #8)
  ============================================================ }

v_Prev_MP = MarketPosition;


{ ============================================================
  END OF FILE - S3_VolSqueezeLong.pla  v1.0

  TIME-SAFETY VERIFICATION (closed-interval audit):
    Section 5  if Time < 500           OK upper-bounded (strict <)
    Section 11 Holiday_Flat_Time       guarded by v_Holiday_Block AND
                                       paired with Time <= 455  OK
    Section 11 Settlement_Flat_Time    guarded by v_Settlement_Day
                                       (date-scoped, day session bounded) OK
    No bare Time >= X without a pair or state-guard.

  RULE COMPLIANCE CHECKLIST:
    [X] Rule #11 Settlement_Flat 7 elements (v_Settlement_Day, DayOfWeek=3,
        DayOfMonth 15-21, Settlement_Flat_Time input, Priority 0 chain,
        entry gate, label LX_VS_Settlement)
    [X] Rule #12 P3b SetStopLoss (single call, MP<=0 guard, ATR anchor,
        called before entry block, BigPointValue formula)
    [X] Rule #13 10-dim eval: deferred to W5 (post backtest)
    [X] Rule #14 OFFICIAL_ROADMAP alignment: S3_L is next in sequence
    [X] HolidayFlat_v3: 63-entry registry + Holiday_Flat_Time + state guard
    [X] IntrabarOrderGeneration = false (declared at top)
    [X] Manual_Kill_Switch + Registry_Valid_Until inputs present
    [X] MC Time 24-hour closed-interval (Time < 500 strict + paired bounds)
    [X] R-6 split: Long-only (no Short labels, no sell short, no buy to cover)
    [X] Label convention LE_VS_/LX_VS_

  R-6 SPLIT NOTE:
    Original archive S3 VolSqueeze was bi-directional.
    This file is the LONG version (Sx_L per OFFICIAL_ROADMAP).
    Short version (S3_S VolSqueezeShort) to be created after S3_L complete
    (W6 promotion or FINAL_VERDICT KILL).
============================================================ }
