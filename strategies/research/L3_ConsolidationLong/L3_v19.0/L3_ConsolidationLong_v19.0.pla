    { 2024 } Holiday_Tail[35] = 1240206;  Holiday_Tail[36] = 1240228;
    Holiday_Tail[37] = 1240404;  Holiday_Tail[38] = 1240501;
    Holiday_Tail[39] = 1240608;  Holiday_Tail[40] = 1240917;
    Holiday_Tail[41] = 1241010;  Holiday_Tail[42] = 1250101;
    { 2025 } Holiday_Tail[43] = 1250123;  Holiday_Tail[44] = 1250228;
    Holiday_Tail[45] = 1250403;  Holiday_Tail[46] = 1250501;
    Holiday_Tail[47] = 1250530;  Holiday_Tail[48] = 1250927;
    Holiday_Tail[49] = 1251004;  Holiday_Tail[50] = 1251010;
    Holiday_Tail[51] = 1251024;  Holiday_Tail[52] = 1251225;
    Holiday_Tail[53] = 1260101;
    { 2026 (verified: TAIFEX official 115-yr calendar) }
    Holiday_Tail[54] = 1260212;  Holiday_Tail[55] = 1260227;
    Holiday_Tail[56] = 1260403;  Holiday_Tail[57] = 1260501;
    Holiday_Tail[58] = 1260619;  Holiday_Tail[59] = 1260925;
    Holiday_Tail[60] = 1261009;  Holiday_Tail[61] = 1261024;
    Holiday_Tail[62] = 1261225;  Holiday_Tail[63] = 1270101;
end;

v_Holiday_Block = false;

if Time <= 500 then begin
    for hidx = 1 to 80 begin
        if Date = Holiday_Tail[hidx] then
            v_Holiday_Block = true;
    end;
end;

v_Registry_Expired = false;

if Date > Registry_Valid_Until then begin
    v_Registry_Expired = true;
    v_Holiday_Block    = true;
end;

v_Settlement_Day = (DayOfWeek(Date) = 3) and
                   (DayOfMonth(Date) >= 15) and
                   (DayOfMonth(Date) <= 21);

if LastBarOnChart and
   DateToJulian(Date) >= DateToJulian(Registry_Valid_Until) - 30 then begin
    if Registry_Warn_ID < 0 then begin
        Registry_Warn_ID = Text_New(Date, Time, High + 400,
            "HOLIDAY REGISTRY EXPIRES " +
            NumToStr(Registry_Valid_Until, 0) +
            " - REBUILD FROM TAIFEX CALENDAR");
        Text_SetColor(Registry_Warn_ID, Red);
        Text_SetSize(Registry_Warn_ID, 14);
        Text_SetAttribute(Registry_Warn_ID, 1, true);
    end;
end;

{ ==========================================
  1. Commander Logic (Data2 - 60M Box Detection)
  ========================================== }

v_Ref_High   = Highest(High, Lookback_Bars)[1] of Data2;
v_Ref_Low    = Lowest(Low,   Lookback_Bars)[1] of Data2;
v_Curr_Range = (High of Data2) - (Low of Data2);
v_Ref_Range  = v_Ref_High - v_Ref_Low;

v_60M_MA = Average(Close, MA_Len) of Data2;

if Close of Data2 > v_60M_MA then
    v_Trend_Dir = 1
else
    v_Trend_Dir = -1;

{ ==========================================
  R2 (2026-09-24): consolidation is decided FIRST on the 15M window,
  the box edges are taken from that window only afterwards.
  Box_New_On = false reproduces the original detection exactly.
  ========================================== }
if Box_New_On = false then begin

    if (High of Data2 <= v_Ref_High) and (Low of Data2 >= v_Ref_Low) then begin
        if v_Ref_Range > 0 and (v_Curr_Range / v_Ref_Range <= Range_Shrink_Rate) then begin
            v_is_in_consolidation = true;
            v_Box_Top = v_Ref_High;
            v_Box_Btm = v_Ref_Low;
        end;
    end;

end else begin

    { --- step 1: window extremes on 15M --- }
    v_Win_Hi = Highest(High, Consol_Bars_15M);
    v_Win_Lo = Lowest(Low, Consol_Bars_15M);
    v_Win_Rng = v_Win_Hi - v_Win_Lo;

    v_Consol_New = false;
    if v_Win_Rng > 0 then begin

        { --- step 2: no trend inside the window (net move small vs range) --- }
        v_Drift = AbsValue(Close - Close[Consol_Bars_15M - 1]);
        if v_Drift <= v_Win_Rng * Consol_Drift_Pct / 100 then begin

            { --- step 3: edges, optionally ignoring a single-bar wick --- }
            v_Top_New = v_Win_Hi;
            v_Btm_New = v_Win_Lo;
            if Box_NoWick then begin
                v_hb = 0; v_lb = 0;
                v_Hi2 = v_Win_Lo; v_Lo2 = v_Win_Hi;
                for v_i = 0 to Consol_Bars_15M - 1 begin
                    if High[v_i] >= v_Win_Hi then v_hb = v_hb + 1
                    else if High[v_i] > v_Hi2 then v_Hi2 = High[v_i];
                    if Low[v_i] <= v_Win_Lo then v_lb = v_lb + 1
                    else if Low[v_i] < v_Lo2 then v_Lo2 = Low[v_i];
                end;
                if v_hb = 1 then v_Top_New = v_Hi2;
                if v_lb = 1 then v_Btm_New = v_Lo2;
            end;

            { --- step 4: both edges must be tested Box_Touch_Min times --- }
            v_HiCnt = 0; v_LoCnt = 0;
            v_Touch_Tol = (v_Top_New - v_Btm_New) * Box_Touch_Tol_Pct / 100;
            if v_Touch_Tol < 0 then v_Touch_Tol = 0;
            for v_i = 0 to Consol_Bars_15M - 1 begin
                if High[v_i] >= v_Top_New - v_Touch_Tol then v_HiCnt = v_HiCnt + 1;
                if Low[v_i] <= v_Btm_New + v_Touch_Tol then v_LoCnt = v_LoCnt + 1;
            end;

            if v_Top_New > v_Btm_New and
               (Box_Touch_Min <= 0 or (v_HiCnt >= Box_Touch_Min and v_LoCnt >= Box_Touch_Min)) then
                v_Consol_New = true;
        end;
    end;

    if v_Consol_New then begin
        if v_is_in_consolidation = false or v_Box_Top <> v_Top_New or v_Box_Btm <> v_Btm_New then
            v_Box_Age = 0;
        v_is_in_consolidation = true;
        v_Box_Top = v_Top_New;
        v_Box_Btm = v_Btm_New;
    end;

end;

if v_is_in_consolidation then v_Box_Age = v_Box_Age + 1;

if v_is_in_consolidation then begin
    if Box_New_On = false then begin
        if (Close of Data2 > v_Box_Top) or (Close of Data2 < v_Box_Btm) then
            v_is_in_consolidation = false;
    end else begin
        if (Close > v_Box_Top) or (Close < v_Box_Btm) then begin
            v_is_in_consolidation = false;
            v_Box_Age = 0;
        end;
    end;
end;

{ ==========================================
  2. V14 Box Qualification Matrix (Dim 1)
  ========================================== }

v_Current_ATR = AvgTrueRange(ATR_Length);

{ v18: previous CLOSED daily range as a percentage of its close. [1] = the last
  finished daily bar, so there is no lookahead. }
v_PrevDayRngPct = 0;
if (Close of Data3)[1] > 0 then
    v_PrevDayRngPct = ((High of Data3)[1] - (Low of Data3)[1]) / (Close of Data3)[1] * 100;

{ v18: day-session block. MC bar Time is the bar CLOSE time, so the day
  session covers 0900..1345 on a 15M chart. }
v_Day_Block = false;
if Night_Only then begin
    if Time >= 900 and Time <= 1345 then v_Day_Block = true;
end;

{ v19: entry spacing. Minutes run on the calendar (DateToJulian), so nights,
  weekends and holidays count as elapsed time. A new entry is detected when the
  number of positions ever opened rises (closed trades + the open one), which
  also catches a trade that opens and closes inside a single bar. }
v_Now_Min = DateToJulian(Date) * 1440 + IntPortion(Time / 100) * 60 + Mod(Time, 100);
v_Entry_Cnt = TotalTrades + AbsValue(MarketPosition);
if v_Entry_Cnt > v_Prev_Entry_Cnt then v_Last_Entry_Min = v_Now_Min;
v_Prev_Entry_Cnt = v_Entry_Cnt;
v_Gap_Block = false;
if Min_Gap_Hrs > 0 then begin
    if v_Now_Min - v_Last_Entry_Min < Min_Gap_Hrs * 60 then v_Gap_Block = true;
end;

{ v19: target choice. Target_Mode 0 keeps the v18 coupling exactly. }
v_Tgt_Room = (Target_Mode = 2) or (Target_Mode = 0 and Stop_New_On);

{ --- R2 final: reward / risk ratio follows volatility ---
  Both windows are measured on Data4 (weekly), so the ratio needs no unit
  conversion. Lookback = RR_Vol_Wks + RR_Base_Wks = 56 weekly bars, which is
  inside the MaxBarsBack 100 limit. [1] = last CLOSED weekly bar, no lookahead. }
v_Wk_Now  = 0;
v_Wk_Base = 0;
v_RR = RR_Base;
if RR_Vol_Wks > 0 and RR_Base_Wks > 0 then begin
    v_Wk_Now  = Average((High of Data4 - Low of Data4) / Close of Data4 * 100, RR_Vol_Wks)[1];
    v_Wk_Base = Average((High of Data4 - Low of Data4) / Close of Data4 * 100, RR_Base_Wks)[1];
    if v_Wk_Base > 0 then v_RR = RR_Base * v_Wk_Now / v_Wk_Base;
end;
if v_RR < RR_Min then v_RR = RR_Min;
if v_RR > RR_Max then v_RR = RR_Max;

{ --- Qual_Mode 4 legacy yardstick (kept so old modes still run) --- }
v_Wk_Rng = 0;
if Qual_Wk_Days > 0 then
    v_Wk_Rng = Average(High of Data3 - Low of Data3, Qual_Wk_Days)[1];

v_Box_Range    = 0;
v_Box_Qualified = false;
v_Mid_Line     = 0;
v_Support_Zone = 0;
v_ATR_Buffer   = ATR_Stop_Mult * v_Current_ATR;

if v_is_in_consolidation and v_Box_Top > v_Box_Btm then begin
    v_Box_Range = v_Box_Top - v_Box_Btm;
    v_Mid_Line  = (v_Box_Top + v_Box_Btm) / 2;

    { --- R2b: qualification yardstick --- }
    v_Box_ATRx  = 0;
    v_Box_Pct   = 0;
    v_Box_Costx = 0;
    if v_Current_ATR > 0 then v_Box_ATRx = v_Box_Range / v_Current_ATR;
    if v_Box_Btm > 0 then v_Box_Pct = v_Box_Range / v_Box_Btm * 100;
    if Cost_Pts_RT > 0 then v_Box_Costx = v_Box_Range / Cost_Pts_RT;

    v_Box_Wkx = 0;
    if v_Wk_Rng > 0 then v_Box_Wkx = v_Box_Range / v_Wk_Rng;

    v_Qual_Need = 0;
    v_Qual_Need2 = 0;
    v_Need_W = 0;
    if Qual_New_On then begin
        { R2 final: the only gate is box width >= RR x Risk_Pct.
          Independent switch so the box rules can be tested on their own. }
        v_Need_W = v_Box_Btm * v_RR * Risk_Pct / 100;
        if v_Box_Range >= v_Need_W then v_Box_Qualified = true;
        v_Qual_Need = v_Need_W;
    end
    else if Qual_Mode = 4 then begin
        v_Qual_Need  = Qual_Wk_Mult * v_Wk_Rng;
        v_Qual_Need2 = Qual_Cost_Mult * Cost_Pts_RT;
        v_Pass1 = (v_Wk_Rng > 0) and (v_Box_Range >= v_Qual_Need);
        v_Pass2 = (v_Box_Range >= v_Qual_Need2);
        if v_Pass1 and v_Pass2 then v_Box_Qualified = true;
    end
    else if Qual_Mode = 2 then begin
        v_Qual_Need = v_Box_Btm * Qual_Pct / 100;
        if v_Box_Range >= v_Qual_Need then v_Box_Qualified = true;
    end
    else if Qual_Mode = 3 then begin
        v_Qual_Need = Qual_Cost_Mult * Cost_Pts_RT;
        if v_Box_Range >= v_Qual_Need then v_Box_Qualified = true;
    end
    else begin
        v_Qual_Need = Qual_ATR_Mult * v_Current_ATR;
        if v_Current_ATR > 0 and v_Box_Range >= v_Qual_Need then v_Box_Qualified = true;
    end;

    { --- diagnostic: log EVERY box that forms, qualified or not --- }
    v_Qual_Flag = 0;
    if v_Box_Qualified then v_Qual_Flag = 1;
    if Qual_Log_On and v_Box_Top <> v_Prev_BoxTop then begin
        Print( "L3_QUAL,", Date:7:0, ",", Time:4:0, ",",
               v_Box_Btm:6:0, ",", v_Box_Top:6:0, ",", v_Box_Range:6:0, ",",
               v_Box_Pct:5:2, ",", v_Box_ATRx:5:1, ",", v_Box_Costx:6:1, ",",
               v_Current_ATR:6:1, ",", v_Wk_Rng:6:0, ",", v_Box_Wkx:5:2, ",",
               v_Qual_Need:6:0, ",", v_Qual_Flag:1:0 );
        v_Prev_BoxTop = v_Box_Top;
    end;

    v_Support_Zone = v_Box_Btm + v_Box_Range * Entry_Zone_Pct;
end;

{ ==========================================
  3. Data3 Filter Logic (Daily)
  ========================================== }

v_Daily_MA_Fast = Average(Close, Daily_MA_Fast) of Data3;
v_Daily_MA_Slow = Average(Close, Daily_MA_Slow) of Data3;

if (Close of Data3 > v_Daily_MA_Fast) or
   (Close of Data3 > v_Daily_MA_Slow) then
    v_Daily_Filter = true
else
    v_Daily_Filter = false;

{ ==========================================
  4. Execution Block (requires active box, NOT box qualification)
  Entry is gated by v_Box_Qualified; exit only needs active box.
  BreakExit fires ONLY on true box break (not ATR-ratio drift).
  ========================================== }

if v_is_in_consolidation and v_Box_Top > v_Box_Btm then begin

    { P3b Immediate Stop Guard (Rule #12)
      V15: SetStopContract makes amount per-CONTRACT (lot-invariant).
      V15: SL_Pct caps the engine stop distance as percentage of Close.
      MinList of distances = tightest stop (same logic as L1 V3.1). }
    SetStopContract;
    if v_Box_Qualified and MarketPosition <= 0 then begin
        if Stop_New_On then begin
            v_SL_Distance = Close * v_PrevDayRngPct * Stop_Day_Pct / 10000;
            if v_SL_Distance < Stop_Min_Pts then v_SL_Distance = Stop_Min_Pts;
        end else begin
            v_SL_Distance = AbsValue(Close - (v_Box_Btm - v_ATR_Buffer));
            if SL_Pct > 0 then
                v_SL_Distance = MinList(v_SL_Distance, Close * SL_Pct / 100);
        end;
        SetStopLoss(v_SL_Distance * BigPointValue);
    end;

    { --- V15 Opening Volatility Filter --- }
    v_Opening_Block = false;
    if Open_Block_End > 0 then begin
        if Time = 500 then v_Opening_Block = true;
        if Time >= 900 and Time < Open_Block_End then v_Opening_Block = true;
    end;

    { --- R2 (2026-09-24): proportional stop, per-trade floor / cap, entry shift.
          All divisions are guarded: v_Box_Btm > 0 is checked before use. --- }
    v_Entry_Px  = v_Box_Btm;
    v_Stop_Px   = 0;
    v_Stop_Dist = 0;
    v_Target_Px = 0;
    v_Plan_RR   = 0;

    v_RR_Qualified = true;
    if Stop_New_On = false and Qual_New_On then begin
        { new gate already applied on box width; skip the legacy Min_RR test }
        v_RR_Qualified = true;
    end
    else if Stop_New_On then begin
        { v18: stop follows yesterday's range (noise scale), floored by friction;
          target takes a fixed share of the room left above the entry. }
        if v_Box_Btm > 0 then begin
            v_Stop_Floor = v_Box_Btm * v_PrevDayRngPct * Stop_Day_Pct / 10000;
            if v_Stop_Floor < Stop_Min_Pts then v_Stop_Floor = Stop_Min_Pts;
            v_Stop_Dist = v_Stop_Floor;
            v_Stop_Px   = v_Box_Btm - v_Stop_Dist;
            v_Target_Px = v_Box_Btm + (v_Box_Top - v_Box_Btm) * Target_Room_Pct / 100;
            if v_Stop_Dist > 0 then
                v_Plan_RR = (v_Target_Px - v_Box_Btm) / v_Stop_Dist;
        end;
        if v_Stop_Dist <= 0 or v_Target_Px <= v_Box_Btm or v_Target_Px > v_Box_Top then
            v_RR_Qualified = false;
        { the box must be at least Min_RR stops wide, measured against the NEW stop }
        if Min_RR > 0 and v_Stop_Dist > 0 and v_Box_Range < Min_RR * v_Stop_Dist then
            v_RR_Qualified = false;
    end else begin
        if Min_RR > 0 and SL_Pct > 0 and v_Box_Range > 0 then begin
            if v_Box_Range < Min_RR * v_Box_Btm * SL_Pct / 100 then
                v_RR_Qualified = false;
        end;
    end;

    { v19: position size from risk. The planned stop distance is the one the
      exit block will freeze: the new stop when Stop_New_On, otherwise the
      tighter of the ATR buffer and SL_Pct, both measured from the box bottom
      where the buy stop sits. Cost_Pts_RT adds the round-trip cost per lot. }
    v_Lots = 1;
    if Stop_New_On then
        v_Plan_Stop_Pts = v_Stop_Dist
    else begin
        v_Plan_Stop_Pts = v_ATR_Buffer;
        if SL_Pct > 0 and v_Box_Btm > 0 then
            v_Plan_Stop_Pts = MinList(v_ATR_Buffer, v_Box_Btm * SL_Pct / 100);
    end;
    v_Risk_Per_Lot = (v_Plan_Stop_Pts + Cost_Pts_RT) * BigPointValue;
    v_Risk_Budget  = 0;
    if Size_Mode > 0 and v_Risk_Per_Lot > 0 then begin
        v_Risk_Budget = Acct_Capital * Risk_Acct_Pct / 100;
        if Size_Mode = 2 then
            v_Risk_Budget = (Acct_Capital + NetProfit) * Risk_Acct_Pct / 100;
        v_Lots = IntPortion(v_Risk_Budget / v_Risk_Per_Lot);
        if v_Lots > Max_Lots then v_Lots = Max_Lots;
        if v_Lots < 1 then v_Lots = 1;
    end;

    { --- V14 Entry (Dim 2: Unified Support Zone) --- }
    if v_Box_Qualified and MarketPosition = 0 then begin
        if (v_Trend_Dir = 1) and
           (v_Daily_Filter = true) and
           (v_Holiday_Block = false) and
           (v_Settlement_Day = false) and
           (v_Opening_Block = false) and
           (v_Day_Block = false) and
           (v_Gap_Block = false) and
           (v_RR_Qualified = true) then begin

            if Stop_New_On then begin
                if (Close < v_Support_Zone) and (Close > v_Stop_Px) then begin
                    if Box_Log_On and v_Entry_Px > 0 and v_Box_Btm > 0 then
                        Print( "L3_BOX,", Date:7:0, ",", Time:4:0, ",",
                               v_Box_Top:6:0, ",", v_Box_Btm:6:0, ",",
                               v_Box_Range:6:0, ",",
                               (v_Box_Range / v_Box_Btm * 100):5:2, ",",
                               v_Box_Age:4:0, ",", v_HiCnt:3:0, ",", v_LoCnt:3:0, ",",
                               v_hb:3:0, ",", v_lb:3:0, ",",
                               v_Entry_Px:6:0, ",", v_Stop_Px:6:0, ",",
                               v_Stop_Dist:6:0, ",",
                               (v_Stop_Dist / v_Entry_Px * 100):5:2, ",",
                               v_Plan_RR:5:2, ",", v_Target_Px:6:0, ",",
                               v_Need_W:6:0, ",", v_Wk_Now:5:2, ",", v_Wk_Base:5:2 );
                    if v_Rule_Allow then begin
                        if v_Skip_Next then v_R_Shadow = v_Entry_Px
                        else begin
                            if Size_Mode = 0 then
                                Buy ("CL_Entry") next bar at v_Entry_Px Stop
                            else begin
                                Buy ("CL_Entry") v_Lots contracts next bar at v_Entry_Px Stop;
                                if Box_Log_On then
                                    Print( "L3_SIZE,", Date:7:0, ",", Time:4:0, ",", v_Lots:3:0, ",",
                                           v_Plan_Stop_Pts:6:0, ",", v_Risk_Per_Lot:8:0, ",", v_Risk_Budget:9:0 );
                            end;
                        end;
                    end;
                    { log: box, risk, reward, gate }
                end;
            end else begin
                if (Close < v_Support_Zone) and
                   (Close > v_Box_Btm - v_ATR_Buffer) then
                    if v_Rule_Allow then begin
                        if v_Skip_Next then v_R_Shadow = v_Box_Btm
                        else begin
                            if Size_Mode = 0 then
                                Buy ("CL_Entry") next bar at v_Box_Btm Stop
                            else begin
                                Buy ("CL_Entry") v_Lots contracts next bar at v_Box_Btm Stop;
                                if Box_Log_On then
                                    Print( "L3_SIZE,", Date:7:0, ",", Time:4:0, ",", v_Lots:3:0, ",",
                                           v_Plan_Stop_Pts:6:0, ",", v_Risk_Per_Lot:8:0, ",", v_Risk_Budget:9:0 );
                            end;
                        end;
                    end;
            end;

        end;
    end;

    { --- V14 Exit (Dim 3: Dynamic Target) --- }
    if MarketPosition = 1 then begin

        if Freeze_SL_On = true then begin
            if v_SL_Locked = false then begin
                if Stop_New_On then begin
                    v_Stop_Floor = EntryPrice * v_PrevDayRngPct * Stop_Day_Pct / 10000;
                    if v_Stop_Floor < Stop_Min_Pts then v_Stop_Floor = Stop_Min_Pts;
                    v_Frozen_SL = EntryPrice - v_Stop_Floor;
                end else begin
                    v_Frozen_SL = v_Box_Btm - v_ATR_Buffer;

                    { V15: SL_Pct percentage leg (dual-layer frozen SL).
                      MaxList picks the highest price = tightest for long. }
                    if SL_Pct > 0 then begin
                        v_SL_Pct_Floor = EntryPrice - (EntryPrice * SL_Pct / 100);
                        v_Frozen_SL = MaxList(v_Frozen_SL, v_SL_Pct_Floor);
                    end;
                end;

                if v_Tgt_Room then begin
                    v_Frozen_Target = EntryPrice + (v_Box_Top - EntryPrice) * Target_Room_Pct / 100;
                    if v_Frozen_Target <= EntryPrice then v_Frozen_Target = v_Box_Top;
                end else begin
                    v_Swing_High = Highest(High, Swing_Lookback);
                    v_Frozen_Target = MinList(v_Swing_High, v_Box_Top);
                    if v_Frozen_Target < v_Mid_Line + v_Current_ATR then
                        v_Frozen_Target = v_Box_Top;
                end;

                v_SL_Locked = true;
            end;

            v_Work_SL     = v_Frozen_SL;
            v_Work_Target = v_Frozen_Target;

        end else begin
            if Stop_New_On then begin
                v_Stop_Floor = EntryPrice * v_PrevDayRngPct * Stop_Day_Pct / 10000;
                if v_Stop_Floor < Stop_Min_Pts then v_Stop_Floor = Stop_Min_Pts;
                v_Work_SL = EntryPrice - v_Stop_Floor;
            end else begin
                v_Work_SL     = v_Box_Btm - v_ATR_Buffer;

                { V15: SL_Pct percentage leg (non-frozen path) }
                if SL_Pct > 0 then begin
                    v_SL_Pct_Floor = EntryPrice - (EntryPrice * SL_Pct / 100);
                    v_Work_SL = MaxList(v_Work_SL, v_SL_Pct_Floor);
                end;
            end;

            if v_Tgt_Room then begin
                v_Work_Target = EntryPrice + (v_Box_Top - EntryPrice) * Target_Room_Pct / 100;
                if v_Work_Target <= EntryPrice then v_Work_Target = v_Box_Top;
            end else begin
                v_Swing_High  = Highest(High, Swing_Lookback);
                v_Work_Target = MinList(v_Swing_High, v_Box_Top);
                if v_Work_Target < v_Mid_Line + v_Current_ATR then
                    v_Work_Target = v_Box_Top;
            end;
        end;

        { BE layer (disabled by default, kept for compat) }
        v_BE_IsFloor = false;
        if BE_Trigger_Pts > 0 then begin
            if (Close - EntryPrice) >= BE_Trigger_Pts then
                v_BE_Armed = true;
            if v_BE_Armed and
               (EntryPrice + BE_Offset_Pts > v_Work_SL) then begin
                v_Work_SL    = EntryPrice + BE_Offset_Pts;
                v_BE_IsFloor = true;
            end;
        end;

        { Exit orders }
        Sell ("CL_TP") next bar at v_Work_Target Limit;

        if v_BE_IsFloor then
            Sell ("CL_BE") next bar at v_Work_SL Stop
        else
            Sell ("CL_SL") next bar at v_Work_SL Stop;

    end;

end else begin
    { ==========================================
      5. True Box Break Exit (consolidation ended)
      ========================================== }
    if MarketPosition = 1 then
        Sell ("CL_BreakExit") next bar at Market;
end;

{ ==========================================
  6. Safety Exits (Priority 0, always active)
  ========================================== }

if MarketPosition = 1 then begin

    if v_Registry_Expired then
        Sell ("CL_RegistryEnd") next bar at Market
    else if v_Holiday_Block and Time >= Holiday_Flat_Time then
        Sell ("CL_Holiday") next bar at Market
    else if v_Settlement_Day and Time >= Settlement_Flat_Time then
        Sell ("CL_Settlement") next bar at Market;

    if Manual_Kill_Switch then
        Sell ("CL_Kill") next bar at Market;

end;

{ ==========================================
  7. State Reset (flat)
  ========================================== }

if MarketPosition = 0 then begin
    v_SL_Locked     = false;
    v_Frozen_SL     = 0;
    v_Frozen_Target = 0;
    v_SL_Pct_Floor  = 0;
    v_BE_Armed      = false;
    v_BE_IsFloor    = false;
end;
