{================================================================================
 Script Name : _Backtest_Adaptive_Farmer_v14_PureLong
 MC Load Name: STRATEGY_WILLY_LONG_C_V183_RESEARCH
               *** RESEARCH BUILD. DO NOT save over the live signal
                   name STRATEGY_WILLY_LONG_C. ***
 Description : Matrix Range Capture (Full-Range Consolidation Long)
 Version     : v18.3 (2026-09-29 RESEARCH build = v18.2 + Loser_Flat switch, OFF by
               default so the default trades exactly like v18.2)
 RESEARCH (Willy 2026-09-29 15:56): "before 05:00 flatten only the losing
   positions, keep the winning ones" - to cut the day-open gap losses.
   Loser_Flat_On = true:
   - check bars: the 15M bars that CLOSE at Loser_Flat_Time .. 04:45
     (default 04:30 and 04:45). A market order from the 04:45 bar fills at
     04:45, still inside the night session; an order from the 05:00 bar
     would fill at the 08:45 open, i.e. inside the gap, so 05:00 is never used.
     Loser_Flat_Time must be a bar close time between 0400 and 0445.
   - losing = Close < EntryPrice on the check bar (price below the fill).
   - exit: Sell ("CL_NightLoss") next bar at Market.
   - no new entry orders on the check bars either: a position filled after
     the last check could not be flattened before 05:00 (05:00 itself is
     blocked by the opening filter while Open_Block_End > 0; default 945).
   - positions at or above the fill price are untouched.
 Symbol      : TXF1 (Taiwan Stock Index Futures Front Month)
 Platform    : MultiCharts 9.0 PowerLanguage x64
 Timeframe   : Data1 = 15M / Data2 = 60M / Data3 = Daily   (Data4 weekly NOT needed)

 WHAT v18 IS (Willy 2026-09-28: 10/1 live version):
   1. stop  : distance = previous day's range % x Stop_Day_Pct %, at least
              Stop_Min_Pts points (follows the market's own noise level)
   2. target: entry + (box top - entry) x Target_Room_Pct %
   3. night : no entries in the 09:00-13:45 day session (Night_Only)

 WHAT WAS REMOVED FROM v18.0 (all were OFF or unreachable in v18):
   - Box_New_On and its 5 inputs (new box detection, off)
   - Qual_New_On, Risk_Pct and the 5 RR_* inputs (weekly RR gate, off) -> Data4 gone
   - Qual_Mode 2/3/4 and their inputs (v18 uses mode 1 = ATR multiple only)
   - Stop_New_On switch and the old ATR/percent stop + swing target
     (SL_Pct, ATR_Stop_Mult, Swing_Lookback): v18 always uses the new stop
   - BE layer (BE_Trigger_Pts = 0 = off) and R1 loss rules (Rule_On = false)
   - Min_Box_ATR: declared in v18.0 but never used by any code line
   - SL_Pct in v18.0 was declared but UNUSED on the v18 path (it only fed the
     old stop). v18.1 re-added SL_Pct as a REAL cap on the v18 stop (default 0 =
     off in v18.1); v18.2 sets the default to 0.7 (house Rule #12 / V15 cap)
   Order names are unchanged (CL_Entry, CL_TP, CL_SL, CL_BreakExit,
   CL_Holiday, CL_Settlement, CL_RegistryEnd, CL_Kill, Stop Loss);
   v18.3 adds CL_NightLoss (research switch only).

 WHY THE v18.2 DEFAULTS (MC optimisation 2026-09-29, 336 runs, SL_Pct 0.7,
   Stop_Day_Pct 20-35 x Target_Room_Pct 75-95):
   - Stop_Day_Pct 30: the value that appears most often among the top runs
     (by net/drawdown and by drawdown). 27 and below jump to a much larger
     drawdown; 30-35 is flat. 28 sat next to that cliff.
   - Target_Room_Pct 90: 88-93 is the best zone at every stop value; 90 is
     the round number inside it (93 is the single best, 94 drops again).
   - SL_Pct 0.7: A-test 2026-09-29, the only cap that beat no-cap under the
     rule locked 2026-09-28 22:25 (0.55 fails: net -24%).
 ACCEPTANCE (must pass before it goes live):
   MC, same chart, all defaults (report L3_182): G2 22/22 against this file;
   that report is the deploy baseline for the 10/1 live chart check.
================================================================================}

inputs:
    { --- 60M box detection --- }
    Lookback_Bars(16),
    Range_Shrink_Rate(0.1),
    MA_Len(12),

    { --- box quality: width >= Qual_ATR_Mult x ATR(15M) --- }
    Qual_ATR_Mult(8.5),
    ATR_Length(9),

    { --- entry --- }
    Entry_Zone_Pct(0.50),       { support zone = bottom 50% of the box }
    Min_RR(1.0),                { box must be at least Min_RR stops wide. 0 = off }
    Open_Block_End(945),        { block entries filling before this MC time. 0 = off }
    Night_Only(true),           { v18: no entries in the 09:00-13:45 day session }

    { --- stop / target (v18) --- }
    Stop_Day_Pct(30),           { stop distance = previous day's range % x N % }
    Stop_Min_Pts(60),           { stop floor in points }
    Target_Room_Pct(90),        { target = entry + (box top - entry) x N % }
    Freeze_SL_On(true),         { stop / target fixed on the first bar in position }
    SL_Pct(0.7),                { percentage CAP on the stop distance, % of price.
                                  0 = off = v18.1 behaviour. v18 itself has NO cap: 34 of its 207
                                  stop exits (MC 2019-2026) were wider than 0.55%. Caps the engine
                                  stop and the exit stop only; entry gates are unchanged. }

    { --- daily filter (Data3) --- }
    Daily_MA_Fast(20),
    Daily_MA_Slow(60),

    { --- safety --- }
    Holiday_Flat_Time(415),
    Registry_Valid_Until(1270101),
    Manual_Kill_Switch(false),
    Settlement_Flat_Time(1230),

    { --- v18.3 research: before 05:00 flatten losing longs --- }
    Loser_Flat_On(false),       { false = trades exactly like v18.2 }
    Loser_Flat_Time(430),       { first check bar close time (HHMM, 0400-0445, on a bar close) }

    { --- logging only (no effect on trades) --- }
    Box_Log_On(true),
    Qual_Log_On(false);

variables:
    v_Ref_High(0), v_Ref_Low(0), v_Curr_Range(0), v_Ref_Range(0),
    v_is_in_consolidation(false), v_Box_Top(0), v_Box_Btm(0),
    v_Box_Range(0), v_Box_Qualified(false), v_Support_Zone(0),
    v_Qual_Need(0), v_Qual_Flag(0), v_Prev_BoxTop(0),
    v_Stop_Px(0), v_Stop_Dist(0), v_Plan_RR(0), v_Entry_Px(0), v_Target_Px(0),
    v_PrevDayRngPct(0), v_Day_Block(false), v_Stop_Floor(0),
    v_60M_MA(0), v_Trend_Dir(0),
    v_Daily_MA_Fast(0), v_Daily_MA_Slow(0), v_Daily_Filter(false),
    v_Current_ATR(0), v_SL_Distance(0), v_Opening_Block(false), v_RR_Qualified(true),
    v_Holiday_Block(false), v_Registry_Expired(false), Registry_Warn_ID(-1), hidx(0),
    v_Settlement_Day(false),
    v_Loser_Window(false),
    v_SL_Locked(false), v_Frozen_SL(0), v_Frozen_Target(0), v_Work_SL(0), v_Work_Target(0);

arrays:
    Holiday_Tail[80](0);

{ ==========================================
  0. Holiday Tail Registry (TAIFEX-verified, shared with L1/L2)
  ========================================== }

if CurrentBar = 1 then begin
    Holiday_Tail[1]  = 1190913;  Holiday_Tail[2]  = 1191010;
    Holiday_Tail[3]  = 1200101;
    { 2020 } Holiday_Tail[4]  = 1200121;  Holiday_Tail[5]  = 1200228;
    Holiday_Tail[6]  = 1200402;  Holiday_Tail[7]  = 1200501;
    Holiday_Tail[8]  = 1200625;  Holiday_Tail[9]  = 1201001;
    Holiday_Tail[10] = 1201009;  Holiday_Tail[11] = 1210101;
    { 2021 } Holiday_Tail[12] = 1210206;  Holiday_Tail[13] = 1210227;
    Holiday_Tail[14] = 1210402;  Holiday_Tail[15] = 1210612;
    Holiday_Tail[16] = 1210918;  Holiday_Tail[17] = 1211009;
    Holiday_Tail[18] = 1211231;
    { 2022 } Holiday_Tail[19] = 1220127;  Holiday_Tail[20] = 1220226;
    Holiday_Tail[21] = 1220402;  Holiday_Tail[22] = 1220430;
    Holiday_Tail[23] = 1220603;  Holiday_Tail[24] = 1220909;
    Holiday_Tail[25] = 1221008;  Holiday_Tail[26] = 1221231;
    { 2023 } Holiday_Tail[27] = 1230118;  Holiday_Tail[28] = 1230225;
    Holiday_Tail[29] = 1230401;  Holiday_Tail[30] = 1230429;
    Holiday_Tail[31] = 1230622;  Holiday_Tail[32] = 1230929;
    Holiday_Tail[33] = 1231007;  Holiday_Tail[34] = 1231230;
    { 2024 } Holiday_Tail[35] = 1240206;  Holiday_Tail[36] = 1240228;
    Holiday_Tail[37] = 1240404;  Holiday_Tail[38] = 1240501;
    Holiday_Tail[39] = 1240608;  Holiday_Tail[40] = 1240917;
    Holiday_Tail[41] = 1241010;  Holiday_Tail[42] = 1250101;
    { 2025 } Holiday_Tail[43] = 1250123;  Holiday_Tail[44] = 1250228;
    Holiday_Tail[45] = 1250403;  Holiday_Tail[46] = 1250501;
    Holiday_Tail[47] = 1250530;  Holiday_Tail[48] = 1250927;
    Holiday_Tail[49] = 1251004;  Holiday_Tail[50] = 1251010;
    Holiday_Tail[51] = 1251024;  Holiday_Tail[52] = 1251225;
    Holiday_Tail[53] = 1260101;
    { 2026 (verified: TAIFEX official 115-yr calendar) }
    Holiday_Tail[54] = 1260212;  Holiday_Tail[55] = 1260227;
    Holiday_Tail[56] = 1260403;  Holiday_Tail[57] = 1260501;
    Holiday_Tail[58] = 1260619;  Holiday_Tail[59] = 1260925;
    Holiday_Tail[60] = 1261009;  Holiday_Tail[61] = 1261024;
    Holiday_Tail[62] = 1261225;  Holiday_Tail[63] = 1270101;
end;

v_Holiday_Block = false;

if Time <= 500 then begin
    for hidx = 1 to 80 begin
        if Date = Holiday_Tail[hidx] then
            v_Holiday_Block = true;
    end;
end;

v_Registry_Expired = false;

if Date > Registry_Valid_Until then begin
    v_Registry_Expired = true;
    v_Holiday_Block    = true;
end;

v_Settlement_Day = (DayOfWeek(Date) = 3) and
                   (DayOfMonth(Date) >= 15) and
                   (DayOfMonth(Date) <= 21);

if LastBarOnChart and
   DateToJulian(Date) >= DateToJulian(Registry_Valid_Until) - 30 then begin
    if Registry_Warn_ID < 0 then begin
        Registry_Warn_ID = Text_New(Date, Time, High + 400,
            "HOLIDAY REGISTRY EXPIRES " +
            NumToStr(Registry_Valid_Until, 0) +
            " - REBUILD FROM TAIFEX CALENDAR");
        Text_SetColor(Registry_Warn_ID, Red);
        Text_SetSize(Registry_Warn_ID, 14);
        Text_SetAttribute(Registry_Warn_ID, 1, true);
    end;
end;

{ ==========================================
  1. Commander Logic (Data2 - 60M Box Detection)
  ========================================== }

v_Ref_High   = Highest(High, Lookback_Bars)[1] of Data2;
v_Ref_Low    = Lowest(Low,   Lookback_Bars)[1] of Data2;
v_Curr_Range = (High of Data2) - (Low of Data2);
v_Ref_Range  = v_Ref_High - v_Ref_Low;

v_60M_MA = Average(Close, MA_Len) of Data2;

if Close of Data2 > v_60M_MA then
    v_Trend_Dir = 1
else
    v_Trend_Dir = -1;

if (High of Data2 <= v_Ref_High) and (Low of Data2 >= v_Ref_Low) then begin
    if v_Ref_Range > 0 and (v_Curr_Range / v_Ref_Range <= Range_Shrink_Rate) then begin
        v_is_in_consolidation = true;
        v_Box_Top = v_Ref_High;
        v_Box_Btm = v_Ref_Low;
    end;
end;

if v_is_in_consolidation then begin
    if (Close of Data2 > v_Box_Top) or (Close of Data2 < v_Box_Btm) then
        v_is_in_consolidation = false;
end;

{ ==========================================
  2. Box Qualification (15M ATR multiple)
  ========================================== }

v_Current_ATR = AvgTrueRange(ATR_Length);

{ previous CLOSED daily range as a percentage of its close ([1] = no lookahead) }
v_PrevDayRngPct = 0;
if (Close of Data3)[1] > 0 then
    v_PrevDayRngPct = ((High of Data3)[1] - (Low of Data3)[1]) / (Close of Data3)[1] * 100;

{ day-session block. MC bar Time is the bar CLOSE time: day session = 0900..1345 }
v_Day_Block = false;
if Night_Only then begin
    if Time >= 900 and Time <= 1345 then v_Day_Block = true;
end;

v_Box_Range     = 0;
v_Box_Qualified = false;
v_Support_Zone  = 0;

if v_is_in_consolidation and v_Box_Top > v_Box_Btm then begin
    v_Box_Range = v_Box_Top - v_Box_Btm;

    v_Qual_Need = Qual_ATR_Mult * v_Current_ATR;
    if v_Current_ATR > 0 and v_Box_Range >= v_Qual_Need then v_Box_Qualified = true;

    { diagnostic: one line per new box, qualified or not }
    v_Qual_Flag = 0;
    if v_Box_Qualified then v_Qual_Flag = 1;
    if Qual_Log_On and v_Box_Top <> v_Prev_BoxTop then begin
        Print( "L3_QUAL,", Date:7:0, ",", Time:4:0, ",",
               v_Box_Btm:6:0, ",", v_Box_Top:6:0, ",", v_Box_Range:6:0, ",",
               v_Current_ATR:6:1, ",", v_Qual_Need:6:0, ",", v_Qual_Flag:1:0 );
        v_Prev_BoxTop = v_Box_Top;
    end;

    v_Support_Zone = v_Box_Btm + v_Box_Range * Entry_Zone_Pct;
end;

{ v18.3: last-check window before the 05:00 close (bar CLOSE times) }
v_Loser_Window = Loser_Flat_On and Time >= Loser_Flat_Time and Time < 500;

{ ==========================================
  3. Data3 Filter Logic (Daily)
  ========================================== }

v_Daily_MA_Fast = Average(Close, Daily_MA_Fast) of Data3;
v_Daily_MA_Slow = Average(Close, Daily_MA_Slow) of Data3;

if (Close of Data3 > v_Daily_MA_Fast) or
   (Close of Data3 > v_Daily_MA_Slow) then
    v_Daily_Filter = true
else
    v_Daily_Filter = false;

{ ==========================================
  4. Execution Block (requires active box)
  Entry is gated by v_Box_Qualified; exit only needs an active box.
  ========================================== }

if v_is_in_consolidation and v_Box_Top > v_Box_Btm then begin

    { P3b Immediate Stop Guard (Rule #12): engine stop, per contract }
    SetStopContract;
    if v_Box_Qualified and MarketPosition <= 0 then begin
        v_SL_Distance = Close * v_PrevDayRngPct * Stop_Day_Pct / 10000;
        if v_SL_Distance < Stop_Min_Pts then v_SL_Distance = Stop_Min_Pts;
        if SL_Pct > 0 then
            v_SL_Distance = MinList(v_SL_Distance, Close * SL_Pct / 100);
        SetStopLoss(v_SL_Distance * BigPointValue);
    end;

    { opening volatility filter }
    v_Opening_Block = false;
    if Open_Block_End > 0 then begin
        if Time = 500 then v_Opening_Block = true;
        if Time >= 900 and Time < Open_Block_End then v_Opening_Block = true;
    end;

    { planned stop / target at the box bottom, and the Min_RR gate }
    v_Entry_Px  = v_Box_Btm;
    v_Stop_Px   = 0;
    v_Stop_Dist = 0;
    v_Target_Px = 0;
    v_Plan_RR   = 0;
    v_RR_Qualified = true;
    if v_Box_Btm > 0 then begin
        v_Stop_Floor = v_Box_Btm * v_PrevDayRngPct * Stop_Day_Pct / 10000;
        if v_Stop_Floor < Stop_Min_Pts then v_Stop_Floor = Stop_Min_Pts;
        v_Stop_Dist = v_Stop_Floor;
        v_Stop_Px   = v_Box_Btm - v_Stop_Dist;
        v_Target_Px = v_Box_Btm + (v_Box_Top - v_Box_Btm) * Target_Room_Pct / 100;
        if v_Stop_Dist > 0 then
            v_Plan_RR = (v_Target_Px - v_Box_Btm) / v_Stop_Dist;
    end;
    if v_Stop_Dist <= 0 or v_Target_Px <= v_Box_Btm or v_Target_Px > v_Box_Top then
        v_RR_Qualified = false;
    if Min_RR > 0 and v_Stop_Dist > 0 and v_Box_Range < Min_RR * v_Stop_Dist then
        v_RR_Qualified = false;

    { entry: buy stop at the box bottom }
    if v_Box_Qualified and MarketPosition = 0 then begin
        if (v_Trend_Dir = 1) and
           (v_Daily_Filter = true) and
           (v_Holiday_Block = false) and
           (v_Settlement_Day = false) and
           (v_Opening_Block = false) and
           (v_Day_Block = false) and
           (v_Loser_Window = false) and
           (v_RR_Qualified = true) then begin
            if (Close < v_Support_Zone) and (Close > v_Stop_Px) then begin
                if Box_Log_On and v_Entry_Px > 0 and v_Box_Btm > 0 then
                    Print( "L3_BOX,", Date:7:0, ",", Time:4:0, ",",
                           v_Box_Top:6:0, ",", v_Box_Btm:6:0, ",",
                           v_Box_Range:6:0, ",",
                           (v_Box_Range / v_Box_Btm * 100):5:2, ",",
                           v_Entry_Px:6:0, ",", v_Stop_Px:6:0, ",",
                           v_Stop_Dist:6:0, ",",
                           (v_Stop_Dist / v_Entry_Px * 100):5:2, ",",
                           v_Plan_RR:5:2, ",", v_Target_Px:6:0 );
                Buy ("CL_Entry") next bar at v_Entry_Px Stop;
            end;
        end;
    end;

    { exit: stop and target measured from the actual fill }
    if MarketPosition = 1 then begin
        if Freeze_SL_On = true then begin
            if v_SL_Locked = false then begin
                v_Stop_Floor = EntryPrice * v_PrevDayRngPct * Stop_Day_Pct / 10000;
                if v_Stop_Floor < Stop_Min_Pts then v_Stop_Floor = Stop_Min_Pts;
                if SL_Pct > 0 then
                    v_Stop_Floor = MinList(v_Stop_Floor, EntryPrice * SL_Pct / 100);
                v_Frozen_SL = EntryPrice - v_Stop_Floor;
                v_Frozen_Target = EntryPrice + (v_Box_Top - EntryPrice) * Target_Room_Pct / 100;
                if v_Frozen_Target <= EntryPrice then v_Frozen_Target = v_Box_Top;
                v_SL_Locked = true;
            end;
            v_Work_SL     = v_Frozen_SL;
            v_Work_Target = v_Frozen_Target;
        end else begin
            v_Stop_Floor = EntryPrice * v_PrevDayRngPct * Stop_Day_Pct / 10000;
            if v_Stop_Floor < Stop_Min_Pts then v_Stop_Floor = Stop_Min_Pts;
            if SL_Pct > 0 then
                v_Stop_Floor = MinList(v_Stop_Floor, EntryPrice * SL_Pct / 100);
            v_Work_SL = EntryPrice - v_Stop_Floor;
            v_Work_Target = EntryPrice + (v_Box_Top - EntryPrice) * Target_Room_Pct / 100;
            if v_Work_Target <= EntryPrice then v_Work_Target = v_Box_Top;
        end;

        Sell ("CL_TP") next bar at v_Work_Target Limit;
        Sell ("CL_SL") next bar at v_Work_SL Stop;
    end;

end else begin
    { ==========================================
      5. True Box Break Exit (consolidation ended)
      ========================================== }
    if MarketPosition = 1 then
        Sell ("CL_BreakExit") next bar at Market;
end;

{ ==========================================
  6. Safety Exits (Priority 0, always active)
  ========================================== }

if MarketPosition = 1 then begin

    if v_Registry_Expired then
        Sell ("CL_RegistryEnd") next bar at Market
    else if v_Holiday_Block and Time >= Holiday_Flat_Time then
        Sell ("CL_Holiday") next bar at Market
    else if v_Settlement_Day and Time >= Settlement_Flat_Time then
        Sell ("CL_Settlement") next bar at Market;

    if Manual_Kill_Switch then
        Sell ("CL_Kill") next bar at Market;

    { v18.3: before the 05:00 close, flatten only a losing position }
    if v_Loser_Window and Close < EntryPrice then
        Sell ("CL_NightLoss") next bar at Market;

end;

{ ==========================================
  7. State Reset (flat)
  ========================================== }

if MarketPosition = 0 then begin
    v_SL_Locked     = false;
    v_Frozen_SL     = 0;
    v_Frozen_Target = 0;
end;
