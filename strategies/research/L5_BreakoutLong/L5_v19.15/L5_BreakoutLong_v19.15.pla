    { [SEC-3] Risk Management }
    ATR_Length(35),
    ATR_Stop_Mult(4.5),
    FrontRun_Ticks(5),
    Time_Stop_Bars(31),
    SL_Pct(0),                     { v19.15: 0 = no pct cap (was 1.0). 2026-09-30 MC: caps 0.5-1.5 worse }

    { [SEC-4] Scale-Out Settings }
    ScaleOut_Percent(0.4),

    { [SEC-5] God Mode: Relative MFE Engine }
    Trail_Start_Mult(2.5),
    MFE_ATR_Tier_1(3.0),
    MFE_ATR_Tier_2(6.0),
    MFE_ATR_Tier_3(10.0),

    { [SEC-6] Data3 (Weekly) Filter Settings }
    Weekly_MA_Fast(20),
    Weekly_MA_Slow(60),

    { [SEC-7] v19.7 Frozen Initial SL }
    Freeze_SL_On(true),            { PRODUCTION: lock ATR at entry; false = v19.6 dynamic }

    { [SEC-8] v19.7 Holiday Flat Rule v3 (Iron Rule 2026-06-13) }
    Holiday_Flat_Time(415),        { 15M grid: 04:15 trigger, retries 04:30/04:45 }
    Registry_Valid_Until(1270101), { verified holiday-registry horizon; bump each Q4 }
    Manual_Kill_Switch(false),

    { [SEC-8b] Monthly Settlement Flat (2026-06-17 added) }
    Settlement_Flat_Time(1230),    { 12:30 trigger before 13:30 settlement (3rd Wed) }

    { [SEC-9] v19.8 Pre-Trail StopProfit (L1 SP philosophy, A/B engine).
              2026-06-13: variants B-F (Retain 50 etc.) failed; SP off
              in v19.9. 2026-09-30: ON again in v19.13 (100 pts, Retain
              90) on top of C1-1 70, decided by Willy. See
              strategies/research/L5_BreakoutLong/L5_v19.11/RESULTS_20260930.md }
    SP_Trigger_Pts(100),           { v19.13: 100 pts ON (v19.9 had 0 = off).
                                     2026-06-13 tests with Retain 50 failed
                                     (cut mega-winners); 2026-09-30 tests with
                                     Retain 90 on C1-1 70 adopted by Willy. }
    SP_Retain_Pct(90),             { v19.13: 90 = give back up to 90% of peak }

    { [SEC-10] v19.11 research switches (ALL OFF = v19.9) }
    Stop_Day_On(false),            { A: stop from previous-day range }
    Stop_Day_Pct(30),              { A: stop = prevDayRange% x N% of EntryPrice }
    Stop_Min_Pts(60),              { A: stop floor in points }
    Night_Only(false),             { B: no entry signals 09:00-13:45 }
    TP_Mode(1),                    { C1: 0 = v19.9, 1 = room pct, 2 = day range pct; v19.13 = 1 }
    TP_Room_Pct(70),               { C1 mode 1; v19.13 = 70 }
    TP_Day_Pct(40),                { C1 mode 2 }
    Time_To_Trail_On(false),       { C2: time stop in profit -> BE + trail }

    { [SEC-11] v19.14 reward/risk gate }
    RR_Mode(1);                    { v19.15 = 1. 0 = v19.13 (half box / ATR buffer);
                                     1 = half box / actual stop (incl. A);
                                     2 = half box / previous-day range;
                                     3 = half box / previous-week range }

