__pycache__/
*.pyc
.env
*.tmp
.DS_Store
scripts/_temp_*.pkl

# Raw TAIFEX quote CSVs backing data/taifex_market_closures.json.
# ~5 MB of exchange data, re-fetchable at any time via
# scripts/fetch_taifex_quotes.py -- the derived JSON is what belongs in git.
data/_taifex_cache/

# derived cache from s16s_bars.py -- rebuildable, not source
scripts/research/s16s_5min.csv

scripts/research/s16s_5min.csv

# Iron rule 3 backups (~/.claude/CLAUDE.md): copy before modifying any
# spec / policy / strategy file. These are local safety copies -- git
# history already holds the real record, so tracking them is redundant
# and they otherwise bury `git status` under 40+ lines of noise.
# Added 2026-08-26 after the count reached 44.
*.bak_*
*.bak2_*

# MC12 匯出的原始資料。107 MB，可隨時重新匯出，不進 git
data/mc_export/

# 聚合快取。可由原始資料重建
*.pkl

# 對帳報告與實戰紀錄（含帳務資訊）
data/parity_reports/
data/live_records/

# 券商設定與憑證。任何情況都不得進 git
config/broker_*.yaml
config/*_credentials.*
.env.broker
*.pfx
*.p12

# 命名重構時隔離的舊檔，確認無用後手動刪除
_quarantine/

# 回測產出物，可由 tools\report.py 重建
reports/
